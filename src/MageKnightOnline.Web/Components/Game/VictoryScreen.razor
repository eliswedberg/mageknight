@using MageKnightOnline.Core.GameState

<div class="victory-overlay">
    <div class="victory-modal">
        <div class="victory-header">
            <h1>@GetVictoryTitle()</h1>
            <p class="victory-reason">@Victory.EndReason</p>
        </div>

        <div class="winners-section">
            @if (Victory.WinnerUserIds.Count == 1)
            {
                var winner = Victory.FinalScores.FirstOrDefault(s => s.UserId == Victory.WinnerUserIds[0]);
                <div class="winner-card">
                    <div class="trophy">🏆</div>
                    <h2>@winner?.HeroName</h2>
                    <div class="winner-score">@winner?.TotalScore points</div>
                </div>
            }
            else if (Victory.WinnerUserIds.Count > 1)
            {
                <div class="tie-message">It's a tie!</div>
                <div class="winners-row">
                    @foreach (var winnerId in Victory.WinnerUserIds)
                    {
                        var winner = Victory.FinalScores.FirstOrDefault(s => s.UserId == winnerId);
                        <div class="winner-card small">
                            <div class="trophy">🏆</div>
                            <h3>@winner?.HeroName</h3>
                            <div class="winner-score">@winner?.TotalScore pts</div>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="scoreboard">
            <h3>Final Standings</h3>
            <table class="scores-table">
                <thead>
                    <tr>
                        <th>Rank</th>
                        <th>Hero</th>
                        <th>Fame</th>
                        <th>Rep</th>
                        <th>Cities</th>
                        <th>Sites</th>
                        <th>Items</th>
                        <th>Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var score in Victory.FinalScores)
                    {
                        var isWinner = Victory.WinnerUserIds.Contains(score.UserId);
                        var isCurrentUser = score.UserId == CurrentUserId;
                        <tr class="@(isWinner ? "winner-row" : "") @(isCurrentUser ? "current-user-row" : "")">
                            <td class="rank">
                                @if (score.Rank == 1)
                                {
                                    <span>🥇</span>
                                }
                                else if (score.Rank == 2)
                                {
                                    <span>🥈</span>
                                }
                                else if (score.Rank == 3)
                                {
                                    <span>🥉</span>
                                }
                                else
                                {
                                    <span>@score.Rank</span>
                                }
                            </td>
                            <td class="hero-name">@score.HeroName</td>
                            <td>@score.Fame</td>
                            <td class="@(score.ReputationBonus >= 0 ? "positive" : "negative")">
                                @(score.ReputationBonus >= 0 ? "+" : "")@score.ReputationBonus
                            </td>
                            <td>@score.CitiesConquered</td>
                            <td>@score.AdventureSitesConquered</td>
                            <td>@(score.ArtifactsCount + score.SpellsCount + score.AdvancedActionsCount)</td>
                            <td class="total-score">@score.TotalScore</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="score-breakdown">
            <h4>Scoring Guide</h4>
            <ul>
                <li><strong>Fame:</strong> 1 point per fame</li>
                <li><strong>Reputation:</strong> Bonus/penalty based on standing</li>
                <li><strong>Cities:</strong> 10 points each</li>
                <li><strong>Adventure Sites:</strong> 2 points each</li>
                <li><strong>Artifacts:</strong> 2 points each</li>
                <li><strong>Spells & Actions:</strong> 1 point each</li>
            </ul>
        </div>

        <div class="victory-actions">
            <button class="btn btn-primary" @onclick="OnReturnToLobby">
                🏠 Return to Lobby
            </button>
            @if (CanPlayAgain)
            {
                <button class="btn btn-secondary" @onclick="OnPlayAgain">
                    🔄 Play Again
                </button>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public VictoryState Victory { get; set; } = new();
    [Parameter] public Guid CurrentUserId { get; set; }
    [Parameter] public bool CanPlayAgain { get; set; } = false;
    [Parameter] public EventCallback OnReturnToLobby { get; set; }
    [Parameter] public EventCallback OnPlayAgain { get; set; }

    private string GetVictoryTitle()
    {
        return Victory.VictoryType switch
        {
            VictoryType.CityConquest => "🏰 Cities Conquered!",
            VictoryType.ScenarioGoal => "🎯 Objective Complete!",
            VictoryType.Cooperative => "🤝 Victory Together!",
            VictoryType.TimeOut => "⏰ Time's Up!",
            VictoryType.Defeat => "💀 Defeat",
            _ => "🎮 Game Over"
        };
    }
}

<style>
    .victory-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.85);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 10000;
        animation: fadeIn 0.5s ease-out;
    }

    @@keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    .victory-modal {
        background: linear-gradient(145deg, #1a1a2e 0%, #16213e 100%);
        border: 2px solid #d4a853;
        border-radius: 16px;
        padding: 2rem;
        max-width: 800px;
        width: 90%;
        max-height: 90vh;
        overflow-y: auto;
        animation: slideUp 0.5s ease-out;
    }

    @@keyframes slideUp {
        from { transform: translateY(50px); opacity: 0; }
        to { transform: translateY(0); opacity: 1; }
    }

    .victory-header {
        text-align: center;
        margin-bottom: 2rem;
    }

    .victory-header h1 {
        font-family: 'Cinzel', serif;
        font-size: 2.5rem;
        color: #d4a853;
        margin: 0;
        text-shadow: 0 2px 10px rgba(212, 168, 83, 0.3);
    }

    .victory-reason {
        color: #a0a0a0;
        font-size: 1.1rem;
        margin-top: 0.5rem;
    }

    .winners-section {
        text-align: center;
        margin-bottom: 2rem;
    }

    .winner-card {
        display: inline-block;
        background: linear-gradient(135deg, rgba(212, 168, 83, 0.2) 0%, rgba(184, 146, 46, 0.1) 100%);
        border: 2px solid #d4a853;
        border-radius: 12px;
        padding: 1.5rem 3rem;
        animation: pulse 2s infinite;
    }

    .winner-card.small {
        padding: 1rem 1.5rem;
        margin: 0 0.5rem;
    }

    @@keyframes pulse {
        0%, 100% { box-shadow: 0 0 20px rgba(212, 168, 83, 0.3); }
        50% { box-shadow: 0 0 40px rgba(212, 168, 83, 0.5); }
    }

    .trophy {
        font-size: 3rem;
        margin-bottom: 0.5rem;
    }

    .winner-card.small .trophy {
        font-size: 2rem;
    }

    .winner-card h2, .winner-card h3 {
        font-family: 'Cinzel', serif;
        color: #fff;
        margin: 0.5rem 0;
    }

    .winner-score {
        color: #d4a853;
        font-size: 1.2rem;
        font-weight: 600;
    }

    .tie-message {
        font-size: 1.5rem;
        color: #d4a853;
        margin-bottom: 1rem;
    }

    .winners-row {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .scoreboard {
        margin-bottom: 1.5rem;
    }

    .scoreboard h3 {
        color: #d4a853;
        font-family: 'Cinzel', serif;
        margin-bottom: 1rem;
    }

    .scores-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.9rem;
    }

    .scores-table th {
        background: rgba(212, 168, 83, 0.2);
        color: #d4a853;
        padding: 0.75rem 0.5rem;
        text-align: center;
        border-bottom: 2px solid #d4a853;
    }

    .scores-table td {
        padding: 0.75rem 0.5rem;
        text-align: center;
        color: #e0e0e0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .scores-table .rank {
        font-size: 1.2rem;
    }

    .scores-table .hero-name {
        text-align: left;
        font-weight: 600;
    }

    .scores-table .total-score {
        font-weight: 700;
        color: #d4a853;
        font-size: 1.1rem;
    }

    .scores-table .positive {
        color: #4ade80;
    }

    .scores-table .negative {
        color: #f87171;
    }

    .scores-table .winner-row {
        background: rgba(212, 168, 83, 0.1);
    }

    .scores-table .current-user-row {
        background: rgba(74, 222, 128, 0.1);
    }

    .score-breakdown {
        background: rgba(0, 0, 0, 0.3);
        border-radius: 8px;
        padding: 1rem;
        margin-bottom: 1.5rem;
    }

    .score-breakdown h4 {
        color: #a0a0a0;
        margin: 0 0 0.5rem 0;
        font-size: 0.9rem;
    }

    .score-breakdown ul {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1.5rem;
        font-size: 0.85rem;
        color: #808080;
    }

    .score-breakdown li strong {
        color: #a0a0a0;
    }

    .victory-actions {
        display: flex;
        justify-content: center;
        gap: 1rem;
        margin-top: 1.5rem;
    }

    .btn {
        padding: 0.75rem 2rem;
        border-radius: 8px;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        border: none;
    }

    .btn-primary {
        background: linear-gradient(135deg, #d4a853 0%, #b8922e 100%);
        color: #1a1a1a;
    }

    .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 15px rgba(212, 168, 83, 0.4);
    }

    .btn-secondary {
        background: transparent;
        border: 2px solid #d4a853;
        color: #d4a853;
    }

    .btn-secondary:hover {
        background: rgba(212, 168, 83, 0.1);
        transform: translateY(-2px);
    }
</style>
