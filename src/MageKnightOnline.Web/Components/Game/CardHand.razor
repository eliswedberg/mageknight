@namespace MageKnightOnline.Web.Components.Game
@inject IJSRuntime JSRuntime

@* Fullscreen Card Modal *@
@if (_fullscreenCardIndex.HasValue && _fullscreenCardIndex.Value < Cards.Count && !_showSidewaysChoice)
{
    var card = Cards[_fullscreenCardIndex.Value];
    var canPlayThisCardPowered = CanPlayPoweredForCard?.Invoke(card) ?? CanPlayPowered;
    
    <div class="card-modal-overlay" @onclick="CloseFullscreenCard">
        <div class="card-modal" @onclick:stopPropagation="true">
            <button class="modal-close-btn" @onclick="CloseFullscreenCard">✕</button>
            
            <div class="modal-card-display @GetCardTypeClass(card)">
                @if (!string.IsNullOrEmpty(card.ImageUrl))
                {
                    <img src="@card.ImageUrl" alt="@card.Name" class="modal-card-image" />
                }
                else
                {
                    <div class="modal-card-placeholder">
                        <div class="modal-card-name">@card.Name</div>
                        <div class="modal-card-type-badge">@card.Type</div>
                    </div>
                }
            </div>
            
            <div class="modal-card-info">
                <h2 class="modal-card-title">@card.Name</h2>
                <span class="modal-card-type @GetCardTypeClass(card)">@card.Type</span>
                
                <div class="modal-effects">
                    <div class="modal-effect basic">
                        <span class="modal-effect-label">📜 Basic Effect</span>
                        <span class="modal-effect-text">@card.BasicEffect</span>
                    </div>
                    
                    @if (!string.IsNullOrEmpty(card.PoweredEffect))
                    {
                        <div class="modal-effect powered">
                            <span class="modal-effect-label">⚡ Powered Effect @(!string.IsNullOrEmpty(card.PoweredManaColor) ? $"({card.PoweredManaColor})" : "")</span>
                            <span class="modal-effect-text">@card.PoweredEffect</span>
                        </div>
                    }
                    
                    @if (!string.IsNullOrEmpty(card.Note))
                    {
                        <div class="modal-note">
                            <span class="modal-note-icon">💡</span>
                            <span>@card.Note</span>
                        </div>
                    }
                </div>
                
                <div class="modal-actions">
                    <button class="modal-btn modal-btn-play" 
                            @onclick="() => PlayCardFromModal(_fullscreenCardIndex.Value)"
                            disabled="@(!card.CanPlay)">
                        ▶ Play Basic
                    </button>
                    
                    @if (!string.IsNullOrEmpty(card.PoweredEffect) || !string.IsNullOrEmpty(card.PoweredManaColor))
                    {
                        var manaReq = !string.IsNullOrEmpty(card.PoweredManaColor) ? card.PoweredManaColor : "any";
                        <button class="modal-btn modal-btn-powered @(canPlayThisCardPowered ? "" : "disabled")"
                                @onclick="() => PlayCardPoweredFromModal(_fullscreenCardIndex.Value)"
                                disabled="@(!canPlayThisCardPowered)"
                                title="@(canPlayThisCardPowered ? $"Play powered effect" : $"Requires {manaReq} mana - take a mana die first")">
                            ⚡ Play Powered
                        </button>
                    }
                    
                    <button class="modal-btn modal-btn-sideways"
                            @onclick="() => ShowSidewaysChoice(_fullscreenCardIndex.Value)"
                            disabled="@(!card.CanPlay)"
                            title="Use sideways for +1 of your choice">
                        ↔ Use as +1...
                    </button>
                    
                    <button class="modal-btn modal-btn-cancel" @onclick="CloseFullscreenCard">
                        Cancel
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* Sideways Bonus Type Selection Modal *@
@if (_showSidewaysChoice && _sidewaysCardIndex.HasValue && _sidewaysCardIndex.Value < Cards.Count)
{
    var card = Cards[_sidewaysCardIndex.Value];
    
    <div class="card-modal-overlay" @onclick="CloseSidewaysChoice">
        <div class="sideways-choice-modal" @onclick:stopPropagation="true">
            <button class="modal-close-btn" @onclick="CloseSidewaysChoice">✕</button>
            
            <h2 class="sideways-title">Choose +1 Bonus Type</h2>
            <p class="sideways-subtitle">Using <strong>@card.Name</strong> sideways</p>
            
            <div class="sideways-options">
                <button class="sideways-option move" @onclick="SelectMoveBonus">
                    <span class="sideways-icon">🏃</span>
                    <span class="sideways-label">+1 Move</span>
                </button>
                
                <button class="sideways-option attack" @onclick="SelectAttackBonus">
                    <span class="sideways-icon">⚔️</span>
                    <span class="sideways-label">+1 Attack</span>
                </button>
                
                <button class="sideways-option block" @onclick="SelectBlockBonus">
                    <span class="sideways-icon">🛡️</span>
                    <span class="sideways-label">+1 Block</span>
                </button>
                
                <button class="sideways-option influence" @onclick="SelectInfluenceBonus">
                    <span class="sideways-icon">💬</span>
                    <span class="sideways-label">+1 Influence</span>
                </button>
                
                <button class="sideways-option heal" @onclick="SelectHealBonus">
                    <span class="sideways-icon">💚</span>
                    <span class="sideways-label">+1 Heal</span>
                </button>
            </div>
            
            <button class="modal-btn modal-btn-cancel" @onclick="CloseSidewaysChoice">
                Cancel
            </button>
        </div>
    </div>
}

<div class="card-hand @(IsExpanded ? "expanded" : "")">
    <div class="hand-header" @onclick="ToggleExpand">
        <h4>Your Hand (@Cards.Count cards)</h4>
        <span class="expand-icon">@(IsExpanded ? "▼" : "▲")</span>
    </div>
    
    <div class="hand-cards">
        @foreach (var (card, index) in Cards.Select((c, i) => (c, i)))
        {
            var isSelected = SelectedCardIndex == index;
            var offset = CalculateCardOffset(index, Cards.Count);
            var isDragging = _draggedCardIndex == index;
            
            <div class="hand-card @(isSelected ? "selected" : "") @(card.CanPlay ? "" : "disabled") @GetCardTypeClass(card) @(isDragging ? "dragging" : "")"
                 style="--card-index: @index; --card-offset: @offset; z-index: @(isSelected ? 100 : (isDragging ? 150 : index));"
                 draggable="@(card.CanPlay.ToString().ToLower())"
                 @ondragstart="() => OnDragStart(index, card)"
                 @ondragend="OnDragEnd"
                 @onclick="() => OnCardClick(index)"
                 @onclick:stopPropagation="true">
                
                <!-- Tooltip -->
                <div class="card-tooltip">
                    <div class="tooltip-header">
                        <span class="tooltip-name">@card.Name</span>
                        <span class="tooltip-type @GetCardTypeClass(card)">@card.Type</span>
                    </div>
                    <div class="tooltip-body">
                        <div class="tooltip-effect">
                            <span class="effect-icon">📜</span>
                            <span>Basic: @card.BasicEffect</span>
                        </div>
                        @if (!string.IsNullOrEmpty(card.PoweredEffect))
                        {
                            <div class="tooltip-effect powered">
                                <span class="effect-icon">⚡</span>
                                <span>Powered (@card.PoweredManaColor): @card.PoweredEffect</span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(card.Note))
                        {
                            <div class="tooltip-note">
                                <span class="note-icon">💡</span>
                                <span>@card.Note</span>
                            </div>
                        }
                    </div>
                </div>
                
                @if (!string.IsNullOrEmpty(card.ImageUrl))
                {
                    <img src="@card.ImageUrl" alt="@card.Name" class="card-image" />
                }
                else
                {
                    <div class="card-placeholder">
                        <div class="card-name">@card.Name</div>
                        <div class="card-type">@card.Type</div>
                        <div class="card-value">@card.BasicEffect</div>
                    </div>
                }

                @if (isSelected)
                {
                    <div class="card-actions">
                        <button class="btn btn-sm btn-primary" @onclick="() => PlayCard(index)" @onclick:stopPropagation="true"
                                disabled="@(!card.CanPlay)">
                            Play
                        </button>
                        @if (!string.IsNullOrEmpty(card.PoweredEffect) || !string.IsNullOrEmpty(card.PoweredManaColor))
                        {
                            var canPlayThisCardPowered = CanPlayPoweredForCard?.Invoke(card) ?? CanPlayPowered;
                            var manaRequirement = !string.IsNullOrEmpty(card.PoweredManaColor) ? card.PoweredManaColor : "mana";
                            <button class="btn btn-sm btn-powered @(canPlayThisCardPowered ? "" : "disabled")" 
                                    @onclick="() => PlayCardPowered(index)" @onclick:stopPropagation="true"
                                    disabled="@(!canPlayThisCardPowered)"
                                    title="@(canPlayThisCardPowered ? $"Play powered effect (requires {manaRequirement} mana)" : $"Requires {manaRequirement} mana from Source - take a mana die first")">
                                ⚡ Powered
                            </button>
                        }
                        <button class="btn btn-sm btn-secondary" @onclick="() => UseAsSidewaysCard(index)" @onclick:stopPropagation="true"
                                title="Use sideways for +1 @card.Type">
                            +1
                        </button>
                    </div>
                }
            </div>
        }
    </div>

    @if (SelectedCardIndex.HasValue && SelectedCardIndex.Value < Cards.Count)
    {
        var selectedCard = Cards[SelectedCardIndex.Value];
        <div class="card-details">
            <h5>@selectedCard.Name</h5>
            <div class="card-effects">
                <div class="effect-section">
                    <span class="effect-label">Basic:</span>
                    <span class="effect-value">@selectedCard.BasicEffect</span>
                </div>
                @if (!string.IsNullOrEmpty(selectedCard.PoweredEffect))
                {
                    <div class="effect-section powered">
                        <span class="effect-label">Powered (@selectedCard.PoweredManaColor):</span>
                        <span class="effect-value">@selectedCard.PoweredEffect</span>
                    </div>
                }
            </div>
        </div>
    }
</div>

<style>
    .card-hand {
        background: linear-gradient(180deg, var(--color-bg-card) 0%, rgba(26, 26, 36, 0.95) 100%);
        border: 1px solid var(--color-border);
        border-top: 2px solid var(--color-gold);
        border-radius: var(--radius-lg);
        padding: var(--spacing-sm);
        transition: all 0.3s ease;
        position: relative;
    }

    .card-hand::before {
        content: '';
        position: absolute;
        top: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 60px;
        height: 3px;
        background: var(--color-gold);
        border-radius: 0 0 3px 3px;
    }

    .card-hand.expanded {
        padding-bottom: var(--spacing-lg);
    }

    .hand-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        cursor: pointer;
        margin-bottom: var(--spacing-sm);
        padding: var(--spacing-xs) 0;
    }

    .hand-header h4 {
        margin: 0;
        font-size: 0.9rem;
        display: flex;
        align-items: center;
        gap: var(--spacing-sm);
    }

    .hand-header h4::before {
        content: '🃏';
    }

    .expand-icon {
        color: var(--color-gold);
        font-size: 0.8rem;
        transition: transform 0.3s ease;
    }

    .card-hand.expanded .expand-icon {
        transform: rotate(180deg);
    }

    .hand-cards {
        display: flex;
        justify-content: center;
        position: relative;
        height: 140px;
        perspective: 1000px;
        padding: 10px 0 40px 0;
        overflow: visible;
        min-height: 180px;
    }

    .card-hand.expanded .hand-cards {
        height: 180px;
        min-height: 240px;
    }

    .hand-card {
        position: absolute;
        width: 80px;
        height: 112px;
        background: var(--color-bg-dark);
        border: 2px solid var(--color-border);
        border-radius: var(--radius-md);
        cursor: pointer;
        transition: all 0.2s ease;
        transform-origin: bottom center;
        transform: translateX(calc(var(--card-offset) * 1px)) rotate(calc((var(--card-index) - 2) * 2deg));
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
    }

    .card-hand.expanded .hand-card {
        width: 100px;
        height: 140px;
    }

    .hand-card:hover {
        transform: translateX(calc(var(--card-offset) * 1px)) translateY(-30px) rotate(0deg) scale(1.15);
        z-index: 50 !important;
        border-color: var(--color-gold);
    }

    .hand-card.selected {
        transform: translateX(calc(var(--card-offset) * 1px)) translateY(-40px) rotate(0deg) scale(1.15);
        border-color: var(--color-gold);
        box-shadow: var(--shadow-glow);
    }

    .hand-card.disabled {
        opacity: 0.5;
    }

    .hand-card.dragging {
        opacity: 0.7;
        transform: scale(1.05) rotate(5deg) !important;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
        cursor: grabbing;
    }

    .hand-card[draggable="true"] {
        cursor: grab;
    }

    .hand-card[draggable="true"]:active {
        cursor: grabbing;
    }

    .card-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: calc(var(--radius-md) - 2px);
    }

    .card-placeholder {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: var(--spacing-sm);
        text-align: center;
    }

    .card-name {
        font-family: 'Cinzel', serif;
        font-size: 0.7rem;
        color: var(--color-gold);
        margin-bottom: var(--spacing-xs);
    }

    .card-type {
        font-size: 0.6rem;
        color: var(--color-text-muted);
    }

    .card-actions {
        position: absolute;
        bottom: -45px;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        gap: var(--spacing-xs);
        white-space: nowrap;
    }

    .card-details {
        margin-top: var(--spacing-lg);
        padding-top: var(--spacing-md);
        border-top: 1px solid var(--color-border);
    }

    .card-details h5 {
        margin: 0 0 var(--spacing-sm) 0;
        color: var(--color-gold);
    }

    .card-effects {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-xs);
    }

    .effect-section {
        display: flex;
        gap: var(--spacing-sm);
        font-size: 0.85rem;
    }

    .effect-label {
        color: var(--color-text-muted);
        min-width: 80px;
    }

    .effect-value {
        color: var(--color-text-primary);
    }

    .effect-section.powered .effect-label {
        color: var(--color-gold);
    }

    .btn-powered {
        background: linear-gradient(135deg, #f59e0b, #d97706);
        border-color: #f59e0b;
        color: white;
    }

    .btn-powered:hover:not(:disabled) {
        background: linear-gradient(135deg, #d97706, #b45309);
        border-color: #d97706;
    }

    .btn-powered.disabled,
    .btn-powered:disabled {
        opacity: 0.6;
        cursor: not-allowed;
        background: linear-gradient(135deg, #6b7280, #4b5563);
        border-color: #6b7280;
    }

    .btn-powered.disabled:hover,
    .btn-powered:disabled:hover {
        background: linear-gradient(135deg, #6b7280, #4b5563);
        border-color: #6b7280;
    }

    /* Card Type Classes */
    .hand-card.move {
        border-color: #22c55e;
    }

    .hand-card.attack {
        border-color: #ef4444;
    }

    .hand-card.block {
        border-color: #3b82f6;
    }

    .hand-card.influence {
        border-color: #a855f7;
    }

    .hand-card.heal {
        border-color: #f472b6;
    }

    .hand-card.wound {
        border-color: #6b7280;
        background: #2a1a1a;
    }

    /* Tooltip Styles */
    .card-tooltip {
        position: absolute;
        bottom: calc(100% + 15px);
        left: 50%;
        transform: translateX(-50%);
        width: 280px;
        max-width: 90vw; /* Don't exceed viewport */
        background: linear-gradient(135deg, #1e1e2e 0%, #2a2a3a 100%);
        border: 2px solid var(--color-gold);
        border-radius: 8px;
        padding: 12px;
        opacity: 0;
        visibility: hidden;
        transition: all 0.2s ease;
        z-index: 10000; /* Always above map and other UI */
        pointer-events: none;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
        white-space: normal;
        word-wrap: break-word;
    }

    /* Tooltip always shows above card (since cards are at bottom) */
    .hand-card:hover .card-tooltip {
        opacity: 1;
        visibility: visible;
    }

    .hand-card.selected .card-tooltip {
        opacity: 0;
        visibility: hidden;
    }

    .tooltip-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 10px;
        padding-bottom: 8px;
        border-bottom: 1px solid rgba(212, 168, 83, 0.3);
    }

    .tooltip-name {
        font-family: 'Cinzel', serif;
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--color-gold);
    }

    .tooltip-type {
        font-size: 0.7rem;
        padding: 2px 8px;
        border-radius: 4px;
        text-transform: uppercase;
        font-weight: 600;
    }

    .tooltip-type.move {
        background: rgba(34, 197, 94, 0.2);
        color: #22c55e;
    }

    .tooltip-type.attack {
        background: rgba(239, 68, 68, 0.2);
        color: #ef4444;
    }

    .tooltip-type.block {
        background: rgba(59, 130, 246, 0.2);
        color: #3b82f6;
    }

    .tooltip-type.influence {
        background: rgba(168, 85, 247, 0.2);
        color: #a855f7;
    }

    .tooltip-type.heal {
        background: rgba(244, 114, 182, 0.2);
        color: #f472b6;
    }

    .tooltip-body {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .tooltip-effect {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        font-size: 0.8rem;
        color: #b0b0b0;
    }

    .tooltip-effect.powered {
        color: #f59e0b;
    }

    .effect-icon {
        flex-shrink: 0;
    }

    .tooltip-note {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        font-size: 0.75rem;
        color: #888;
        font-style: italic;
        margin-top: 4px;
        padding-top: 8px;
        border-top: 1px dashed rgba(255, 255, 255, 0.1);
    }

    .note-icon {
        flex-shrink: 0;
    }

    .card-value {
        font-size: 0.55rem;
        color: var(--color-text-muted);
        margin-top: var(--spacing-xs);
    }

    /* Fullscreen Card Modal */
    .card-modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.85);
        backdrop-filter: blur(8px);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 10000;
        animation: modalFadeIn 0.2s ease-out;
    }

    @@keyframes modalFadeIn {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }

    .card-modal {
        display: flex;
        gap: 2rem;
        padding: 2rem;
        background: linear-gradient(145deg, #1a1a2e 0%, #16213e 50%, #1a1a2e 100%);
        border: 2px solid var(--color-gold);
        border-radius: 16px;
        box-shadow: 0 0 60px rgba(212, 168, 83, 0.3), 0 20px 60px rgba(0, 0, 0, 0.6);
        max-width: 90vw;
        max-height: 90vh;
        position: relative;
        animation: modalSlideIn 0.25s ease-out;
    }

    @@keyframes modalSlideIn {
        from {
            transform: scale(0.9) translateY(20px);
            opacity: 0;
        }
        to {
            transform: scale(1) translateY(0);
            opacity: 1;
        }
    }

    .modal-close-btn {
        position: absolute;
        top: 12px;
        right: 12px;
        width: 36px;
        height: 36px;
        border: none;
        background: rgba(255, 255, 255, 0.1);
        color: #fff;
        font-size: 1.2rem;
        border-radius: 50%;
        cursor: pointer;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .modal-close-btn:hover {
        background: rgba(239, 68, 68, 0.8);
        transform: scale(1.1);
    }

    .modal-card-display {
        width: 280px;
        height: 400px;
        border-radius: 12px;
        overflow: hidden;
        border: 3px solid var(--color-border);
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4);
        flex-shrink: 0;
    }

    .modal-card-display.move { border-color: #22c55e; }
    .modal-card-display.attack { border-color: #ef4444; }
    .modal-card-display.block { border-color: #3b82f6; }
    .modal-card-display.influence { border-color: #a855f7; }
    .modal-card-display.heal { border-color: #f472b6; }
    .modal-card-display.wound { border-color: #6b7280; }

    .modal-card-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .modal-card-placeholder {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        background: linear-gradient(180deg, #2a2a4a 0%, #1a1a2e 100%);
        padding: 1.5rem;
    }

    .modal-card-name {
        font-family: 'Cinzel', serif;
        font-size: 1.5rem;
        color: var(--color-gold);
        text-align: center;
        margin-bottom: 1rem;
    }

    .modal-card-type-badge {
        font-size: 0.9rem;
        padding: 0.5rem 1rem;
        border-radius: 20px;
        background: rgba(255, 255, 255, 0.1);
        color: var(--color-text-muted);
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .modal-card-info {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        min-width: 320px;
        max-width: 400px;
    }

    .modal-card-title {
        font-family: 'Cinzel', serif;
        font-size: 1.8rem;
        color: var(--color-gold);
        margin: 0;
        text-shadow: 0 2px 10px rgba(212, 168, 83, 0.3);
    }

    .modal-card-type {
        display: inline-block;
        font-size: 0.85rem;
        padding: 0.4rem 1rem;
        border-radius: 20px;
        text-transform: uppercase;
        font-weight: 600;
        letter-spacing: 1px;
        width: fit-content;
    }

    .modal-card-type.move { background: rgba(34, 197, 94, 0.2); color: #22c55e; }
    .modal-card-type.attack { background: rgba(239, 68, 68, 0.2); color: #ef4444; }
    .modal-card-type.block { background: rgba(59, 130, 246, 0.2); color: #3b82f6; }
    .modal-card-type.influence { background: rgba(168, 85, 247, 0.2); color: #a855f7; }
    .modal-card-type.heal { background: rgba(244, 114, 182, 0.2); color: #f472b6; }
    .modal-card-type.wound { background: rgba(107, 114, 128, 0.2); color: #6b7280; }

    .modal-effects {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        padding: 1rem;
        background: rgba(0, 0, 0, 0.3);
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

