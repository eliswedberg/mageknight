@code {
    [Parameter] public List<CardData> Cards { get; set; } = new();
    [Parameter] public int? SelectedCardIndex { get; set; }
    [Parameter] public bool CanPlayPowered { get; set; } = false;
    [Parameter] public Func<CardData, bool>? CanPlayPoweredForCard { get; set; }
    [Parameter] public EventCallback<int> OnCardSelected { get; set; }
    [Parameter] public EventCallback<int> OnCardPlayed { get; set; }
    [Parameter] public EventCallback<int> OnCardPlayedPowered { get; set; }
    [Parameter] public EventCallback<(int Index, string BonusType)> OnCardUsedSideways { get; set; }
    [Parameter] public EventCallback<CardDragData> OnCardDragStarted { get; set; }
    [Parameter] public EventCallback OnCardDragEnded { get; set; }

    private bool IsExpanded { get; set; } = true;
    private int? _draggedCardIndex = null;
    private int? _fullscreenCardIndex = null;
    private bool _showSidewaysChoice = false;
    private int? _sidewaysCardIndex = null;

    private void ToggleExpand()
    {
        IsExpanded = !IsExpanded;
    }

    private int CalculateCardOffset(int index, int total)
    {
        if (total <= 1) return 0;
        // Increase spread for more cards to prevent overlap
        var maxSpread = Math.Min(total * 60, 500); // Wider spread for more cards
        var step = maxSpread / Math.Max(total - 1, 1);
        return (int)(index * step - maxSpread / 2);
    }

    private async Task OnCardClick(int index)
    {
        // Open fullscreen modal instead of just selecting
        _fullscreenCardIndex = index;
        
        if (OnCardSelected.HasDelegate)
        {
            await OnCardSelected.InvokeAsync(index);
        }
    }

    private void CloseFullscreenCard()
    {
        _fullscreenCardIndex = null;
    }

    private async Task PlayCardFromModal(int index)
    {
        CloseFullscreenCard();
        if (OnCardPlayed.HasDelegate)
        {
            await OnCardPlayed.InvokeAsync(index);
        }
    }

    private async Task PlayCardPoweredFromModal(int index)
    {
        CloseFullscreenCard();
        if (OnCardPlayedPowered.HasDelegate)
        {
            await OnCardPlayedPowered.InvokeAsync(index);
        }
    }

    private void ShowSidewaysChoice(int index)
    {
        _sidewaysCardIndex = index;
        _showSidewaysChoice = true;
        _fullscreenCardIndex = null;
    }

    private void CloseSidewaysChoice()
    {
        _showSidewaysChoice = false;
        _sidewaysCardIndex = null;
    }

    private async Task SelectSidewaysBonus(string bonusType)
    {
        if (_sidewaysCardIndex.HasValue && OnCardUsedSideways.HasDelegate)
        {
            await OnCardUsedSideways.InvokeAsync((_sidewaysCardIndex.Value, bonusType));
        }
        CloseSidewaysChoice();
    }

    private Task SelectMoveBonus() => SelectSidewaysBonus("move");
    private Task SelectAttackBonus() => SelectSidewaysBonus("attack");
    private Task SelectBlockBonus() => SelectSidewaysBonus("block");
    private Task SelectInfluenceBonus() => SelectSidewaysBonus("influence");
    private Task SelectHealBonus() => SelectSidewaysBonus("heal");

    private async Task PlayCard(int index)
    {
        if (OnCardPlayed.HasDelegate)
        {
            await OnCardPlayed.InvokeAsync(index);
        }
    }

    private async Task PlayCardPowered(int index)
    {
        if (OnCardPlayedPowered.HasDelegate)
        {
            await OnCardPlayedPowered.InvokeAsync(index);
        }
    }

    private void UseAsSidewaysCard(int index)
    {
        // Show the sideways choice modal instead of directly using
        ShowSidewaysChoice(index);
    }

    private async Task OnDragStart(int index, CardData card)
    {
        _draggedCardIndex = index;
        if (OnCardDragStarted.HasDelegate)
        {
            await OnCardDragStarted.InvokeAsync(new CardDragData
            {
                CardIndex = index,
                CardId = card.Id,
                CardName = card.Name,
                CardType = card.Type
            });
        }
    }

    private async Task OnDragEnd()
    {
        _draggedCardIndex = null;
        if (OnCardDragEnded.HasDelegate)
        {
            await OnCardDragEnded.InvokeAsync();
        }
    }

    /// <summary>
    /// Gets the currently dragged card index, if any.
    /// </summary>
    public int? GetDraggedCardIndex() => _draggedCardIndex;
}

@code {
    public class CardData
    {
        public string Id { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string Type { get; set; } = string.Empty;
        public string? ImageUrl { get; set; }
        public string BasicEffect { get; set; } = string.Empty;
        public string? PoweredEffect { get; set; }
        public string? PoweredManaColor { get; set; }
        public string? Note { get; set; }
        public bool CanPlay { get; set; } = true;
    }

    public class CardDragData
    {
        public int CardIndex { get; set; }
        public string CardId { get; set; } = string.Empty;
        public string CardName { get; set; } = string.Empty;
        public string CardType { get; set; } = string.Empty;
    }
    
    private string GetCardTypeClass(CardData card)
    {
        return card.Type?.ToLower() switch
        {
            "move" => "move",
            "attack" => "attack",
            "block" => "block",
            "influence" => "influence",
            "heal" => "heal",
            "wound" => "wound",
            _ => ""
        };
    }
