    private async Task UpdateValidMoves()
    {
        if (!IsMyTurn || _myPlayerState == null || _myPlayerState.MovementRemaining <= 0)
        {
            _highlightedHexes = null;
            StateHasChanged();
            return;
        }

        var validMoves = await GameService.GetValidMovesAsync(GameId, AuthService.CurrentUser!.Id);
        _highlightedHexes = validMoves
            .Select(m => _hexes.FirstOrDefault(h => h.Q == m.Q && h.R == m.R))
            .Where(h => h != null)
            .Cast<HexGrid.HexData>()
            .ToList();
        StateHasChanged();
    }

