    private bool IsAtSite
    {
        get
        {
            if (_myPlayerState == null) return false;
            var hexKey = $"{_myPlayerState.Position.Q},{_myPlayerState.Position.R}";
            return _gameState.Map.HexData.TryGetValue(hexKey, out var hexState) && 
                   !string.IsNullOrEmpty(hexState.SiteType) &&
                   hexState.SiteType != "Portal";
        }
    }

    private bool HasEnemiesAtCurrentPosition
    {
        get
        {
            if (_myPlayerState == null) return false;
            var hexKey = $"{_myPlayerState.Position.Q},{_myPlayerState.Position.R}";
            return _gameState.Map.HexData.TryGetValue(hexKey, out var hexState) && 
                   hexState.Enemies.Any();
        }
    }

    private string GetCurrentSiteIcon()
    {
        if (_myPlayerState == null) return "🏠";
        var hexKey = $"{_myPlayerState.Position.Q},{_myPlayerState.Position.R}";
        if (!_gameState.Map.HexData.TryGetValue(hexKey, out var hexState) || string.IsNullOrEmpty(hexState.SiteType))
            return "🏠";

        return hexState.SiteType switch
        {
            "Village" => "🏘️",
            "Monastery" => "⛪",
            "MageTower" or "Mage_Tower" => "🗼",
            "Keep" => "🏰",
            "MagicalGlade" or "Magical_Glade" => "🌳",
            "AncientRuins" or "Ancient_Ruins" => "🏚️",
            "Dungeon" => "🕳️",
            "Tomb" => "⚰️",
            "MonsterDen" or "Monster_Den" => "🐺",
            "SpawningGrounds" or "Spawning_Grounds" => "👹",
            "Draconum" => "🐉",
            "City" => "🏙️",
            _ when hexState.SiteType.Contains("Mine") => "⛏️",
            _ => "🏠"
        };
    }

    protected override async Task OnInitializedAsync()
    {
        // Load all definitions
        _heroes = (await DefinitionService.GetHeroesAsync()).ToList();
        var basicActions = await DefinitionService.GetBasicActionsAsync();
        var advancedActions = await DefinitionService.GetAdvancedActionsAsync();
        _cardDefinitions = basicActions.Concat(advancedActions).ToList();
        _unitDefinitions = (await DefinitionService.GetUnitsAsync()).ToList();
        _spellDefinitions = (await DefinitionService.GetSpellsAsync()).ToList();
        _advancedActionDefinitions = advancedActions.ToList();
        
        // Load tile definitions
        var mapTiles = await DefinitionService.GetMapTilesAsync();
        _tileDefinitions = mapTiles.ToDictionary(t => t.Id);

        // Setup SignalR connection
        await SetupSignalR();

        await LoadGame();
    }

    private async Task SetupSignalR()
    {
        _hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/gamehub"))
            .WithAutomaticReconnect()
            .Build();

        // Handle game state changes from other players
        _hubConnection.On<string>("GameStateChanged", async (actionDescription) =>
        {
            await InvokeAsync(async () =>
            {
                await LoadGame();
                StateHasChanged();
            });
        });

        // Handle player joined
        _hubConnection.On<string, string>("PlayerJoined", (username, connectionId) =>
        {
            InvokeAsync(() =>
            {
                if (!_connectedPlayers.Contains(username))
                    _connectedPlayers.Add(username);
                StateHasChanged();
            });
        });

        // Handle player left
        _hubConnection.On<string, string>("PlayerLeft", (username, connectionId) =>
        {
            InvokeAsync(() =>
            {
                _connectedPlayers.Remove(username);
                StateHasChanged();
            });
        });

        // Handle player disconnected
        _hubConnection.On<string>("PlayerDisconnected", (username) =>
        {
            InvokeAsync(() =>
            {
                _connectedPlayers.Remove(username);
                StateHasChanged();
            });
        });

        // Handle turn started
        _hubConnection.On<string>("TurnStarted", (playerName) =>
        {
            InvokeAsync(() =>
            {
                // Could show a notification
                StateHasChanged();
            });
        });

        // Handle chat messages
        _hubConnection.On<string, string, DateTime>("ReceiveMessage", (username, message, timestamp) =>
        {
            InvokeAsync(() =>
            {
                _chatMessages.Add(new ChatMessage(username, message, timestamp));
                // Keep only last 100 messages
                if (_chatMessages.Count > 100)
                    _chatMessages.RemoveAt(0);
                StateHasChanged();
            });
        });

        // Handle game ended
        _hubConnection.On<string>("GameEnded", async (reason) =>
        {
            await InvokeAsync(async () =>
            {
                await LoadGame();
                StateHasChanged();
            });
        });

        // Handle action performed by other player
        _hubConnection.On<string, string, string>("ActionPerformed", (username, actionType, description) =>
        {
            InvokeAsync(async () =>
            {
                // Reload game state to see the action
                await LoadGame();
                StateHasChanged();
            });
        });

        try
        {
            await _hubConnection.StartAsync();
            
            // Join the game room
            if (AuthService.CurrentUser != null)
            {
                await _hubConnection.SendAsync("JoinGame", GameId.ToString(), AuthService.CurrentUser.Username);
                
                // Get list of connected players
                _connectedPlayers = await _hubConnection.InvokeAsync<List<string>>("GetConnectedPlayers", GameId.ToString());
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"SignalR connection error: {ex.Message}");
        }
    }

    private async Task NotifyGameStateChanged(string actionDescription)
    {
        if (_hubConnection?.State == HubConnectionState.Connected)
        {
            await _hubConnection.SendAsync("NotifyGameStateChanged", GameId.ToString(), actionDescription);
        }
    }

