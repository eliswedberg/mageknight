            // This is a valid move - execute it
            var result = await GameService.MovePlayerAsync(GameId, AuthService.CurrentUser!.Id, hex.Q, hex.R);
            if (result.Success)
            {
                await LoadGame(); // Reload game state
                await UpdateValidMoves(); // Update highlighted hexes
            }
        }
        else if (hex.IsRevealed)
        {
            // Clicked on a non-valid hex, just select it for info
            _selectedHex = hex;
        }
    }

