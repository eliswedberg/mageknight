    private async Task PlayCardPowered(int index)
    {
        if (_myPlayerState == null || index >= _myPlayerState.Hand.Count) return;
        
        var cardId = _myPlayerState.Hand[index];
        var card = _cardDefinitions.FirstOrDefault(c => c.Id == cardId);
        
        // Check if we have any mana available (TemporaryMana or ManaTokens)
        var hasTemporaryMana = _myPlayerState.TemporaryMana.HasValue;
        var tokens = _myPlayerState.ManaTokens;
        var hasManaToken = tokens.Red > 0 || tokens.Blue > 0 || tokens.Green > 0 || 
                          tokens.White > 0 || tokens.Black > 0 || tokens.Gold > 0;
        
        if (!hasTemporaryMana && !hasManaToken)
        {
            await JSRuntime.InvokeVoidAsync("alert", "No mana available! Take a mana die from Source, use a mana token, or play a card that gives mana first.");
            return;
        }

        // Server-side will handle the mana consumption automatically
        // It will use TemporaryMana first, then check ManaTokens
        
        var result = await GameService.PlayCardAsync(GameId, AuthService.CurrentUser!.Id, cardId, true, null);
        
        if (result.Success)
        {
            _selectedCardIndex = null;
            await LoadGame();
            await UpdateValidMoves();
            await UpdateValidTileMoves();
            await NotifyGameStateChanged("Played powered card");
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("alert", result.ErrorMessage ?? "Failed to play card");
        }
    }

