            Color = color switch
            {
                ManaColor.Red => ManaPool.ManaColor.Red,
                ManaColor.Blue => ManaPool.ManaColor.Blue,
                ManaColor.Green => ManaPool.ManaColor.Green,
                ManaColor.White => ManaPool.ManaColor.White,
                ManaColor.Black => ManaPool.ManaColor.Black,
                ManaColor.Gold => ManaPool.ManaColor.Gold,
                _ => ManaPool.ManaColor.Red
            }
        }).ToList();
    }

