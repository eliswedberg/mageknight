    private async Task OnTacticSelected(string tacticId)
    {
        var previousPhase = _gameState?.Phase;
        
        var result = await GameService.SelectTacticAsync(GameId, AuthService.CurrentUser!.Id, tacticId);
        if (result.Success)
        {
            await LoadGame();
            await NotifyGameStateChanged("Tactic selected");
            
            // If we just finished tactics selection, notify the first player that it's their turn
            if (previousPhase == GamePhase.TacticsSelection && _gameState?.Phase != GamePhase.TacticsSelection)
            {
                await NotifyNextPlayerTurn();
            }
        }
    }

    private async Task LoadGame()
    {
        _isLoading = true;
        _game = await GameService.GetGameAsync(GameId);
        
        if (_game != null)
        {
            _scenario = await DefinitionService.GetScenarioAsync(_game.ScenarioId);
            
            // Parse game state from JSON
            if (!string.IsNullOrEmpty(_game.GameState))
            {
                try
                {
                    // Use GameEngine to load state and ensure offers are filled
                    var engine = new MageKnightOnline.Core.GameEngine.GameEngine(DefinitionService);
                    engine.LoadState(_game.GameState);
                    
                    // Get state from engine (offers will be filled if they were empty)
                    _gameState = engine.State;
                }
                catch
                {
                    _gameState = new GameStateModel();
                }
            }

            // Get current user's player state
            _myPlayerState = _gameState.Players.FirstOrDefault(p => p.UserId == AuthService.CurrentUser?.Id);

            // Load tactics for tactics selection phase
            if (_gameState.Phase == GamePhase.TacticsSelection)
            {
                var allTactics = _gameState.IsDay 
                    ? await DefinitionService.GetDayTacticsAsync()
                    : await DefinitionService.GetNightTacticsAsync();
                _availableTactics = allTactics.ToList();
            }

            // Build hex grid from game state
            BuildHexGrid();
            
            // Build tile map from game state
            BuildTileMap();

            // Update valid moves if it's our turn
            if (_gameState.Phase == GamePhase.Movement)
            {
                await UpdateValidMoves();
                await UpdateValidTileMoves();
            }

            // Update undo availability
            await UpdateUndoAvailability();
        }
        
        _isLoading = false;
    }

    private void BuildHexGrid()
    {
        _hexes.Clear();

        // Build hex data from revealed hexes
        foreach (var hexKey in _gameState.Map.RevealedHexes)
        {
            var parts = hexKey.Split(',');
            if (parts.Length != 2) continue;

            var q = int.Parse(parts[0]);
            var r = int.Parse(parts[1]);

            var terrainType = GetTerrainForHex(q, r);
            var siteType = GetSiteForHex(q, r);
            var enemyCount = GetEnemyCountForHex(q, r);

            var hex = new HexGrid.HexData
            {
                Q = q,
                R = r,
                IsRevealed = true,
                TerrainType = terrainType,
                SiteType = siteType,
                EnemyCount = enemyCount
            };

            // Add player tokens
            foreach (var player in _gameState.Players)
            {
                if (player.Position.Q == q && player.Position.R == r)
                {
                    var hero = _heroes.FirstOrDefault(h => h.Id == player.HeroId);
                    hex.PlayerTokens.Add(new HexGrid.PlayerToken
                    {
                        UserId = player.UserId,
                        TokenImage = hero?.TokenImage ?? "",
                        HeroName = hero?.Name ?? "Unknown"
                    });
                }
            }

            _hexes.Add(hex);
        }

        // Add some unrevealed hexes around the edges
        AddUnrevealedNeighbors();
    }

    private int GetEnemyCountForHex(int q, int r)
    {
        var key = $"{q},{r}";
        if (_gameState.Map.HexData.TryGetValue(key, out var hexState))
        {
            return hexState.Enemies?.Count ?? 0;
        }
        return 0;
    }

    // TileMap building methods
    private void BuildTileMap()
    {
        _tiles.Clear();
        _tileHexes.Clear();

        // Build tiles from game state
        foreach (var tileState in _gameState.Map.Tiles)
        {
            // Get tile definition
            if (!_tileDefinitions.TryGetValue(tileState.TileId, out var tileDef))
            {
                // Try to find by partial match or keywords
                var tileIdLower = tileState.TileId.ToLowerInvariant();
                tileDef = _tileDefinitions.Values.FirstOrDefault(t => 
                    tileState.TileId.Contains(t.Id) || 
                    t.Id.Contains(tileState.TileId) ||
                    (tileIdLower.Contains("start") && t.IsStartingTile));
                
                // Final fallback: use starting tile for any unmatched tile at position 0,0
                if (tileDef == null && tileState.Position.Q == 0 && tileState.Position.R == 0)
                {
                    tileDef = _tileDefinitions.Values.FirstOrDefault(t => t.IsStartingTile);
                }
            }

            var tile = new TileMap.TileData
            {
                TileId = tileState.TileId,
                Q = tileState.Position.Q,
                R = tileState.Position.R,
                Rotation = tileState.Rotation,
                IsRevealed = tileState.IsRevealed,
                ImagePath = tileDef?.Image,
                BackImagePath = tileDef?.BackImage
            };
            _tiles.Add(tile);
        }

        // Build hex overlays from revealed hexes
        foreach (var hexKey in _gameState.Map.RevealedHexes)
        {
            var parts = hexKey.Split(',');
            if (parts.Length != 2) continue;

            var q = int.Parse(parts[0]);
            var r = int.Parse(parts[1]);

            var terrainType = GetTerrainForHex(q, r);
            var siteType = GetSiteForHex(q, r);
            var enemyCount = GetEnemyCountForHex(q, r);

            var hex = new TileMap.HexData
            {
                Q = q,
                R = r,
                IsRevealed = true,
                TerrainType = terrainType,
                SiteType = siteType,
                EnemyCount = enemyCount
            };

            // Add player tokens
            foreach (var player in _gameState.Players)
            {
                if (player.Position.Q == q && player.Position.R == r)
                {
                    var hero = _heroes.FirstOrDefault(h => h.Id == player.HeroId);
                    hex.PlayerTokens.Add(new TileMap.PlayerToken
                    {
                        UserId = player.UserId,
                        TokenImage = hero?.TokenImage ?? "",
                        HeroName = hero?.Name ?? "Unknown"
                    });
                }
            }

            _tileHexes.Add(hex);
        }

        // Add unrevealed hex placeholders around the edges
        AddUnrevealedTileHexes();
    }

    private void AddUnrevealedTileHexes()
    {
        var directions = new[] 
        {
            (1, 0), (1, -1), (0, -1), (-1, 0), (-1, 1), (0, 1)
        };

        var existingKeys = _tileHexes.Select(h => $"{h.Q},{h.R}").ToHashSet();
        var toAdd = new List<TileMap.HexData>();

        // Get player position for exploration check
        var playerQ = _myPlayerState?.Position.Q ?? 0;
        var playerR = _myPlayerState?.Position.R ?? 0;
        var canExplore = IsMyTurn && _myPlayerState != null && _myPlayerState.MovementRemaining >= 1;

        foreach (var hex in _tileHexes.Where(h => h.IsRevealed))
        {
            foreach (var (dq, dr) in directions)
            {
                var nq = hex.Q + dq;
                var nr = hex.R + dr;
                var key = $"{nq},{nr}";

                if (!existingKeys.Contains(key))
                {
                    // Check if this unrevealed hex is adjacent to the player's position
                    var isAdjacentToPlayer = directions.Any(d => 
                        playerQ + d.Item1 == nq && playerR + d.Item2 == nr);
                    
                    toAdd.Add(new TileMap.HexData
                    {
                        Q = nq,
                        R = nr,
                        IsRevealed = false,
                        IsExplorable = canExplore && isAdjacentToPlayer
                    });
                    existingKeys.Add(key);
                }
            }
        }

        _tileHexes.AddRange(toAdd);
    }

    private async Task UpdateValidTileMoves()
    {
        if (!IsMyTurn || _myPlayerState == null || _myPlayerState.MovementRemaining <= 0)
        {
            _highlightedTileHexes = null;
            StateHasChanged();
            return;
        }

        var validMoves = await GameService.GetValidMovesAsync(GameId, AuthService.CurrentUser!.Id);
        _highlightedTileHexes = validMoves
            .Select(m => _tileHexes.FirstOrDefault(h => h.Q == m.Q && h.R == m.R))
            .Where(h => h != null)
            .Cast<TileMap.HexData>()
            .ToList();
        StateHasChanged();
    }

    private async Task OnTileHexClicked(TileMap.HexData hex)
    {
        _selectedTileHex = hex;
        
        if (!IsMyTurn || _myPlayerState == null) return;

        // Check if this is a valid move destination
        if (_highlightedTileHexes?.Any(h => h.Q == hex.Q && h.R == hex.R) == true)
        {
            // This is a valid move - execute it
            var result = await GameService.MovePlayerAsync(GameId, AuthService.CurrentUser!.Id, hex.Q, hex.R);
            if (result.Success)
            {
                await LoadGame();
                
                // Update valid moves (this will clear highlights if no movement left)
                await UpdateValidTileMoves();
                
                // Check if we landed on a site - open interaction panel
                if (_myPlayerState != null)
                {
                    var hexKey = $"{_myPlayerState.Position.Q},{_myPlayerState.Position.R}";
                    if (_gameState.Map.HexData.TryGetValue(hexKey, out var hexState) && 
                        !string.IsNullOrEmpty(hexState.SiteType) &&
                        hexState.SiteType != "Portal" &&
                        !hexState.Enemies.Any())
                    {
                        await OpenSitePanel();
                    }
                }
                
                await NotifyGameStateChanged("Player moved");
            }
        }
        else if (!hex.IsRevealed && hex.IsExplorable)
        {
            // Clicked on an unexplored hex adjacent to player - explore!
            if (_myPlayerState.MovementRemaining >= 1)
            {
                var result = await GameService.ExploreTileAsync(GameId, AuthService.CurrentUser!.Id, hex.Q, hex.R);
                if (result.Success)
                {
                    await LoadGame();
                    await UpdateValidTileMoves();
                    await NotifyGameStateChanged("Explored new tile");
                }
            }
        }
        else if (hex.IsRevealed && hex.Q == _myPlayerState.Position.Q && hex.R == _myPlayerState.Position.R)
        {
            // Clicked on current position - check for site interactions
            var hexKey = $"{hex.Q},{hex.R}";
            if (_gameState.Map.HexData.TryGetValue(hexKey, out var hexState) && 
                !string.IsNullOrEmpty(hexState.SiteType) &&
                hexState.SiteType != "Portal")
            {
                await OpenSitePanel();
            }
        }
    }

