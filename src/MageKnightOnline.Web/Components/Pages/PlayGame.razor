@page "/play/{GameId:guid}"
@using MageKnightOnline.Web.Components.Game
@using MageKnightOnline.Core.GameState
@using MageKnightOnline.Core.GameEngine
@using MageKnightOnline.Core.Definitions
@using System.Text.Json
@using Microsoft.AspNetCore.SignalR.Client
@inject AuthStateService AuthService
@inject IGameService GameService
@inject IGameDefinitionService DefinitionService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<PageTitle>Playing - Mage Knight Online</PageTitle>

@if (!AuthService.IsAuthenticated)
{
    <div class="alert alert-warning">
        Please <a href="/login">login</a> to play.
    </div>
}
else if (_isLoading)
{
    <div class="text-center mt-lg">
        <div class="spinner"></div>
        <p class="text-muted mt-md">Loading game...</p>
    </div>
}
else if (_game == null)
{
    <div class="alert alert-error">
        Game not found. <a href="/">Return to lobby</a>
    </div>
}
else if (_game.Status != GameStatus.InProgress)
{
    <div class="alert alert-warning">
        This game is not currently in progress.
        <a href="/game/@GameId">Return to game lobby</a>
    </div>
}
else if (_gameState.Victory?.IsGameOver == true)
{
    <!-- Victory Screen -->
    <VictoryScreen Victory="_gameState.Victory"
                   CurrentUserId="@(AuthService.CurrentUser?.Id ?? Guid.Empty)"
                   CanPlayAgain="false"
                   OnReturnToLobby="ReturnToLobby" />
}
else if (_gameState.Phase == GamePhase.TacticsSelection)
{
    <!-- Tactics Selection Phase -->
    <TacticsSelection Round="@_gameState.Round"
                      IsDay="@_gameState.IsDay"
                      AvailableTactics="@_availableTactics"
                      TakenTacticIds="@GetTakenTacticIds()"
                      HasSelected="@HasSelectedTactic()"
                      OnTacticSelected="OnTacticSelected" />
}
else
{
    <div class="game-board-container">
        <div class="game-layout">
            <!-- Left sidebar - Game info box + Player info -->
            <aside class="player-sidebar">
                <div class="card game-info-box">
                    <h3 class="game-info-title">@_game.Name</h3>
                    <span class="game-info-scenario">@_scenario?.Name</span>
                    <div class="game-info-badges">
                        <span class="status-badge round">📅 @_gameState.Round/@(_scenario?.Rounds ?? 3)</span>
                        <span class="status-badge @(_gameState.IsDay ? "day" : "night")">
                            @(_gameState.IsDay ? "☀️ Day" : "🌙 Night")
                        </span>
                        <span class="connected-players" title="@string.Join(", ", _connectedPlayers)">
                            👥 @_connectedPlayers.Count
                        </span>
                    </div>
                    <div class="game-info-controls">
                        <button class="btn btn-secondary btn-sm" @onclick="ToggleChat">
                            💬 @(_chatMessages.Count > 0 ? $"({_chatMessages.Count})" : "")
                        </button>
                        <button class="btn btn-secondary btn-sm" @onclick="ToggleLog">
                            📜
                        </button>
                        @if (_game.CreatedByUserId == AuthService.CurrentUser?.Id)
                        {
                            <button class="btn btn-danger btn-sm" @onclick="EndGame" title="End this game">
                                🛑
                            </button>
                        }
                    </div>
                </div>
                <div class="card">
                    <h3>Players</h3>
                    @foreach (var (playerState, index) in _gameState.Players.Select((p, i) => (p, i)))
                    {
                        var hero = _heroes.FirstOrDefault(h => h.Id == playerState.HeroId);
                        var isCurrentTurn = _gameState.CurrentPlayerIndex == index;
                        var gamePlayer = _game.Players.FirstOrDefault(p => p.UserId == playerState.UserId);
                        <div class="player-card @(isCurrentTurn ? "active" : "")">
                            @if (hero != null)
                            {
                                <img src="@hero.TokenImage" alt="@hero.Name" class="player-token" />
                            }
                            <div class="player-details">
                                <strong>@(gamePlayer?.User.Username ?? "Unknown")</strong>
                                <span class="hero-name">@(hero?.Name ?? "Unknown")</span>
                                <div class="player-stats">
                                    <span title="Fame">⭐ @playerState.Fame</span>
                                    <span title="Level">📈 Lv.@playerState.Level</span>
                                    <span title="Reputation">🏛️ @playerState.Reputation</span>
                                </div>
                            </div>
                            @if (isCurrentTurn)
                            {
                                <span class="turn-indicator">▶</span>
                            }
                        </div>
                    }
                </div>

                <!-- Mana Pool -->
                <ManaPool Dice="@GetManaDice()"
                          Crystals="@GetPlayerCrystals()"
                          ManaTokens="@GetPlayerManaTokens()"
                          SelectedDieIndex="@GetSelectedManaDieIndex()"
                          CanUndo="@CanUndoMana"
                          OnDieSelected="SelectMana"
                          OnManaTokenSelected="SelectManaToken"
                          OnUndoClicked="UndoMana" />
                
                <!-- Current player pools -->
                @if (IsMyTurn && _myPlayerState != null)
                {
                    <div class="card pools-card">
                        <h3>Current Pools</h3>
                        @if (_myPlayerState.TemporaryMana.HasValue)
                        {
                            <div class="temporary-mana-indicator">
                                <span class="mana-badge @_myPlayerState.TemporaryMana.Value.ToString().ToLower()">
                                    ⚡ Temporary: @_myPlayerState.TemporaryMana.Value
                                </span>
                            </div>
                        }
                        <div class="pools-grid">
                            <div class="pool-item move">
                                <span class="pool-icon">🏃</span>
                                <span class="pool-value">@_myPlayerState.MovementRemaining</span>
                                <span class="pool-label">Move</span>
                            </div>
                            <div class="pool-item attack">
                                <span class="pool-icon">⚔️</span>
                                <span class="pool-value">@_myPlayerState.AttackPool</span>
                                <span class="pool-label">Attack</span>
                            </div>
                            <div class="pool-item block">
                                <span class="pool-icon">🛡️</span>
                                <span class="pool-value">@_myPlayerState.BlockPool</span>
                                <span class="pool-label">Block</span>
                            </div>
                            <div class="pool-item influence">
                                <span class="pool-icon">👑</span>
                                <span class="pool-value">@_myPlayerState.InfluencePool</span>
                                <span class="pool-label">Influence</span>
                            </div>
                            @if (_myPlayerState.RangedAttack > 0)
                            {
                                <div class="pool-item ranged">
                                    <span class="pool-icon">🏹</span>
                                    <span class="pool-value">@_myPlayerState.RangedAttack</span>
                                    <span class="pool-label">Ranged</span>
                                </div>
                            }
                            @if (_myPlayerState.SiegeAttack > 0)
                            {
                                <div class="pool-item siege">
                                    <span class="pool-icon">💣</span>
                                    <span class="pool-value">@_myPlayerState.SiegeAttack</span>
                                    <span class="pool-label">Siege</span>
                                </div>
                            }
                        </div>
                    </div>
                }
            </aside>

            <!-- Main game board area: map + hand below -->
            <main class="game-board">
                @if (_gameState.Combat != null)
                {
                    <!-- Combat overlay -->
                    <CombatPanel Combat="_gameState.Combat"
                                 RangedAttack="@(_myPlayerState?.RangedAttack ?? 0)"
                                 SiegeAttack="@(_myPlayerState?.SiegeAttack ?? 0)"
                                 AttackPool="@(_myPlayerState?.AttackPool ?? 0)"
                                 BlockPool="@(_myPlayerState?.BlockPool ?? 0)"
                                 Units="@GetUnitCombatOptions()"
                                 OnRangedAttack="HandleRangedAttack"
                                 OnBlock="HandleBlock"
                                 OnAttack="HandleAttack"
                                 OnAssignDamage="HandleAssignDamage"
                                 OnAssignDamageToUnit="HandleAssignDamageToUnit"
                                 OnUnitAbility="HandleUnitAbility"
                                 OnEndPhase="HandleEndCombatPhase"
                                 OnFlee="HandleFlee" />
                }
                else
                {
                    <div class="game-board-map-area">
                        <TileMap Width="900" 
                                 Height="500" 
                                 Scale="0.5"
                                 Tiles="_tiles"
                                 Hexes="_tileHexes"
                                 SelectedHex="_selectedTileHex"
                                 HighlightedHexes="_highlightedTileHexes"
                                 ShowCoordinates="@_showCoordinates"
                                 OnHexClicked="OnTileHexClicked"
                                 OnHexHovered="OnTileHexHovered" />
                    </div>
                    <div class="game-board-hand-area">
                        <CardHand Cards="@GetHandCards()"
                                  SelectedCardIndex="_selectedCardIndex"
                                  CanPlayPowered="@CanPlayPoweredForSelectedCard()"
                                  CanPlayPoweredForCard="@CanPlayPoweredForCard"
                                  OnCardSelected="SelectCard"
                                  OnCardPlayed="PlayCard"
                                  OnCardPlayedPowered="PlayCardPowered"
                                  OnCardUsedSideways="UseSidewaysCard" />
                    </div>
                    
                    <!-- Site Interaction Panel -->
                    <SiteInteractionPanel IsVisible="@_showSitePanel"
                                          SiteName="@_currentSiteName"
                                          Interactions="@_siteInteractions"
                                          AttackPool="@(_myPlayerState?.AttackPool ?? 0)"
                                          BlockPool="@(_myPlayerState?.BlockPool ?? 0)"
                                          InfluencePool="@(_myPlayerState?.InfluencePool ?? 0)"
                                          Message="@_siteInteractionMessage"
                                          IsError="@_siteInteractionIsError"
                                          OnInteractionSelected="HandleSiteInteraction"
                                          OnClose="CloseSitePanel" />
                    
                    <!-- Pending Choice Dialog -->
                    @if (_gameState.PendingChoice != null)
                    {
                        <div class="choice-overlay">
                            <div class="choice-dialog">
                                <h3>@_gameState.PendingChoice.CardName</h3>
                                <p class="choice-description">@_gameState.PendingChoice.Description</p>
                                
                                @if (_gameState.PendingChoice.RequiresDiscard)
                                {
                                    <div class="discard-section">
                                        <p class="discard-label">Select a card to discard:</p>
                                        <div class="discard-cards">
                                            @foreach (var cardId in _myPlayerState?.Hand ?? new List<string>())
                                            {
                                                if (cardId != _gameState.PendingChoice.CardId)
                                                {
                                                    var card = _cardDefinitions.FirstOrDefault(c => c.Id == cardId);
                                                    <button class="discard-card-btn @(_selectedDiscardCard == cardId ? "selected" : "")"
                                                            @onclick="() => SelectDiscardCard(cardId)">
                                                        @(card?.Name ?? cardId)
                                                    </button>
                                                }
                                            }
                                        </div>
                                    </div>
                                }
                                
                                <div class="choice-options">
                                    @foreach (var option in _gameState.PendingChoice.Options)
                                    {
                                        <button class="choice-option-btn @GetChoiceColorClass(option.Id)"
                                                @onclick="() => ResolveChoice(option.Id)"
                                                disabled="@(_gameState.PendingChoice.RequiresDiscard && string.IsNullOrEmpty(_selectedDiscardCard))">
                                            <span class="option-name">@option.Name</span>
                                            @if (!string.IsNullOrEmpty(option.Description))
                                            {
                                                <span class="option-desc">@option.Description</span>
                                            }
                                        </button>
                                    }
                                </div>
                                
                                <button class="btn btn-secondary cancel-choice-btn" @onclick="CancelChoice">
                                    Cancel
                                </button>
                            </div>
                        </div>
                    }
                }
            </main>

            <!-- Right sidebar - Actions and Hand -->
            <aside class="action-sidebar">
                <div class="card actions-card">
                    <h3>⚡ Actions</h3>
                    @if (IsMyTurn)
                    {
                        <div class="action-buttons">
                            @if (IsAtSite && !HasEnemiesAtCurrentPosition)
                            {
                                <button class="btn btn-gold" @onclick="OpenSitePanel">
                                    @GetCurrentSiteIcon() Site
                                </button>
                            }
                            <button class="btn btn-warning" @onclick="UndoLastAction" disabled="@(!_canUndo)" title="Undo last action">
                                ↩️ Undo
                            </button>
                            <button class="btn btn-primary" @onclick="EndTurn">
                                ✓ End Turn
                            </button>
                            <button class="btn btn-secondary" @onclick="Rest" disabled="@(!CanRest)" title="Rest to heal and reshuffle">
                                💤 Rest
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="waiting-indicator">
                            <div class="waiting-spinner"></div>
                            <span>Waiting for @GetCurrentPlayerName()...</span>
                        </div>
                    }
                </div>

                <div class="card units-card">
                    <h3>Your Units (@(_myPlayerState?.Units.Count ?? 0))</h3>
                    @if (_myPlayerState?.Units.Any() == true)
                    {
                        <div class="units-list">
                            @foreach (var unit in _myPlayerState.Units)
                            {
                                var unitDef = _unitDefinitions.FirstOrDefault(u => u.Id == unit.UnitId);
                                <div class="unit-item @(unit.IsWounded ? "wounded" : "") @(!unit.IsReady ? "exhausted" : "")">
                                    <span>@(unitDef?.Name ?? unit.UnitId)</span>
                                    @if (unit.IsWounded)
                                    {
                                        <span class="wounded-badge" title="Wounded">💔</span>
                                    }
                                    @if (!unit.IsReady)
                                    {
                                        <span class="exhausted-badge" title="Exhausted">💤</span>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-sm">No units recruited yet</p>
                    }
                </div>

                <!-- Offers -->
                <div class="card offers-card">
                    <h3>📋 Offers</h3>
                    
                    <!-- Unit Offers -->
                    <div class="offer-section">
                        <h4>⚔️ Units</h4>
                        <div class="offer-list">
                            @if (_gameState.UnitOffers != null && (_gameState.UnitOffers.RegularUnits.Any() || _gameState.UnitOffers.EliteUnits.Any()))
                            {
                                @foreach (var unitId in _gameState.UnitOffers.RegularUnits)
                                {
                                    var unitDef = _unitDefinitions.FirstOrDefault(u => u.Id == unitId);
                                    var unitToShow = unitDef;
                                    <div class="offer-item offer-item-clickable" @onclick="() => ShowUnitDetail(unitToShow)" role="button" tabindex="0" @onkeydown="@(e => { if (e.Key == "Enter") ShowUnitDetail(unitToShow); })">
                                        <span class="offer-name">@(unitDef?.Name ?? unitId)</span>
                                        <span class="offer-badge regular">Regular</span>
                                    </div>
                                }
                                @foreach (var unitId in _gameState.UnitOffers.EliteUnits)
                                {
                                    var unitDef = _unitDefinitions.FirstOrDefault(u => u.Id == unitId);
                                    var unitToShow = unitDef;
                                    <div class="offer-item offer-item-clickable" @onclick="() => ShowUnitDetail(unitToShow)" role="button" tabindex="0" @onkeydown="@(e => { if (e.Key == "Enter") ShowUnitDetail(unitToShow); })">
                                        <span class="offer-name">@(unitDef?.Name ?? unitId)</span>
                                        <span class="offer-badge elite">Elite</span>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="text-muted text-sm">No units available</p>
                            }
                        </div>
                    </div>

                    <!-- Spell Offers -->
                    <div class="offer-section">
                        <h4>✨ Spells</h4>
                        <div class="offer-list">
                            @if (_gameState.SpellOffers != null && _gameState.SpellOffers.Spells.Any())
                            {
                                @foreach (var spellId in _gameState.SpellOffers.Spells)
                                {
                                    var spellDef = _spellDefinitions.FirstOrDefault(s => s.Id == spellId);
                                    var spellToShow = spellDef;
                                    <div class="offer-item offer-item-clickable" @onclick="() => ShowSpellDetail(spellToShow)" role="button" tabindex="0" @onkeydown="@(e => { if (e.Key == "Enter") ShowSpellDetail(spellToShow); })">
                                        <span class="offer-name">@(spellDef?.Name ?? spellId)</span>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="text-muted text-sm">No spells available</p>
                            }
                        </div>
                    </div>

                    <!-- Advanced Action Offers -->
                    <div class="offer-section">
                        <h4>🎯 Advanced Actions</h4>
                        <div class="offer-list">
                            @if (_gameState.AdvancedActionOffers != null && _gameState.AdvancedActionOffers.AdvancedActions.Any())
                            {
                                @foreach (var actionId in _gameState.AdvancedActionOffers.AdvancedActions)
                                {
                                    var actionDef = _advancedActionDefinitions.FirstOrDefault(a => a.Id == actionId);
                                    <div class="offer-item">
                                        <span class="offer-name">@(actionDef?.Name ?? actionId)</span>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="text-muted text-sm">No advanced actions available</p>
                            }
                        </div>
                    </div>
                </div>
            </aside>
        </div>

        @if (_showLog)
        {
            <div class="game-log-overlay" @onclick="ToggleLog">
                <div class="game-log card" @onclick:stopPropagation="true">
                    <div class="log-header">
                        <h3>Game Log</h3>
                        <button class="btn btn-sm btn-secondary" @onclick="ToggleLog">✕</button>
                    </div>
                    <div class="log-entries">
                        @foreach (var entry in _gameState.GameLog.TakeLast(50).Reverse())
                        {
                            <div class="log-entry">
                                <span class="log-time">@entry.Timestamp.ToString("HH:mm")</span>
                                <span class="log-action">[@entry.Action]</span>
                                <span class="log-message">@entry.Details</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        @if (_showChat)
        {
            <div class="chat-overlay" @onclick="ToggleChat">
                <div class="chat-panel card" @onclick:stopPropagation="true">
                    <div class="chat-header">
                        <h3>💬 Chat</h3>
                        <button class="btn btn-sm btn-secondary" @onclick="ToggleChat">✕</button>
                    </div>
                    <div class="chat-messages">
                        @foreach (var msg in _chatMessages.TakeLast(50))
                        {
                            <div class="chat-message">
                                <span class="chat-time">@msg.Timestamp.ToString("HH:mm")</span>
                                <span class="chat-username">@msg.Username:</span>
                                <span class="chat-text">@msg.Message</span>
                            </div>
                        }
                        @if (_chatMessages.Count == 0)
                        {
                            <p class="text-muted text-center">No messages yet. Say hello!</p>
                        }
                    </div>
                    <div class="chat-input-area">
                        <input type="text" @bind="_chatInput" @bind:event="oninput" 
                               @onkeypress="HandleChatKeyPress" 
                               placeholder="Type a message..." 
                               class="chat-input" />
                        <button class="btn btn-primary btn-sm" @onclick="SendChatMessage">Send</button>
                    </div>
                </div>
            </div>
        }

        @if (_detailUnit != null || _detailSpell != null)
        {
            <div class="detail-overlay" @onclick="CloseDetailModal">
                <div class="detail-modal card" @onclick:stopPropagation="true">
                    <div class="detail-modal-header">
                        <h3>@(_detailUnit?.Name ?? _detailSpell?.Name ?? "")</h3>
                        <button type="button" class="btn btn-sm btn-secondary" @onclick="CloseDetailModal" aria-label="Stäng">✕</button>
                    </div>
                    <div class="detail-modal-body">
                        @if (_detailUnit != null)
                        {
                            var u = _detailUnit;
                            var unitImg = GetDefinitionImageUrl(u.Image);
                            <div class="detail-content">
                                @if (!string.IsNullOrEmpty(unitImg))
                                {
                                    <img src="@unitImg" alt="@u.Name" class="detail-image" />
                                }
                                <div class="detail-info">
                                    <p class="detail-meta"><span class="offer-badge @(u.IsElite ? "elite" : "regular")">@u.Rank</span> · Recruit cost: @u.RecruitCost · Armor: @u.Armor</p>
                                    @if (u.Abilities?.Any() == true)
                                    {
                                        <p class="detail-label">Abilities:</p>
                                        <ul class="detail-list">
                                            @foreach (var a in u.Abilities)
                                            {
                                                <li>@a</li>
                                            }
                                        </ul>
                                    }
                                    @if (u.Resistances?.Any() == true)
                                    {
                                        <p class="detail-label">Resistances: @string.Join(", ", u.Resistances)</p>
                                    }
                                    @if (!string.IsNullOrEmpty(u.Notes))
                                    {
                                        <p class="detail-notes">@u.Notes</p>
                                    }
                                </div>
                            </div>
                        }
                        else if (_detailSpell != null)
                        {
                            var s = _detailSpell;
                            var spellImg = GetDefinitionImageUrl(s.Image);
                            <div class="detail-content">
                                @if (!string.IsNullOrEmpty(spellImg))
                                {
                                    <img src="@spellImg" alt="@s.Name" class="detail-image" />
                                }
                                <div class="detail-info">
                                    @if (!string.IsNullOrEmpty(s.Color))
                                    {
                                        <p class="detail-meta">Color: @s.Color</p>
                                    }
                                    @if (s.EffectsBasic?.Any() == true)
                                    {
                                        <p class="detail-label">Basic:</p>
                                        <ul class="detail-list">
                                            @foreach (var e in s.EffectsBasic)
                                            {
                                                <li>@(e.Description ?? $"{e.Type} {e.Value}")</li>
                                            }
                                        </ul>
                                    }
                                    @if (s.EffectsStrong?.Any() == true)
                                    {
                                        <p class="detail-label">Strong:</p>
                                        <ul class="detail-list">
                                            @foreach (var e in s.EffectsStrong)
                                            {
                                                <li>@(e.Description ?? $"{e.Type} {e.Value}")</li>
                                            }
                                        </ul>
                                    }
                                    @if (!string.IsNullOrEmpty(s.Note))
                                    {
                                        <p class="detail-notes">@s.Note</p>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

<style>
    .game-board-container {
        height: calc(100vh - 2rem);
        display: flex;
        flex-direction: column;
        margin: calc(-1 * var(--spacing-lg));
        padding: 0;
    }

    .game-layout {
        flex: 1;
        display: grid;
        grid-template-columns: 260px 1fr 300px;
        gap: var(--spacing-sm);
        padding: var(--spacing-sm);
        overflow: hidden;
        min-height: 0;
    }

    /* Game info box - left sidebar top (replaces header) */
    .game-info-box {
        padding: var(--spacing-sm) var(--spacing-md) !important;
        flex-shrink: 0;
    }

    .game-info-title {
        font-size: 0.95rem;
        margin: 0 0 2px 0;
        font-weight: 700;
        color: var(--color-text-primary);
    }

    .game-info-scenario {
        font-size: 0.75rem;
        color: var(--color-text-secondary);
        display: block;
        margin-bottom: var(--spacing-xs);
    }

    .game-info-badges {
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
        align-items: center;
        margin-bottom: var(--spacing-xs);
    }

    .game-info-controls {
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
        align-items: center;
    }

    .game-info-controls .btn {
        padding: 2px 6px;
        font-size: 0.7rem;
    }

    .player-sidebar,
    .action-sidebar {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-sm);
        overflow-y: auto;
        min-height: 0;
        scrollbar-width: thin;
        scrollbar-color: var(--color-border) transparent;
    }

    .player-sidebar::-webkit-scrollbar,
    .action-sidebar::-webkit-scrollbar {
        width: 6px;
    }

    .player-sidebar::-webkit-scrollbar-track,
    .action-sidebar::-webkit-scrollbar-track {
        background: transparent;
    }

    .player-sidebar::-webkit-scrollbar-thumb,
    .action-sidebar::-webkit-scrollbar-thumb {
        background: var(--color-border);
        border-radius: 3px;
    }

    .action-sidebar {
        justify-content: flex-start;
    }

    .player-sidebar .card,
    .action-sidebar .card {
        padding: var(--spacing-sm);
        flex-shrink: 0;
    }

    .player-sidebar h3,
    .action-sidebar h3 {
        font-size: 0.9rem;
        margin-bottom: var(--spacing-sm);
    }

    /* Responsive breakpoints */
    @@media (max-width: 1400px) {
        .game-layout {
            grid-template-columns: 240px 1fr 280px;
        }
    }

    @@media (max-width: 1200px) {
        .game-layout {
