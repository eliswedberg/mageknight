    private async Task EndTurn()
    {
        // Check if we're in combat - can't end turn during combat
        if (_gameState.Combat != null)
        {
            await JSRuntime.InvokeVoidAsync("alert", "Cannot end turn during combat. Finish or flee from combat first.");
            return;
        }

        // Check if we're in tactics selection phase
        if (_gameState.Phase == GamePhase.TacticsSelection)
        {
            await JSRuntime.InvokeVoidAsync("alert", "Cannot end turn during tactics selection. Select a tactic first.");
            return;
        }

        var result = await GameService.EndTurnAsync(GameId, AuthService.CurrentUser!.Id);
        if (result.Success)
        {
            _selectedCardIndex = null;
            _hasRevealedSomething = false; // Reset for next turn
            await LoadGame();
            await NotifyGameStateChanged("Turn ended");
            
            // Notify the next player that it's their turn
            await NotifyNextPlayerTurn();
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("alert", result.ErrorMessage ?? "Failed to end turn");
        }
    }

    private async Task NotifyNextPlayerTurn()
    {
        if (_hubConnection?.State != HubConnectionState.Connected || _game == null || _gameState == null)
            return;

        // Get the current player (after the turn ended, this is the new current player)
        if (_gameState.CurrentPlayerIndex >= 0 && 
            _gameState.CurrentPlayerIndex < _gameState.TurnOrder.Count)
        {
            var currentPlayerIdx = _gameState.TurnOrder[_gameState.CurrentPlayerIndex];
            if (currentPlayerIdx >= 0 && currentPlayerIdx < _gameState.Players.Count)
            {
                var currentPlayer = _gameState.Players[currentPlayerIdx];
                
                // Don't notify yourself
                if (currentPlayer.UserId != AuthService.CurrentUser?.Id)
                {
                    // Send notification via SignalR hub
                    await _hubConnection.SendAsync("NotifyUserTurn", 
                        currentPlayer.UserId, 
                        GameId, 
                        _game.Name);
                }
            }
        }
    }

