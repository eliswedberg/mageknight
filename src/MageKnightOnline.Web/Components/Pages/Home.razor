@page "/"
@using MageKnightOnline.Core.GameState
@implements IDisposable
@inject AuthStateService AuthService
@inject IGameService GameService
@inject IGameDefinitionService DefinitionService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Mage Knight Online - Lobby</PageTitle>

@if (!AuthService.IsAuthenticated)
{
    <div class="hero-section">
        <div class="hero-content text-center">
            <h1>Mage Knight Online</h1>
            <p class="hero-subtitle">Experience the legendary board game in a new digital realm</p>
            
            <div class="hero-features">
                <div class="feature">
                    <img src="images/character_tovak.jpg" alt="Tovak" class="feature-img" />
                    <h4>Choose Your Hero</h4>
                    <p>Play as Tovak, Arythea, Goldyx, or Norowas</p>
                </div>
                <div class="feature">
                    <img src="images/MK_map_tiles_01-A.png" alt="Map" class="feature-img" />
                    <h4>Explore the Land</h4>
                    <p>Discover mysterious locations and ancient ruins</p>
                </div>
                <div class="feature">
                    <img src="images/enemy_draconum_fire_dragon_x2.png" alt="Dragon" class="feature-img" />
                    <h4>Battle Enemies</h4>
                    <p>Fight orcs, mages, and mighty dragons</p>
                </div>
            </div>

            <div class="hero-actions">
                <a href="/register" class="btn btn-primary btn-lg">Start Your Journey</a>
                <a href="/login" class="btn btn-secondary btn-lg">Login</a>
            </div>
        </div>
    </div>
}
else
{
    <div class="lobby">
        <div class="lobby-header">
            <div>
                <h1>Game Lobby</h1>
                <p class="text-muted">Join an existing game or create your own adventure</p>
            </div>
            <button class="btn btn-primary" @onclick="() => _showCreateModal = true">
                Create New Game
            </button>
        </div>

        @if (_isLoading)
        {
            <div class="text-center mt-lg">
                <div class="spinner"></div>
                <p class="text-muted mt-md">Loading games...</p>
            </div>
        }
        else
        {
            <!-- My Active Games Section -->
            @if (_myGames.Any())
            {
                <div class="my-games-section">
                    <h3>🎮 Your Games</h3>
                    <div class="game-list">
                        @foreach (var game in _myGames)
                        {
                            var isMyTurn = IsMyTurn(game);
                            <div class="game-item @(isMyTurn ? "my-turn" : "") @(game.Status == GameStatus.InProgress ? "in-progress" : "")">
                                <div class="game-info">
                                    <h4>
                                        @game.Name
                                        @if (isMyTurn)
                                        {
                                            <span class="turn-badge">⚡ YOUR TURN</span>
                                        }
                                    </h4>
                                    <div class="game-meta">
                                        <span>@GetScenarioName(game.ScenarioId)</span>
                                        <span>👥 @game.Players.Count / @game.MaxPlayers players</span>
                                        @if (game.Status == GameStatus.InProgress)
                                        {
                                            <span class="status-badge status-active">🎯 In Progress</span>
                                        }
                                        else
                                        {
                                            <span class="status-badge status-waiting">⏳ Waiting</span>
                                        }
                                    </div>
                                </div>
                                <div class="game-actions">
                                    @if (game.Status == GameStatus.InProgress)
                                    {
                                        <a href="/play/@game.Id" class="btn @(isMyTurn ? "btn-gold" : "btn-primary") btn-sm">
                                            @(isMyTurn ? "▶ Play Now" : "Continue")
                                        </a>
                                    }
                                    else
                                    {
                                        <a href="/game/@game.Id" class="btn btn-secondary btn-sm">
                                            Enter Lobby
                                        </a>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Available Games Section -->
            <div class="available-games-section">
                <h3>🌐 Available Games</h3>
                @if (_availableGames.Count == 0)
                {
                    <div class="card text-center">
                        <p class="text-muted">No games waiting for players</p>
                        <button class="btn btn-primary mt-md" @onclick="() => _showCreateModal = true">
                            Create Game
                        </button>
                    </div>
                }
                else
                {
                    <div class="game-list">
                        @foreach (var game in _availableGames)
                        {
                            <div class="game-item">
                                <div class="game-info">
                                    <h4>@game.Name</h4>
                                    <div class="game-meta">
                                        <span>@GetScenarioName(game.ScenarioId)</span>
                                        <span>👥 @game.Players.Count / @game.MaxPlayers players</span>
                                        <span>Created by @game.CreatedBy.Username</span>
                                    </div>
                                </div>
                                <div class="game-actions">
                                    <span class="badge badge-waiting">Waiting</span>
                                    @if (!game.Players.Any(p => p.UserId == AuthService.CurrentUser!.Id))
                                    {
                                        <button class="btn btn-primary btn-sm" @onclick="() => JoinGame(game.Id)">
                                            Join
                                        </button>
                                    }
                                    else
                                    {
                                        <a href="/game/@game.Id" class="btn btn-secondary btn-sm">
                                            Enter
                                        </a>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>

    @if (_showCreateModal)
    {
        <div class="modal-overlay" @onclick="() => _showCreateModal = false">
            <div class="modal card card-gold" @onclick:stopPropagation="true">
                <div class="card-header">
                    <h3>Create New Game</h3>
                </div>

                @if (!string.IsNullOrEmpty(_createError))
                {
                    <div class="alert alert-error">@_createError</div>
                }

                <div class="form-group">
                    <label class="form-label">Game Name</label>
                    <input type="text" class="form-input" @bind="_createModel.Name" placeholder="Enter game name" />
                </div>

                <div class="form-group">
                    <label class="form-label">Scenario</label>
                    <select class="form-input form-select" @bind="_createModel.ScenarioId">
                        <option value="">Select a scenario...</option>
                        @foreach (var scenario in _scenarios)
                        {
                            <option value="@scenario.Id">@scenario.Name (@scenario.Type)</option>
                        }
                    </select>
                </div>

                @if (_selectedScenario != null)
                {
                    <div class="form-group">
                        <label class="form-label">Max Players</label>
                        <select class="form-input form-select" @bind="_createModel.MaxPlayers">
                            @for (int i = _selectedScenario.MinPlayers; i <= _selectedScenario.MaxPlayers; i++)
                            {
                                <option value="@i">@i players</option>
                            }
                        </select>
                    </div>

                    <div class="scenario-info">
                        <p><strong>Rounds:</strong> @_selectedScenario.Rounds</p>
                        <p><strong>Goal:</strong> @_selectedScenario.Goal</p>
                    </div>
                }

                <div class="modal-actions">
                    <button class="btn btn-secondary" @onclick="() => _showCreateModal = false">Cancel</button>
                    <button class="btn btn-primary" @onclick="CreateGame" disabled="@_isCreating">
                        @(_isCreating ? "Creating..." : "Create Game")
                    </button>
                </div>
            </div>
        </div>
    }
}

<style>
    .hero-section {
        padding: var(--spacing-2xl) 0;
    }

    .hero-content h1 {
        font-size: 3.5rem;
        margin-bottom: var(--spacing-md);
    }

    .hero-subtitle {
        font-size: 1.3rem;
        color: var(--color-text-secondary);
        margin-bottom: var(--spacing-2xl);
    }

    .hero-features {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: var(--spacing-xl);
        margin-bottom: var(--spacing-2xl);
    }

    .feature {
        background: var(--color-bg-card);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        padding: var(--spacing-lg);
    }

    .feature-img {
        width: 100%;
        max-width: 120px;
        height: 120px;
        object-fit: cover;
        border-radius: var(--radius-md);
        margin-bottom: var(--spacing-md);
    }

    .feature h4 {
        margin-bottom: var(--spacing-sm);
    }

    .feature p {
        color: var(--color-text-secondary);
        margin: 0;
    }

    .hero-actions {
        display: flex;
        gap: var(--spacing-md);
        justify-content: center;
    }

    .lobby-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: var(--spacing-xl);
    }

    .lobby-header h1 {
        margin-bottom: var(--spacing-xs);
    }

    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.8);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 1000;
    }

    .modal {
        width: 100%;
        max-width: 500px;
        max-height: 90vh;
        overflow-y: auto;
    }

    .modal-actions {
        display: flex;
        gap: var(--spacing-md);
        justify-content: flex-end;
        margin-top: var(--spacing-lg);
    }

    .scenario-info {
        background: var(--color-bg-dark);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-md);
        padding: var(--spacing-md);
        margin-top: var(--spacing-md);
    }

    .scenario-info p {
        margin: var(--spacing-xs) 0;
        font-size: 0.9rem;
    }

    .my-games-section,
    .available-games-section {
        margin-bottom: var(--spacing-xl);
    }

    .my-games-section h3,
    .available-games-section h3 {
        font-size: 1.3rem;
        margin-bottom: var(--spacing-md);
        padding-bottom: var(--spacing-sm);
        border-bottom: 1px solid var(--color-border);
    }

    .game-item.my-turn {
        border: 2px solid var(--color-gold);
        background: linear-gradient(135deg, var(--color-bg-card) 0%, rgba(212, 168, 83, 0.1) 100%);
        animation: pulse-border 2s ease-in-out infinite;
    }

    .game-item.in-progress {
        border-left: 4px solid var(--color-success);
    }

    @@keyframes pulse-border {
        0%, 100% { box-shadow: 0 0 5px rgba(212, 168, 83, 0.3); }
        50% { box-shadow: 0 0 15px rgba(212, 168, 83, 0.6); }
    }

    .turn-badge {
        display: inline-block;
        background: linear-gradient(135deg, var(--color-gold) 0%, #f0c96e 100%);
        color: var(--color-bg-dark);
        font-size: 0.7rem;
        padding: 2px 8px;
        border-radius: var(--radius-sm);
        margin-left: var(--spacing-sm);
        font-weight: bold;
        text-transform: uppercase;
        animation: pulse-glow 1.5s ease-in-out infinite;
    }

    @@keyframes pulse-glow {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.7; }
    }

    .status-badge {
        font-size: 0.75rem;
        padding: 2px 6px;
        border-radius: var(--radius-sm);
    }

    .status-badge.status-active {
        background: rgba(34, 197, 94, 0.2);
        color: var(--color-success);
    }

    .status-badge.status-waiting {
        background: rgba(245, 158, 11, 0.2);
        color: var(--color-warning);
    }

    .btn-gold {
        background: linear-gradient(135deg, var(--color-gold) 0%, #f0c96e 100%);
        color: var(--color-bg-dark);
        border: none;
        font-weight: bold;
    }

    .btn-gold:hover {
        background: linear-gradient(135deg, #f0c96e 0%, var(--color-gold) 100%);
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(212, 168, 83, 0.4);
    }

    @@media (max-width: 768px) {
        .hero-features {
            grid-template-columns: 1fr;
        }

        .hero-actions {
            flex-direction: column;
        }
    }
</style>

@code {
    private List<Game> _myGames = new();
    private List<Game> _availableGames = new();
    private List<ScenarioDefinition> _scenarios = new();
    private Dictionary<Guid, GameStateModel?> _gameStates = new();
    private bool _isLoading = true;
    private bool _showCreateModal;
    private bool _isCreating;
    private string? _createError;
    private CreateGameModel _createModel = new();

    private ScenarioDefinition? _selectedScenario => 
        _scenarios.FirstOrDefault(s => s.Id == _createModel.ScenarioId);

    protected override async Task OnInitializedAsync()
    {
        AuthService.OnAuthStateChanged += OnAuthStateChanged;
        _scenarios = (await DefinitionService.GetScenariosAsync()).ToList();
        
        if (AuthService.IsAuthenticated)
        {
            await LoadGames();
        }
    }

    private async void OnAuthStateChanged()
    {
        if (AuthService.IsAuthenticated)
        {
            await LoadGames();
        }
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        AuthService.OnAuthStateChanged -= OnAuthStateChanged;
    }

    private async Task LoadGames()
    {
        _isLoading = true;
        
        // Load my games (includes both waiting and in-progress)
        _myGames = (await GameService.GetMyGamesAsync(AuthService.CurrentUser!.Id)).ToList();
        
        // Load available games (only waiting, excluding ones I'm already in)
        var allAvailable = (await GameService.GetAvailableGamesAsync()).ToList();
        _availableGames = allAvailable.Where(g => !g.Players.Any(p => p.UserId == AuthService.CurrentUser!.Id)).ToList();
        
        // Parse game states for in-progress games to check whose turn it is
        _gameStates.Clear();
        foreach (var game in _myGames.Where(g => g.Status == GameStatus.InProgress))
        {
            if (!string.IsNullOrEmpty(game.GameState))
            {
                try
                {
                    var state = System.Text.Json.JsonSerializer.Deserialize<GameStateModel>(game.GameState);
                    _gameStates[game.Id] = state;
                }
                catch
                {
                    _gameStates[game.Id] = null;
                }
            }
        }
        
        _isLoading = false;
    }

    private bool IsMyTurn(Game game)
    {
        if (game.Status != GameStatus.InProgress)
            return false;
        
        if (!_gameStates.TryGetValue(game.Id, out var state) || state == null)
            return false;
        
        // Check if it's my turn
        if (state.CurrentPlayerIndex < 0 || state.CurrentPlayerIndex >= state.TurnOrder.Count)
            return false;
        
        var currentPlayerIndex = state.TurnOrder[state.CurrentPlayerIndex];
        if (currentPlayerIndex >= state.Players.Count)
            return false;
        
        var currentPlayer = state.Players[currentPlayerIndex];
        return currentPlayer.UserId == AuthService.CurrentUser?.Id;
    }

    private string GetScenarioName(string scenarioId)
    {
        return _scenarios.FirstOrDefault(s => s.Id == scenarioId)?.Name ?? scenarioId;
    }

    private async Task JoinGame(Guid gameId)
    {
        var result = await GameService.JoinGameAsync(gameId, AuthService.CurrentUser!.Id);
        if (result.Success)
        {
            Navigation.NavigateTo($"/game/{gameId}");
        }
    }

    private async Task CreateGame()
    {
        _isCreating = true;
        _createError = null;

        if (string.IsNullOrEmpty(_createModel.ScenarioId))
        {
            _createError = "Please select a scenario.";
            _isCreating = false;
            return;
        }

        var request = new CreateGameRequest
        {
            Name = _createModel.Name,
            ScenarioId = _createModel.ScenarioId,
            MaxPlayers = _createModel.MaxPlayers
        };

        var result = await GameService.CreateGameAsync(AuthService.CurrentUser!.Id, request);

        if (result.Success)
        {
            _showCreateModal = false;
            Navigation.NavigateTo($"/game/{result.Game!.Id}");
        }
        else
        {
            _createError = result.ErrorMessage;
        }

        _isCreating = false;
    }

    private class CreateGameModel
    {
        public string Name { get; set; } = string.Empty;
        public string ScenarioId { get; set; } = string.Empty;
        public int MaxPlayers { get; set; } = 4;
    }
}
