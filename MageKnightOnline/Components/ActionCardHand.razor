@using MageKnightOnline.Models
@using MageKnightOnline.Services
@inject ActionCardService ActionCardService
@inject TurnManagementService TurnManagementService
@inject ILogger<ActionCardHand> Logger

<div class="action-card-hand">
    <h4>Action Cards</h4>
    
    @if (PlayerId.HasValue)
    {
        <div class="card-controls mb-3">
            <button class="btn btn-primary btn-sm me-2" @onclick="DrawCard" disabled="@(isDrawing)">
                @if (isDrawing) { <span>Drawing...</span> } else { <span>Draw Card</span> }
            </button>
            <button class="btn btn-secondary btn-sm" @onclick="ShuffleDeck" disabled="@(isShuffling)">
                @if (isShuffling) { <span>Shuffling...</span> } else { <span>Shuffle Discard to Deck</span> }
            </button>
        </div>

        <div class="card-locations">
            <!-- Hand -->
            <div class="card-location">
                <h5>Hand (@handCards.Count)</h5>
                <div class="card-grid">
                    @foreach (var card in handCards)
                    {
                        <div class="action-card @GetCardClass(card)" @onclick="() => PlayCard(card)">
                            <div class="card-header">
                                <span class="card-name">@card.Name</span>
                                <span class="card-type">@card.Type</span>
                            </div>
                            <div class="card-effects">
                                @foreach (var effect in GetCardEffects(card))
                                {
                                    <div class="effect">
                                        <span class="effect-phase">@effect.Phase:</span>
                                        <span class="effect-description">@effect.Effect</span>
                                        @if (effect.Values.Move > 0) { <span class="effect-value move">Move @effect.Values.Move</span> }
                                        @if (effect.Values.Influence > 0) { <span class="effect-value influence">Influence @effect.Values.Influence</span> }
                                        @if (effect.Values.Attack > 0) { <span class="effect-value attack">Attack @effect.Values.Attack</span> }
                                        @if (effect.Values.Block > 0) { <span class="effect-value block">Block @effect.Values.Block</span> }
                                    </div>
                                }
                            </div>
                            @if (card.StrongRequiresMana)
                            {
                                <div class="card-strong">
                                    <small>Strong effect requires mana</small>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Played Cards -->
            @if (playedCards.Any())
            {
                <div class="card-location">
                    <h5>Played Cards (@playedCards.Count)</h5>
                    <div class="card-grid">
                        @foreach (var card in playedCards)
                        {
                            <div class="action-card played @GetCardClass(card)">
                                <div class="card-header">
                                    <span class="card-name">@card.Name</span>
                                    @if (card.IsPlayedSideways) { <span class="sideways-indicator">Sideways</span> }
                                    @if (card.UsingStrongEffect) { <span class="strong-indicator">Strong</span> }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Deck and Discard Info -->
            <div class="deck-info">
                <div class="deck-stats">
                    <span>Deck: @deckCount cards</span>
                    <span>Discard: @discardCount cards</span>
                </div>
            </div>
        </div>
    }
    else
    {
        <p>No player selected</p>
    }
</div>

@code {
    [Parameter] public int? PlayerId { get; set; }
    [Parameter] public int? GameSessionId { get; set; }
    [Parameter] public EventCallback<ActionCard> OnCardPlayed { get; set; }

    private List<ActionCard> handCards = new();
    private List<ActionCard> playedCards = new();
    private int deckCount = 0;
    private int discardCount = 0;
    private bool isDrawing = false;
    private bool isShuffling = false;

    protected override async Task OnParametersSetAsync()
    {
        if (PlayerId.HasValue)
        {
            await LoadPlayerCards();
        }
    }

    private async Task LoadPlayerCards()
    {
        if (!PlayerId.HasValue) return;

        try
        {
            handCards = await ActionCardService.GetPlayerCardsAsync(PlayerId.Value, CardLocation.Hand);
            playedCards = await ActionCardService.GetPlayerCardsAsync(PlayerId.Value, CardLocation.Played);
            
            var deckCards = await ActionCardService.GetPlayerCardsAsync(PlayerId.Value, CardLocation.Deck);
            var discardCards = await ActionCardService.GetPlayerCardsAsync(PlayerId.Value, CardLocation.Discard);
            
            deckCount = deckCards.Count;
            discardCount = discardCards.Count;
            
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load player cards for player {PlayerId}", PlayerId);
        }
    }

    private async Task DrawCard()
    {
        if (!PlayerId.HasValue || isDrawing) return;

        isDrawing = true;
        try
        {
            var drawnCard = await ActionCardService.DrawCardAsync(PlayerId.Value);
            if (drawnCard != null)
            {
                await LoadPlayerCards();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to draw card for player {PlayerId}", PlayerId);
        }
        finally
        {
            isDrawing = false;
        }
    }

    private async Task PlayCard(ActionCard card)
    {
        if (card.Location != CardLocation.Hand) return;

        try
        {
            // Get current turn to play the card through turn management
            if (GameSessionId.HasValue && PlayerId.HasValue)
            {
                var currentTurn = await TurnManagementService.GetCurrentTurnAsync(GameSessionId.Value, PlayerId.Value);
                if (currentTurn != null && currentTurn.Phase == TurnPhase.Main)
                {
                    // Play card through turn management system
                    var success = await TurnManagementService.PlayActionCardAsync(currentTurn.Id, card.Id, sideways: false, useStrongEffect: false);
                    if (success)
                    {
                        await LoadPlayerCards();
                        await OnCardPlayed.InvokeAsync(card);
                    }
                }
                else
                {
                    Logger.LogWarning("Cannot play card - not in main phase or no active turn");
                }
            }
            else
            {
                // Fallback to direct card play
                var success = await ActionCardService.PlayCardAsync(card, sideways: false, useStrongEffect: false);
                if (success)
                {
                    await LoadPlayerCards();
                    await OnCardPlayed.InvokeAsync(card);
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to play card {CardId}", card.CardId);
        }
    }

    private async Task ShuffleDeck()
    {
        if (!PlayerId.HasValue || isShuffling) return;

        isShuffling = true;
        try
        {
            await ActionCardService.ShuffleDiscardToDeckAsync(PlayerId.Value);
            await LoadPlayerCards();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to shuffle deck for player {PlayerId}", PlayerId);
        }
        finally
        {
            isShuffling = false;
        }
    }

    private List<CardEffect> GetCardEffects(ActionCard card)
    {
        return ActionCardService.GetCardEffects(card);
    }

    private string GetCardClass(ActionCard card)
    {
        var classes = new List<string>();
        
        if (card.Color != ActionCardColor.None)
        {
            classes.Add($"card-{card.Color.ToString().ToLower()}");
        }
        
        if (card.Type == ActionCardType.Advanced)
        {
            classes.Add("card-advanced");
        }
        
        return string.Join(" ", classes);
    }
}

<style>
    .action-card-hand {
        padding: 1rem;
        border: 1px solid #ddd;
        border-radius: 8px;
        background-color: #f9f9f9;
    }

    .card-controls {
        display: flex;
        gap: 0.5rem;
    }

    .card-locations {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .card-location h5 {
        margin-bottom: 0.5rem;
        color: #333;
    }

    .card-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 0.5rem;
    }

    .action-card {
        border: 2px solid #ccc;
        border-radius: 6px;
        padding: 0.5rem;
        background-color: white;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .action-card:hover {
        border-color: #007bff;
        box-shadow: 0 2px 4px rgba(0,123,255,0.2);
    }

    .action-card.played {
        opacity: 0.7;
        cursor: default;
    }

    .card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.5rem;
    }

    .card-name {
        font-weight: bold;
        font-size: 0.9rem;
    }

    .card-type {
        font-size: 0.7rem;
        background-color: #e9ecef;
        padding: 0.2rem 0.4rem;
        border-radius: 3px;
    }

    .card-effects {
        font-size: 0.8rem;
    }

    .effect {
        margin-bottom: 0.3rem;
    }

    .effect-phase {
        font-weight: bold;
        color: #666;
    }

    .effect-value {
        display: inline-block;
        margin-left: 0.3rem;
        padding: 0.1rem 0.3rem;
        border-radius: 3px;
        font-size: 0.7rem;
        font-weight: bold;
    }

    .effect-value.move { background-color: #d4edda; color: #155724; }
    .effect-value.influence { background-color: #cce5ff; color: #004085; }
    .effect-value.attack { background-color: #f8d7da; color: #721c24; }
    .effect-value.block { background-color: #fff3cd; color: #856404; }

    .card-strong {
        margin-top: 0.5rem;
        padding-top: 0.5rem;
        border-top: 1px solid #eee;
        color: #666;
    }

    .sideways-indicator, .strong-indicator {
        font-size: 0.7rem;
        padding: 0.2rem 0.4rem;
        border-radius: 3px;
        margin-left: 0.3rem;
    }

    .sideways-indicator {
        background-color: #e2e3e5;
        color: #383d41;
    }

    .strong-indicator {
        background-color: #d1ecf1;
        color: #0c5460;
    }

    .deck-info {
        margin-top: 1rem;
        padding-top: 1rem;
        border-top: 1px solid #ddd;
    }

    .deck-stats {
        display: flex;
        gap: 1rem;
        font-size: 0.9rem;
        color: #666;
    }

    /* Card color classes */
    .card-red { border-left: 4px solid #dc3545; }
    .card-blue { border-left: 4px solid #007bff; }
    .card-white { border-left: 4px solid #6c757d; }
    .card-green { border-left: 4px solid #28a745; }
    .card-advanced { border-top: 3px solid #ffc107; }
</style>
