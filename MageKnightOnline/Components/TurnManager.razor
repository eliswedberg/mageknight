@using MageKnightOnline.Models
@using MageKnightOnline.Services
@inject TurnManagementService TurnManagementService
@inject ActionCardService ActionCardService
@inject ILogger<TurnManager> Logger

<div class="turn-manager">
    <h4>Turn Management</h4>
    
    @if (CurrentTurn != null)
    {
        <div class="turn-info">
            <div class="turn-header">
                <h5>Turn @CurrentTurn.TurnNumber - @CurrentTurn.Phase</h5>
                <span class="player-name">Player: @CurrentTurn.CurrentPlayer.KnightName</span>
            </div>

            <!-- Action Points Summary -->
            <div class="action-points">
                <h6>Available Action Points</h6>
                <div class="points-grid">
                    <div class="point-item">
                        <span class="point-label">Movement:</span>
                        <span class="point-value @GetPointClass(ActionSummary.MovementPoints)">@ActionSummary.MovementPoints</span>
                    </div>
                    <div class="point-item">
                        <span class="point-label">Attack:</span>
                        <span class="point-value @GetPointClass(ActionSummary.AttackPoints)">@ActionSummary.AttackPoints</span>
                    </div>
                    <div class="point-item">
                        <span class="point-label">Block:</span>
                        <span class="point-value @GetPointClass(ActionSummary.BlockPoints)">@ActionSummary.BlockPoints</span>
                    </div>
                    <div class="point-item">
                        <span class="point-label">Influence:</span>
                        <span class="point-value @GetPointClass(ActionSummary.InfluencePoints)">@ActionSummary.InfluencePoints</span>
                    </div>
                    <div class="point-item">
                        <span class="point-label">Mana:</span>
                        <span class="point-value">@ActionSummary.ManaAvailable</span>
                    </div>
                    <div class="point-item">
                        <span class="point-label">Crystals:</span>
                        <span class="point-value">@ActionSummary.CrystalsAvailable</span>
                    </div>
                </div>
            </div>

            <!-- Turn Controls -->
            <div class="turn-controls">
                @if (CurrentTurn.Phase == TurnPhase.Preparation)
                {
                    <button class="btn btn-primary" @onclick="StartMainPhase" disabled="@isLoading">
                        @if (isLoading) { <span>Starting...</span> } else { <span>Start Main Phase</span> }
                    </button>
                }
                else if (CurrentTurn.Phase == TurnPhase.Main)
                {
                    <button class="btn btn-warning" @onclick="PassTurn" disabled="@isLoading">
                        @if (isLoading) { <span>Passing...</span> } else { <span>Pass Turn</span> }
                    </button>
                }
                else if (CurrentTurn.Phase == TurnPhase.EndOfTurn)
                {
                    <button class="btn btn-success" @onclick="EndTurn" disabled="@isLoading">
                        @if (isLoading) { <span>Ending...</span> } else { <span>End Turn</span> }
                    </button>
                }
            </div>

            <!-- Turn Actions History -->
            @if (CurrentTurn.Actions.Any())
            {
                <div class="turn-actions">
                    <h6>Turn Actions</h6>
                    <div class="actions-list">
                        @foreach (var action in CurrentTurn.Actions.OrderBy(a => a.ActionSequence))
                        {
                            <div class="action-item">
                                <span class="action-sequence">@action.ActionSequence.</span>
                                <span class="action-description">@action.Description</span>
                                <span class="action-time">@action.Timestamp.ToString("HH:mm:ss")</span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="no-turn">
            <p>No active turn</p>
            @if (PlayerId.HasValue)
            {
                <button class="btn btn-primary" @onclick="StartNewTurn" disabled="@isLoading">
                    @if (isLoading) { <span>Starting...</span> } else { <span>Start New Turn</span> }
                </button>
            }
        </div>
    }
</div>

@code {
    [Parameter] public int GameSessionId { get; set; }
    [Parameter] public int? PlayerId { get; set; }
    [Parameter] public EventCallback OnTurnChanged { get; set; }

    private GameTurn? CurrentTurn;
    private ActionPointsSummary ActionSummary = new();
    private bool isLoading = false;

    protected override async Task OnParametersSetAsync()
    {
        if (PlayerId.HasValue)
        {
            await LoadCurrentTurn();
        }
    }

    private async Task LoadCurrentTurn()
    {
        if (!PlayerId.HasValue) return;

        try
        {
            CurrentTurn = await TurnManagementService.GetCurrentTurnAsync(GameSessionId, PlayerId.Value);
            if (CurrentTurn != null)
            {
                ActionSummary = await TurnManagementService.GetActionPointsSummaryAsync(CurrentTurn.Id);
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load current turn for player {PlayerId}", PlayerId);
        }
    }

    private async Task StartNewTurn()
    {
        if (!PlayerId.HasValue) return;

        isLoading = true;
        try
        {
            await TurnManagementService.StartNewTurnAsync(GameSessionId, PlayerId.Value);
            await LoadCurrentTurn();
            await OnTurnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to start new turn for player {PlayerId}", PlayerId);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task StartMainPhase()
    {
        if (CurrentTurn == null) return;

        isLoading = true;
        try
        {
            await TurnManagementService.StartMainPhaseAsync(CurrentTurn.Id);
            await LoadCurrentTurn();
            await OnTurnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to start main phase for turn {TurnId}", CurrentTurn.Id);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task PassTurn()
    {
        if (CurrentTurn == null) return;

        isLoading = true;
        try
        {
            await TurnManagementService.PassTurnAsync(CurrentTurn.Id);
            await LoadCurrentTurn();
            await OnTurnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to pass turn {TurnId}", CurrentTurn.Id);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task EndTurn()
    {
        if (CurrentTurn == null) return;

        isLoading = true;
        try
        {
            await TurnManagementService.EndTurnAsync(CurrentTurn.Id);
            await LoadCurrentTurn();
            await OnTurnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to end turn {TurnId}", CurrentTurn.Id);
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetPointClass(int points)
    {
        return points > 0 ? "available" : "unavailable";
    }
}

<style>
    .turn-manager {
        padding: 1rem;
        border: 1px solid #ddd;
        border-radius: 8px;
        background-color: #f9f9f9;
    }

    .turn-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid #ddd;
    }

    .turn-header h5 {
        margin: 0;
        color: #333;
    }

    .player-name {
        font-weight: bold;
        color: #666;
    }

    .action-points {
        margin-bottom: 1rem;
    }

    .action-points h6 {
        margin-bottom: 0.5rem;
        color: #333;
    }

    .points-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
        gap: 0.5rem;
    }

    .point-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.3rem 0.5rem;
        background-color: white;
        border-radius: 4px;
        border: 1px solid #eee;
    }

    .point-label {
        font-size: 0.9rem;
        color: #666;
    }

    .point-value {
        font-weight: bold;
        font-size: 1.1rem;
    }

    .point-value.available {
        color: #28a745;
    }

    .point-value.unavailable {
        color: #dc3545;
    }

    .turn-controls {
        margin-bottom: 1rem;
        text-align: center;
    }

    .turn-controls .btn {
        min-width: 120px;
    }

    .turn-actions {
        margin-top: 1rem;
        padding-top: 1rem;
        border-top: 1px solid #ddd;
    }

    .turn-actions h6 {
        margin-bottom: 0.5rem;
        color: #333;
    }

    .actions-list {
        max-height: 200px;
        overflow-y: auto;
        background-color: white;
        border: 1px solid #eee;
        border-radius: 4px;
        padding: 0.5rem;
    }

    .action-item {
        display: flex;
        align-items: center;
        padding: 0.2rem 0;
        border-bottom: 1px solid #f0f0f0;
    }

    .action-item:last-child {
        border-bottom: none;
    }

    .action-sequence {
        font-weight: bold;
        color: #666;
        margin-right: 0.5rem;
        min-width: 20px;
    }

    .action-description {
        flex: 1;
        font-size: 0.9rem;
    }

    .action-time {
        font-size: 0.8rem;
        color: #999;
        margin-left: 0.5rem;
    }

    .no-turn {
        text-align: center;
        padding: 2rem;
        color: #666;
    }

    .no-turn .btn {
        margin-top: 1rem;
    }
</style>
