@page "/password-test"
@using Microsoft.AspNetCore.Identity
@using MageKnightOnline.Data
@inject UserManager<ApplicationUser> UserManager
@inject ILogger<PasswordTest> Logger

<PageTitle>Password Test</PageTitle>

<h1>Password Test</h1>

<div class="row">
    <div class="col-md-6">
        <h3>Test Password Hash</h3>
        <EditForm Model="TestModel" OnValidSubmit="TestPassword">
            <div class="form-group mb-3">
                <label for="Email">Email:</label>
                <InputText @bind-Value="TestModel.Email" id="Email" class="form-control" />
            </div>
            <div class="form-group mb-3">
                <label for="Password">Password:</label>
                <InputText type="password" @bind-Value="TestModel.Password" id="Password" class="form-control" />
            </div>
            <button type="submit" class="btn btn-primary">Test Password</button>
        </EditForm>
        
        @if (!string.IsNullOrEmpty(ResultMessage))
        {
            <div class="alert alert-info mt-3">
                @ResultMessage
            </div>
        }
    </div>
    
    <div class="col-md-6">
        <h3>User Details</h3>
        @if (UserInfo != null)
        {
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">User Information</h5>
                    <p><strong>ID:</strong> @UserInfo.Id</p>
                    <p><strong>Email:</strong> @UserInfo.Email</p>
                    <p><strong>UserName:</strong> @UserInfo.UserName</p>
                    <p><strong>Password Hash:</strong> @(string.IsNullOrEmpty(UserInfo.PasswordHash) ? "None" : "Present")</p>
                    @if (!string.IsNullOrEmpty(UserInfo.PasswordHash))
                    {
                        <p><strong>Hash Length:</strong> @UserInfo.PasswordHash.Length</p>
                        <p><strong>Hash Preview:</strong> @UserInfo.PasswordHash.Substring(0, Math.Min(20, UserInfo.PasswordHash.Length))...</p>
                    }
                </div>
            </div>
        }
    </div>
</div>

@code {
    private PasswordTestModel TestModel { get; set; } = new();
    private string ResultMessage { get; set; } = "";
    private ApplicationUser? UserInfo { get; set; }

    public class PasswordTestModel
    {
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
    }

    protected override async Task OnInitializedAsync()
    {
        // Pre-fill with test user
        TestModel.Email = "eliwe1@hotmail.com";
        TestModel.Password = "elis123";
    }

    private async Task TestPassword()
    {
        ResultMessage = "";
        UserInfo = null;

        try
        {
            Logger.LogInformation("Password test for: {Email}", TestModel.Email);

            // Find the user
            var user = await UserManager.FindByEmailAsync(TestModel.Email);
            
            if (user == null)
            {
                ResultMessage = "User not found in database.";
                return;
            }

            UserInfo = user;
            Logger.LogInformation("User found: {UserId}", user.Id);

            // Test password verification
            var isValidPassword = await UserManager.CheckPasswordAsync(user, TestModel.Password);
            Logger.LogInformation("Password check result: {IsValid}", isValidPassword);

            if (isValidPassword)
            {
                ResultMessage = "Password is CORRECT!";
            }
            else
            {
                ResultMessage = "Password is INCORRECT!";
                
                // Let's also test if we can create a new hash and compare
                var newHash = UserManager.PasswordHasher.HashPassword(user, TestModel.Password);
                Logger.LogInformation("New hash for '{Password}': {Hash}", TestModel.Password, newHash);
                
                var verifyResult = UserManager.PasswordHasher.VerifyHashedPassword(user, user.PasswordHash, TestModel.Password);
                Logger.LogInformation("Direct hash verification result: {Result}", verifyResult);
                
                ResultMessage += $" Direct verification: {verifyResult}";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error during password test");
            ResultMessage = $"Error: {ex.Message}";
        }
    }
}
