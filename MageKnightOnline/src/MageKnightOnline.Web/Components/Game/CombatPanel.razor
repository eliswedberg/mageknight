@namespace MageKnightOnline.Web.Components.Game
@using MageKnightOnline.Core.GameState
@using MageKnightOnline.Core.GameEngine

<div class="combat-panel">
    <div class="combat-header">
        <h3>⚔️ Combat</h3>
        <span class="combat-phase @GetPhaseClass()">@GetPhaseText()</span>
    </div>

    <div class="enemies-section">
        <h4>Enemies</h4>
        <div class="enemy-list">
            @foreach (var (enemy, index) in Combat.Enemies.Select((e, i) => (e, i)))
            {
                var isSelected = SelectedEnemyIndex == index;
                var isSwift = enemy.IsSwift;
                var isTargetable = IsEnemyTargetable(enemy);
                <div class="enemy-card @(enemy.IsDefeated ? "defeated" : "") @(isSelected ? "selected" : "") @(isSwift && Combat.Phase == CombatPhase.SwiftAttack ? "swift-active" : "") @(!isTargetable ? "not-targetable" : "")"
                     @onclick="() => SelectEnemy(index)">
                    <div class="enemy-name">
                        @if (isSwift)
                        {
                            <span class="swift-icon" title="Swift - Attacks before block phase">⚡</span>
                        }
                        @enemy.Name
                    </div>
                    <div class="enemy-stats">
                        <span class="stat attack" title="Attack @enemy.AttackType">
                            ⚔️ @enemy.Attack
                            @if (enemy.AttackType != "Physical")
                            {
                                <span class="element-badge @enemy.AttackType.ToLower()">@GetElementIcon(enemy.AttackType)</span>
                            }
                        </span>
                        <span class="stat armor" title="Armor">🛡️ @enemy.Armor</span>
                    </div>
                    @if (enemy.Abilities.Any())
                    {
                        <div class="enemy-abilities">
                            @foreach (var ability in enemy.Abilities)
                            {
                                <span class="ability-badge @GetAbilityClass(ability)" title="@GetAbilityDescription(ability)">
                                    @GetAbilityIcon(ability) @ability
                                </span>
                            }
                        </div>
                    }
                    @if (enemy.Resistances.Any())
                    {
                        <div class="enemy-resistances">
                            @foreach (var resistance in enemy.Resistances)
                            {
                                <span class="resistance-badge" title="Resistant to @resistance">🛡️@resistance</span>
                            }
                        </div>
                    }
                    @if (enemy.IsDefeated)
                    {
                        <div class="defeated-overlay">✓ Defeated</div>
                    }
                    @if (enemy.IsBlocked)
                    {
                        <div class="blocked-overlay">🛡️ Blocked</div>
                    }
                </div>
            }
        </div>
    </div>

    @if (Units.Any())
    {
        <div class="units-section">
            <h4>Your Units</h4>
            <div class="unit-list">
                @foreach (var unit in Units)
                {
                    var isUnitSelected = SelectedUnitIndex == unit.UnitIndex;
                    <div class="unit-card @(unit.IsWounded ? "wounded" : "") @(!unit.IsReady ? "exhausted" : "") @(unit.UsedThisCombat ? "used" : "") @(isUnitSelected ? "selected" : "")"
                         @onclick="() => SelectUnit(unit.UnitIndex)">
                        <div class="unit-name">
                            @unit.UnitName
                            @if (unit.IsWounded)
                            {
                                <span class="wound-icon" title="Wounded">💔</span>
                            }
                            @if (!unit.IsReady)
                            {
                                <span class="exhausted-icon" title="Exhausted">😴</span>
                            }
                        </div>
                        <div class="unit-abilities">
                            @foreach (var ability in unit.AvailableAbilities)
                            {
                                <span class="unit-ability-badge @(CanUseAbility(unit, ability) ? "available" : "unavailable")">
                                    @ability.Description
                                </span>
                            }
                        </div>
                    </div>
                }
            </div>
            @if (SelectedUnitIndex.HasValue)
            {
                var selectedUnit = Units.FirstOrDefault(u => u.UnitIndex == SelectedUnitIndex.Value);
                @if (selectedUnit != null)
                {
                    <div class="unit-actions">
                        @foreach (var ability in selectedUnit.AvailableAbilities.Where(a => CanUseAbility(selectedUnit, a)))
                        {
                            <button class="btn btn-unit @GetAbilityButtonClass(ability.AbilityType)"
                                    @onclick="() => UseUnitAbility(selectedUnit.UnitIndex, ability.AbilityType)"
                                    disabled="@(!CanUseAbility(selectedUnit, ability))">
                                @ability.Description
                            </button>
                        }
                    </div>
                }
            }
        </div>
    }

    <div class="combat-actions">
        @switch (Combat.Phase)
        {
            case CombatPhase.SwiftAttack:
                <div class="phase-info swift-warning">
                    <p>⚡ <strong>Swift enemies attack first!</strong></p>
                    <p>Block their attacks or take damage before you can act.</p>
                    <p>Swift Damage: <span class="value damage">@GetSwiftDamage()</span></p>
                    <p>Your Block: <span class="value">@BlockPool</span></p>
                </div>
                @if (SelectedEnemyIndex.HasValue && BlockPool > 0)
                {
                    var enemy = Combat.Enemies[SelectedEnemyIndex.Value];
                    @if (enemy.IsSwift && !enemy.IsDefeated && !enemy.IsBlocked)
                    {
                        <button class="btn btn-primary" @onclick="() => DoBlock(SelectedEnemyIndex.Value)">
                            Block @enemy.Name (@enemy.Attack damage)
                        </button>
                    }
                }
                <button class="btn btn-secondary" @onclick="EndPhase">Continue to Ranged Phase</button>
                break;

            case CombatPhase.RangedAttack:
                <div class="phase-info">
                    <p>Use <strong>Ranged/Siege Attack</strong> to attack enemies from range.</p>
                    <p>Your Ranged Attack: <span class="value">@RangedAttack</span></p>
                    <p>Your Siege Attack: <span class="value">@SiegeAttack</span></p>
                </div>
                @if (SelectedEnemyIndex.HasValue)
                {
                    var enemy = Combat.Enemies[SelectedEnemyIndex.Value];
                    @if (!enemy.IsDefeated)
                    {
                        var requiredAttack = enemy.Armor;
                        var needsSiege = enemy.IsFortified;
                        <button class="btn btn-primary" @onclick="() => DoRangedAttack(SelectedEnemyIndex.Value)"
                                disabled="@(needsSiege ? SiegeAttack < requiredAttack : RangedAttack < requiredAttack)">
                            @(needsSiege ? "Siege" : "Ranged") Attack (@requiredAttack needed)
                            @if (needsSiege)
                            {
                                <span class="siege-required">🏰</span>
                            }
                        </button>
                    }
                }
                <button class="btn btn-secondary" @onclick="EndPhase">Skip to Block Phase</button>
                break;

            case CombatPhase.Block:
                <div class="phase-info">
                    <p>Block enemy attacks to prevent damage.</p>
                    <p>Your Block: <span class="value">@BlockPool</span></p>
                    <p>Incoming Damage: <span class="value damage">@GetIncomingDamage()</span></p>
                </div>
                @if (SelectedEnemyIndex.HasValue && BlockPool > 0)
                {
                    var enemy = Combat.Enemies[SelectedEnemyIndex.Value];
                    @if (!enemy.IsDefeated && !enemy.IsBlocked && !enemy.IsSwift)
                    {
                        <button class="btn btn-primary" @onclick="() => DoBlock(SelectedEnemyIndex.Value)">
                            Block @enemy.Name (@enemy.Attack @enemy.AttackType damage)
                        </button>
                    }
                }
                <button class="btn btn-secondary" @onclick="EndPhase">End Block Phase</button>
                break;

            case CombatPhase.AssignDamage:
                var totalDamage = Combat.TotalUnblockedDamage;
                <div class="phase-info damage-warning">
                    <p>⚠️ Assign <span class="value damage">@totalDamage</span> unblocked damage.</p>
                    <p>Take wounds or assign damage to units.</p>
                </div>
                @if (Units.Any(u => !u.IsWounded || u.IsReady))
                {
                    <p class="hint">Click a unit to assign damage to it instead.</p>
                }
                <button class="btn btn-danger" @onclick="() => TakeDamage(totalDamage)">
                    Take @totalDamage Wounds
                </button>
                @if (SelectedUnitIndex.HasValue)
                {
                    var unit = Units.FirstOrDefault(u => u.UnitIndex == SelectedUnitIndex.Value);
                    @if (unit != null)
                    {
                        <button class="btn btn-warning" @onclick="() => AssignDamageToUnit(unit.UnitIndex)">
                            Assign Damage to @unit.UnitName @(unit.IsWounded ? "(Will be destroyed)" : "(Will be wounded)")
                        </button>
                    }
                }
                break;

            case CombatPhase.Attack:
                <div class="phase-info">
                    <p>Attack enemies with melee.</p>
                    <p>Your Attack: <span class="value">@AttackPool</span></p>
                </div>
                @if (SelectedEnemyIndex.HasValue && AttackPool > 0)
                {
                    var enemy = Combat.Enemies[SelectedEnemyIndex.Value];
                    @if (!enemy.IsDefeated)
                    {
                        <button class="btn btn-primary" @onclick="() => DoAttack(SelectedEnemyIndex.Value)"
                                disabled="@(AttackPool < enemy.Armor)">
                            Attack @enemy.Name (@enemy.Armor needed)
                        </button>
                    }
                }
                <button class="btn btn-secondary" @onclick="EndPhase">End Attack Phase</button>
                break;

            case CombatPhase.Resolution:
                <div class="phase-info">
                    <p>Combat resolved. Collect your rewards!</p>
                </div>
                <button class="btn btn-success" @onclick="EndPhase">End Combat</button>
                break;
        }

        <button class="btn btn-outline-danger" @onclick="Flee">
            🏃 Flee (Take @GetFleeDamage() wounds)
        </button>
    </div>
</div>

<style>
    .combat-panel {
        background: linear-gradient(135deg, #2d1f1f 0%, #1a1a1a 100%);
        border: 2px solid #8b0000;
        border-radius: var(--radius-lg);
        padding: var(--spacing-lg);
        box-shadow: 0 0 20px rgba(139, 0, 0, 0.3);
        max-height: 80vh;
        overflow-y: auto;
    }

    .combat-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: var(--spacing-lg);
        padding-bottom: var(--spacing-md);
        border-bottom: 1px solid #8b0000;
    }

    .combat-header h3 {
        margin: 0;
        color: #ff4444;
        font-family: 'Cinzel', serif;
    }

    .combat-phase {
        background: #8b0000;
        color: white;
        padding: 4px 12px;
        border-radius: var(--radius-md);
        font-size: 0.85rem;
        font-weight: bold;
    }

    .combat-phase.swift { background: #ff8800; }
    .combat-phase.ranged { background: #4488ff; }
    .combat-phase.block { background: #44aa44; }
    .combat-phase.damage { background: #ff4444; }
    .combat-phase.attack { background: #cc4444; }
    .combat-phase.resolution { background: #44aa44; }

    .enemies-section h4, .units-section h4 {
        color: var(--color-text-secondary);
        font-size: 0.9rem;
        margin-bottom: var(--spacing-sm);
    }

    .enemy-list, .unit-list {
        display: flex;
        flex-wrap: wrap;
        gap: var(--spacing-md);
        margin-bottom: var(--spacing-lg);
    }

    .enemy-card, .unit-card {
        background: var(--color-bg-dark);
        border: 2px solid var(--color-border);
        border-radius: var(--radius-md);
        padding: var(--spacing-md);
        min-width: 140px;
        cursor: pointer;
        transition: all 0.2s ease;
        position: relative;
    }

    .enemy-card:hover, .unit-card:hover {
        border-color: #ff4444;
        transform: translateY(-2px);
    }

    .enemy-card.selected, .unit-card.selected {
        border-color: var(--color-gold);
        box-shadow: 0 0 10px rgba(212, 168, 83, 0.3);
    }

    .enemy-card.defeated {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .enemy-card.swift-active {
        border-color: #ff8800;
        animation: swift-pulse 1s ease-in-out infinite;
    }

    .enemy-card.not-targetable {
        opacity: 0.6;
    }

    @@keyframes swift-pulse {
        0%, 100% { box-shadow: 0 0 5px rgba(255, 136, 0, 0.5); }
        50% { box-shadow: 0 0 15px rgba(255, 136, 0, 0.8); }
    }

    .enemy-name, .unit-name {
        font-family: 'Cinzel', serif;
        color: #ff6666;
        font-size: 0.9rem;
        margin-bottom: var(--spacing-xs);
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .unit-name { color: #66aaff; }

    .swift-icon { color: #ff8800; }
    .wound-icon { color: #ff4444; }
    .exhausted-icon { color: #888; }

    .enemy-stats {
        display: flex;
        gap: var(--spacing-sm);
        font-size: 0.85rem;
    }

    .stat {
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .stat.attack { color: #ff4444; }
    .stat.armor { color: #4488ff; }

    .element-badge {
        font-size: 0.7rem;
        padding: 1px 4px;
        border-radius: 3px;
    }
    .element-badge.fire { background: #ff4400; color: white; }
    .element-badge.ice { background: #00aaff; color: white; }
    .element-badge.cold { background: #88ccff; color: #333; }

    .enemy-abilities, .unit-abilities {
        margin-top: var(--spacing-xs);
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
    }

    .ability-badge {
        background: #333;
        color: #ffcc00;
        padding: 2px 6px;
        border-radius: var(--radius-sm);
        font-size: 0.7rem;
    }

    .ability-badge.swift { background: #ff8800; color: white; }
    .ability-badge.fortified { background: #666; color: white; }
    .ability-badge.brutal { background: #aa0000; color: white; }
    .ability-badge.poison { background: #00aa00; color: white; }
    .ability-badge.paralyze { background: #aa00aa; color: white; }

    .enemy-resistances {
        margin-top: var(--spacing-xs);
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
    }

    .resistance-badge {
        background: #224;
        color: #88f;
        padding: 2px 6px;
        border-radius: var(--radius-sm);
        font-size: 0.65rem;
    }

    .unit-ability-badge {
        background: #234;
        color: #8af;
        padding: 2px 6px;
        border-radius: var(--radius-sm);
        font-size: 0.7rem;
    }

    .unit-ability-badge.unavailable {
        opacity: 0.5;
        text-decoration: line-through;
    }

    .unit-card.wounded {
        border-color: #ff4444;
        background: linear-gradient(135deg, #2d1f1f 0%, #1a1a1a 100%);
    }

    .unit-card.exhausted {
        opacity: 0.6;
    }

    .unit-card.used {
        border-style: dashed;
    }

    .defeated-overlay, .blocked-overlay {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        background: rgba(0, 100, 0, 0.8);
        color: white;
        padding: 4px 12px;
        border-radius: var(--radius-md);
        font-weight: bold;
    }

    .blocked-overlay {
        background: rgba(0, 100, 150, 0.8);
    }

    .phase-info {
        background: rgba(0, 0, 0, 0.3);
        padding: var(--spacing-md);
        border-radius: var(--radius-md);
        margin-bottom: var(--spacing-md);
    }

    .phase-info.swift-warning {
        background: rgba(255, 136, 0, 0.2);
        border: 1px solid #ff8800;
    }

    .phase-info.damage-warning {
        background: rgba(255, 68, 68, 0.2);
        border: 1px solid #ff4444;
    }

    .phase-info p {
        margin: 0 0 var(--spacing-xs) 0;
        font-size: 0.9rem;
    }

    .phase-info .value {
        color: var(--color-gold);
        font-weight: bold;
    }

    .phase-info .value.damage {
        color: #ff4444;
    }

    .hint {
        font-size: 0.8rem;
        color: #888;
        font-style: italic;
        margin-bottom: var(--spacing-sm);
    }

    .combat-actions, .unit-actions {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-sm);
    }

    .combat-actions .btn, .unit-actions .btn {
        width: 100%;
    }

    .unit-actions {
        margin-top: var(--spacing-sm);
        padding-top: var(--spacing-sm);
        border-top: 1px solid #333;
    }

    .btn-unit {
        background: #234;
        border: 1px solid #48f;
        color: #8af;
    }

    .btn-unit:hover {
        background: #345;
    }

    .btn-outline-danger {
        background: transparent;
        border: 1px solid #ff4444;
        color: #ff4444;
    }

    .btn-outline-danger:hover {
        background: rgba(255, 68, 68, 0.1);
    }

    .btn-success {
        background: #228822;
        border-color: #44aa44;
    }

    .btn-warning {
        background: #886600;
        border-color: #aa8800;
    }

    .siege-required {
        margin-left: 4px;
    }
</style>

@code {
    [Parameter] public CombatState Combat { get; set; } = new();
    [Parameter] public int RangedAttack { get; set; }
    [Parameter] public int SiegeAttack { get; set; }
    [Parameter] public int AttackPool { get; set; }
    [Parameter] public int BlockPool { get; set; }
    [Parameter] public List<UnitCombatOption> Units { get; set; } = new();
    
    [Parameter] public EventCallback<(int EnemyIndex, int Value)> OnRangedAttack { get; set; }
    [Parameter] public EventCallback<(int EnemyIndex, int Value)> OnBlock { get; set; }
    [Parameter] public EventCallback<(int EnemyIndex, int Value)> OnAttack { get; set; }
    [Parameter] public EventCallback<int> OnAssignDamage { get; set; }
    [Parameter] public EventCallback<int> OnAssignDamageToUnit { get; set; }
    [Parameter] public EventCallback<(int UnitIndex, string AbilityType, int? EnemyIndex)> OnUnitAbility { get; set; }
    [Parameter] public EventCallback OnEndPhase { get; set; }
    [Parameter] public EventCallback OnFlee { get; set; }

    private int? SelectedEnemyIndex { get; set; }
    private int? SelectedUnitIndex { get; set; }

    private string GetPhaseText() => Combat.Phase switch
    {
        CombatPhase.SwiftAttack => "⚡ Swift Attack",
        CombatPhase.RangedAttack => "🏹 Ranged Attack",
        CombatPhase.Block => "🛡️ Block",
        CombatPhase.AssignDamage => "💔 Assign Damage",
        CombatPhase.Attack => "⚔️ Melee Attack",
        CombatPhase.Resolution => "✓ Resolution",
        _ => "Combat"
    };

    private string GetPhaseClass() => Combat.Phase switch
    {
        CombatPhase.SwiftAttack => "swift",
        CombatPhase.RangedAttack => "ranged",
        CombatPhase.Block => "block",
        CombatPhase.AssignDamage => "damage",
        CombatPhase.Attack => "attack",
        CombatPhase.Resolution => "resolution",
        _ => ""
    };

    private string GetElementIcon(string element) => element switch
    {
        "Fire" => "🔥",
        "Ice" => "❄️",
        "Cold" => "🧊",
        _ => ""
    };

    private string GetAbilityIcon(string ability) => ability switch
    {
        "Swift" => "⚡",
        "Fortified" => "🏰",
        "Brutal" => "💀",
        "Poison" => "☠️",
        "Paralyze" => "⚡",
        _ when ability.Contains("Summon") => "👻",
        _ => ""
    };

    private string GetAbilityClass(string ability) => ability.ToLower() switch
    {
        "swift" => "swift",
        "fortified" => "fortified",
        "brutal" => "brutal",
        "poison" => "poison",
        "paralyze" => "paralyze",
        _ => ""
    };

    private string GetAbilityDescription(string ability) => ability switch
    {
        "Swift" => "Attacks before block phase",
        "Fortified" => "Requires Siege attack for ranged",
        "Brutal" => "Double damage if unblocked",
        "Poison" => "Wounds go to discard pile",
        "Paralyze" => "Ineffective attacks cause wounds",
        _ when ability.Contains("Summon") => "Can summon additional enemies",
        _ => ability
    };

    private string GetAbilityButtonClass(string abilityType) => abilityType switch
    {
        "Attack" or "Ranged" => "btn-danger",
        "Block" => "btn-primary",
        "Heal" => "btn-success",
        _ => "btn-secondary"
    };

    private bool IsEnemyTargetable(CombatEnemy enemy)
    {
        if (enemy.IsDefeated) return false;
        
        // In swift phase, only swift enemies can be blocked
        if (Combat.Phase == CombatPhase.SwiftAttack)
            return enemy.IsSwift && !enemy.IsBlocked;
        
        // In block phase, can't target swift enemies (already handled)
        if (Combat.Phase == CombatPhase.Block)
            return !enemy.IsSwift && !enemy.IsBlocked;
        
        return true;
    }

    private bool CanUseAbility(UnitCombatOption unit, UnitAbilityOption ability)
    {
        if (!unit.IsReady || unit.UsedThisCombat) return false;
        
        // Check phase compatibility
        return ability.AbilityType switch
        {
            "Attack" => Combat.Phase == CombatPhase.Attack,
            "Ranged" => Combat.Phase == CombatPhase.RangedAttack,
            "Block" => Combat.Phase == CombatPhase.Block || Combat.Phase == CombatPhase.SwiftAttack,
            "Influence" => true,
            "Move" => Combat == null,
            "Heal" => true,
            _ => true
        };
    }

    private int GetSwiftDamage()
    {
        return Combat.Enemies
            .Where(e => !e.IsDefeated && e.IsSwift && !e.IsBlocked)
            .Sum(e => e.Attack);
    }

    private int GetIncomingDamage()
    {
        return Combat.Enemies
            .Where(e => !e.IsDefeated && !e.IsSwift && !e.IsBlocked)
            .Sum(e => e.Attack);
    }

    private int GetFleeDamage()
    {
        var baseDamage = Combat.Enemies.Where(e => !e.IsDefeated).Sum(e => e.Attack);
        var brutalDamage = Combat.Enemies.Where(e => !e.IsDefeated && e.IsBrutal).Sum(e => e.Attack);
        return baseDamage + brutalDamage;
    }

    private void SelectEnemy(int index)
    {
        if (Combat.Enemies[index].IsDefeated) return;
        SelectedEnemyIndex = SelectedEnemyIndex == index ? null : index;
        SelectedUnitIndex = null; // Deselect unit when selecting enemy
    }

    private void SelectUnit(int index)
    {
        SelectedUnitIndex = SelectedUnitIndex == index ? null : index;
    }

    private async Task DoRangedAttack(int enemyIndex)
    {
        var enemy = Combat.Enemies[enemyIndex];
        var requiredAttack = enemy.Armor;
        if (OnRangedAttack.HasDelegate)
            await OnRangedAttack.InvokeAsync((enemyIndex, requiredAttack));
    }

    private async Task DoBlock(int enemyIndex)
    {
        var enemy = Combat.Enemies[enemyIndex];
        if (OnBlock.HasDelegate)
            await OnBlock.InvokeAsync((enemyIndex, enemy.Attack));
    }

    private async Task DoAttack(int enemyIndex)
    {
        var enemy = Combat.Enemies[enemyIndex];
        if (OnAttack.HasDelegate)
            await OnAttack.InvokeAsync((enemyIndex, enemy.Armor));
    }

    private async Task TakeDamage(int damage)
    {
        if (OnAssignDamage.HasDelegate)
            await OnAssignDamage.InvokeAsync(damage);
    }

    private async Task AssignDamageToUnit(int unitIndex)
    {
        if (OnAssignDamageToUnit.HasDelegate)
            await OnAssignDamageToUnit.InvokeAsync(unitIndex);
    }

    private async Task UseUnitAbility(int unitIndex, string abilityType)
    {
        if (OnUnitAbility.HasDelegate)
            await OnUnitAbility.InvokeAsync((unitIndex, abilityType, SelectedEnemyIndex));
    }

    private async Task EndPhase()
    {
        SelectedEnemyIndex = null;
        SelectedUnitIndex = null;
        if (OnEndPhase.HasDelegate)
            await OnEndPhase.InvokeAsync();
    }

    private async Task Flee()
    {
        if (OnFlee.HasDelegate)
            await OnFlee.InvokeAsync();
    }
}
