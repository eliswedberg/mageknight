@namespace MageKnightOnline.Web.Components.Game
@inject IJSRuntime JSRuntime

<div class="card-hand @(IsExpanded ? "expanded" : "")">
    <div class="hand-header" @onclick="ToggleExpand">
        <h4>Your Hand (@Cards.Count cards)</h4>
        <span class="expand-icon">@(IsExpanded ? "▼" : "▲")</span>
    </div>
    
    <div class="hand-cards">
        @foreach (var (card, index) in Cards.Select((c, i) => (c, i)))
        {
            var isSelected = SelectedCardIndex == index;
            var offset = CalculateCardOffset(index, Cards.Count);
            var isDragging = _draggedCardIndex == index;
            
            <div class="hand-card @(isSelected ? "selected" : "") @(card.CanPlay ? "" : "disabled") @GetCardTypeClass(card) @(isDragging ? "dragging" : "")"
                 style="--card-index: @index; --card-offset: @offset; z-index: @(isSelected ? 100 : (isDragging ? 150 : index));"
                 draggable="@(card.CanPlay.ToString().ToLower())"
                 @ondragstart="() => OnDragStart(index, card)"
                 @ondragend="OnDragEnd"
                 @onclick="() => OnCardClick(index)"
                 @onclick:stopPropagation="true">
                
                <!-- Tooltip -->
                <div class="card-tooltip">
                    <div class="tooltip-header">
                        <span class="tooltip-name">@card.Name</span>
                        <span class="tooltip-type @GetCardTypeClass(card)">@card.Type</span>
                    </div>
                    <div class="tooltip-body">
                        <div class="tooltip-effect">
                            <span class="effect-icon">📜</span>
                            <span>Basic: @card.BasicEffect</span>
                        </div>
                        @if (!string.IsNullOrEmpty(card.PoweredEffect))
                        {
                            <div class="tooltip-effect powered">
                                <span class="effect-icon">⚡</span>
                                <span>Powered (@card.PoweredManaColor): @card.PoweredEffect</span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(card.Note))
                        {
                            <div class="tooltip-note">
                                <span class="note-icon">💡</span>
                                <span>@card.Note</span>
                            </div>
                        }
                    </div>
                </div>
                
                @if (!string.IsNullOrEmpty(card.ImageUrl))
                {
                    <img src="@card.ImageUrl" alt="@card.Name" class="card-image" />
                }
                else
                {
                    <div class="card-placeholder">
                        <div class="card-name">@card.Name</div>
                        <div class="card-type">@card.Type</div>
                        <div class="card-value">@card.BasicEffect</div>
                    </div>
                }

                @if (isSelected)
                {
                    <div class="card-actions">
                        <button class="btn btn-sm btn-primary" @onclick="() => PlayCard(index)" @onclick:stopPropagation="true"
                                disabled="@(!card.CanPlay)">
                            Play
                        </button>
                        @if (!string.IsNullOrEmpty(card.PoweredEffect) || !string.IsNullOrEmpty(card.PoweredManaColor))
                        {
                            var canPlayThisCardPowered = CanPlayPoweredForCard?.Invoke(card) ?? CanPlayPowered;
                            var manaRequirement = !string.IsNullOrEmpty(card.PoweredManaColor) ? card.PoweredManaColor : "mana";
                            <button class="btn btn-sm btn-powered @(canPlayThisCardPowered ? "" : "disabled")" 
                                    @onclick="() => PlayCardPowered(index)" @onclick:stopPropagation="true"
                                    disabled="@(!canPlayThisCardPowered)"
                                    title="@(canPlayThisCardPowered ? $"Play powered effect (requires {manaRequirement} mana)" : $"Requires {manaRequirement} mana from Source - take a mana die first")">
                                ⚡ Powered
                            </button>
                        }
                        <button class="btn btn-sm btn-secondary" @onclick="() => UseAsSidewaysCard(index)" @onclick:stopPropagation="true"
                                title="Use sideways for +1 @card.Type">
                            +1
                        </button>
                    </div>
                }
            </div>
        }
    </div>

    @if (SelectedCardIndex.HasValue && SelectedCardIndex.Value < Cards.Count)
    {
        var selectedCard = Cards[SelectedCardIndex.Value];
        <div class="card-details">
            <h5>@selectedCard.Name</h5>
            <div class="card-effects">
                <div class="effect-section">
                    <span class="effect-label">Basic:</span>
                    <span class="effect-value">@selectedCard.BasicEffect</span>
                </div>
                @if (!string.IsNullOrEmpty(selectedCard.PoweredEffect))
                {
                    <div class="effect-section powered">
                        <span class="effect-label">Powered (@selectedCard.PoweredManaColor):</span>
                        <span class="effect-value">@selectedCard.PoweredEffect</span>
                    </div>
                }
            </div>
        </div>
    }
</div>

<style>
    .card-hand {
        background: var(--color-bg-card);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        padding: var(--spacing-md);
        transition: all 0.3s ease;
    }

    .card-hand.expanded {
        padding-bottom: var(--spacing-xl);
    }

    .hand-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        cursor: pointer;
        margin-bottom: var(--spacing-md);
    }

    .hand-header h4 {
        margin: 0;
        font-size: 1rem;
    }

    .expand-icon {
        color: var(--color-gold);
        font-size: 0.8rem;
    }

    .hand-cards {
        display: flex;
        justify-content: center;
        position: relative;
        height: 180px;
        perspective: 1000px;
        padding: 20px 0 60px 0; /* Extra padding top for tooltip, bottom for actions */
        overflow: visible; /* Allow tooltips to show outside */
        min-height: 250px; /* Ensure enough space for hover effects */
    }

    .card-hand.expanded .hand-cards {
        height: 240px;
        min-height: 320px;
    }

    .hand-card {
        position: absolute;
        width: 100px;
        height: 140px;
        background: var(--color-bg-dark);
        border: 2px solid var(--color-border);
        border-radius: var(--radius-md);
        cursor: pointer;
        transition: all 0.2s ease;
        transform-origin: bottom center;
        transform: translateX(calc(var(--card-offset) * 1px)) rotate(calc((var(--card-index) - 2) * 2deg));
    }

    .card-hand.expanded .hand-card {
        width: 130px;
        height: 182px;
    }

    .hand-card:hover {
        transform: translateX(calc(var(--card-offset) * 1px)) translateY(-30px) rotate(0deg) scale(1.15);
        z-index: 50 !important;
        border-color: var(--color-gold);
    }

    .hand-card.selected {
        transform: translateX(calc(var(--card-offset) * 1px)) translateY(-40px) rotate(0deg) scale(1.15);
        border-color: var(--color-gold);
        box-shadow: var(--shadow-glow);
    }

    .hand-card.disabled {
        opacity: 0.5;
    }

    .hand-card.dragging {
        opacity: 0.7;
        transform: scale(1.05) rotate(5deg) !important;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
        cursor: grabbing;
    }

    .hand-card[draggable="true"] {
        cursor: grab;
    }

    .hand-card[draggable="true"]:active {
        cursor: grabbing;
    }

    .card-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: calc(var(--radius-md) - 2px);
    }

    .card-placeholder {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: var(--spacing-sm);
        text-align: center;
    }

    .card-name {
        font-family: 'Cinzel', serif;
        font-size: 0.7rem;
        color: var(--color-gold);
        margin-bottom: var(--spacing-xs);
    }

    .card-type {
        font-size: 0.6rem;
        color: var(--color-text-muted);
    }

    .card-actions {
        position: absolute;
        bottom: -45px;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        gap: var(--spacing-xs);
        white-space: nowrap;
    }

    .card-details {
        margin-top: var(--spacing-lg);
        padding-top: var(--spacing-md);
        border-top: 1px solid var(--color-border);
    }

    .card-details h5 {
        margin: 0 0 var(--spacing-sm) 0;
        color: var(--color-gold);
    }

    .card-effects {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-xs);
    }

    .effect-section {
        display: flex;
        gap: var(--spacing-sm);
        font-size: 0.85rem;
    }

    .effect-label {
        color: var(--color-text-muted);
        min-width: 80px;
    }

    .effect-value {
        color: var(--color-text-primary);
    }

    .effect-section.powered .effect-label {
        color: var(--color-gold);
    }

    .btn-powered {
        background: linear-gradient(135deg, #f59e0b, #d97706);
        border-color: #f59e0b;
        color: white;
    }

    .btn-powered:hover:not(:disabled) {
        background: linear-gradient(135deg, #d97706, #b45309);
        border-color: #d97706;
    }

    .btn-powered.disabled,
    .btn-powered:disabled {
        opacity: 0.6;
        cursor: not-allowed;
        background: linear-gradient(135deg, #6b7280, #4b5563);
        border-color: #6b7280;
    }

    .btn-powered.disabled:hover,
    .btn-powered:disabled:hover {
        background: linear-gradient(135deg, #6b7280, #4b5563);
        border-color: #6b7280;
    }

    /* Card Type Classes */
    .hand-card.move {
        border-color: #22c55e;
    }

    .hand-card.attack {
        border-color: #ef4444;
    }

    .hand-card.block {
        border-color: #3b82f6;
    }

    .hand-card.influence {
        border-color: #a855f7;
    }

    .hand-card.heal {
        border-color: #f472b6;
    }

    .hand-card.wound {
        border-color: #6b7280;
        background: #2a1a1a;
    }

    /* Tooltip Styles */
    .card-tooltip {
        position: absolute;
        bottom: calc(100% + 15px);
        left: 50%;
        transform: translateX(-50%);
        width: 280px;
        max-width: 90vw; /* Don't exceed viewport */
        background: linear-gradient(135deg, #1e1e2e 0%, #2a2a3a 100%);
        border: 2px solid var(--color-gold);
        border-radius: 8px;
        padding: 12px;
        opacity: 0;
        visibility: hidden;
        transition: all 0.2s ease;
        z-index: 1000; /* High z-index to show above map */
        pointer-events: none;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
        white-space: normal;
        word-wrap: break-word;
    }

    /* Tooltip always shows above card (since cards are at bottom) */
    .hand-card:hover .card-tooltip {
        opacity: 1;
        visibility: visible;
    }

    .hand-card.selected .card-tooltip {
        opacity: 0;
        visibility: hidden;
    }

    .tooltip-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 10px;
        padding-bottom: 8px;
        border-bottom: 1px solid rgba(212, 168, 83, 0.3);
    }

    .tooltip-name {
        font-family: 'Cinzel', serif;
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--color-gold);
    }

    .tooltip-type {
        font-size: 0.7rem;
        padding: 2px 8px;
        border-radius: 4px;
        text-transform: uppercase;
        font-weight: 600;
    }

    .tooltip-type.move {
        background: rgba(34, 197, 94, 0.2);
        color: #22c55e;
    }

    .tooltip-type.attack {
        background: rgba(239, 68, 68, 0.2);
        color: #ef4444;
    }

    .tooltip-type.block {
        background: rgba(59, 130, 246, 0.2);
        color: #3b82f6;
    }

    .tooltip-type.influence {
        background: rgba(168, 85, 247, 0.2);
        color: #a855f7;
    }

    .tooltip-type.heal {
        background: rgba(244, 114, 182, 0.2);
        color: #f472b6;
    }

    .tooltip-body {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .tooltip-effect {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        font-size: 0.8rem;
        color: #b0b0b0;
    }

    .tooltip-effect.powered {
        color: #f59e0b;
    }

    .effect-icon {
        flex-shrink: 0;
    }

    .tooltip-note {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        font-size: 0.75rem;
        color: #888;
        font-style: italic;
        margin-top: 4px;
        padding-top: 8px;
        border-top: 1px dashed rgba(255, 255, 255, 0.1);
    }

    .note-icon {
        flex-shrink: 0;
    }

    .card-value {
        font-size: 0.55rem;
        color: var(--color-text-muted);
        margin-top: var(--spacing-xs);
    }
</style>

@code {
    [Parameter] public List<CardData> Cards { get; set; } = new();
    [Parameter] public int? SelectedCardIndex { get; set; }
    [Parameter] public bool CanPlayPowered { get; set; } = false;
    [Parameter] public Func<CardData, bool>? CanPlayPoweredForCard { get; set; }
    [Parameter] public EventCallback<int> OnCardSelected { get; set; }
    [Parameter] public EventCallback<int> OnCardPlayed { get; set; }
    [Parameter] public EventCallback<int> OnCardPlayedPowered { get; set; }
    [Parameter] public EventCallback<int> OnCardUsedSideways { get; set; }
    [Parameter] public EventCallback<CardDragData> OnCardDragStarted { get; set; }
    [Parameter] public EventCallback OnCardDragEnded { get; set; }

    private bool IsExpanded { get; set; } = true;
    private int? _draggedCardIndex = null;

    private void ToggleExpand()
    {
        IsExpanded = !IsExpanded;
    }

    private int CalculateCardOffset(int index, int total)
    {
        if (total <= 1) return 0;
        // Increase spread for more cards to prevent overlap
        var maxSpread = Math.Min(total * 60, 500); // Wider spread for more cards
        var step = maxSpread / Math.Max(total - 1, 1);
        return (int)(index * step - maxSpread / 2);
    }

    private async Task OnCardClick(int index)
    {
        if (OnCardSelected.HasDelegate)
        {
            await OnCardSelected.InvokeAsync(index);
        }
    }

    private async Task PlayCard(int index)
    {
        if (OnCardPlayed.HasDelegate)
        {
            await OnCardPlayed.InvokeAsync(index);
        }
    }

    private async Task PlayCardPowered(int index)
    {
        if (OnCardPlayedPowered.HasDelegate)
        {
            await OnCardPlayedPowered.InvokeAsync(index);
        }
    }

    private async Task UseAsSidewaysCard(int index)
    {
        if (OnCardUsedSideways.HasDelegate)
        {
            await OnCardUsedSideways.InvokeAsync(index);
        }
    }

    private async Task OnDragStart(int index, CardData card)
    {
        _draggedCardIndex = index;
        if (OnCardDragStarted.HasDelegate)
        {
            await OnCardDragStarted.InvokeAsync(new CardDragData
            {
                CardIndex = index,
                CardId = card.Id,
                CardName = card.Name,
                CardType = card.Type
            });
        }
    }

    private async Task OnDragEnd()
    {
        _draggedCardIndex = null;
        if (OnCardDragEnded.HasDelegate)
        {
            await OnCardDragEnded.InvokeAsync();
        }
    }

    /// <summary>
    /// Gets the currently dragged card index, if any.
    /// </summary>
    public int? GetDraggedCardIndex() => _draggedCardIndex;
}

@code {
    public class CardData
    {
        public string Id { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string Type { get; set; } = string.Empty;
        public string? ImageUrl { get; set; }
        public string BasicEffect { get; set; } = string.Empty;
        public string? PoweredEffect { get; set; }
        public string? PoweredManaColor { get; set; }
        public string? Note { get; set; }
        public bool CanPlay { get; set; } = true;
    }

    public class CardDragData
    {
        public int CardIndex { get; set; }
        public string CardId { get; set; } = string.Empty;
        public string CardName { get; set; } = string.Empty;
        public string CardType { get; set; } = string.Empty;
    }
    
    private string GetCardTypeClass(CardData card)
    {
        return card.Type?.ToLower() switch
        {
            "move" => "move",
            "attack" => "attack",
            "block" => "block",
            "influence" => "influence",
            "heal" => "heal",
            "wound" => "wound",
            _ => ""
        };
    }
}
