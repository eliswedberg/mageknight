@namespace MageKnightOnline.Web.Components.Game
@using System.Globalization

<div class="hex-grid-container" style="width: @(Width)px; height: @(Height)px;">
    <svg class="hex-grid" viewBox="@ViewBox" preserveAspectRatio="xMidYMid meet">
        <defs>
            <!-- Hex clip path for images -->
            <clipPath id="hexClip">
                <polygon points="@HexPoints" />
            </clipPath>
            
            <!-- Terrain gradients -->
            <linearGradient id="fogGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" style="stop-color:#1a1a24;stop-opacity:1" />
                <stop offset="100%" style="stop-color:#0d0d12;stop-opacity:1" />
            </linearGradient>
            
            <linearGradient id="plainsGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" style="stop-color:#4a7c3f;stop-opacity:1" />
                <stop offset="100%" style="stop-color:#3d6634;stop-opacity:1" />
            </linearGradient>
            
            <linearGradient id="forestGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" style="stop-color:#1e4d2b;stop-opacity:1" />
                <stop offset="100%" style="stop-color:#0f3318;stop-opacity:1" />
            </linearGradient>
            
            <linearGradient id="hillsGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" style="stop-color:#8b7355;stop-opacity:1" />
                <stop offset="100%" style="stop-color:#6b5344;stop-opacity:1" />
            </linearGradient>
            
            <linearGradient id="swampGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" style="stop-color:#3d4a3a;stop-opacity:1" />
                <stop offset="100%" style="stop-color:#2a352a;stop-opacity:1" />
            </linearGradient>
            
            <linearGradient id="wastelandGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" style="stop-color:#6b5b4f;stop-opacity:1" />
                <stop offset="100%" style="stop-color:#4a3f37;stop-opacity:1" />
            </linearGradient>
            
            <linearGradient id="desertGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" style="stop-color:#c9a86c;stop-opacity:1" />
                <stop offset="100%" style="stop-color:#a88b56;stop-opacity:1" />
            </linearGradient>
            
            <linearGradient id="waterGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" style="stop-color:#2563eb;stop-opacity:1" />
                <stop offset="100%" style="stop-color:#1d4ed8;stop-opacity:1" />
            </linearGradient>
            
            <linearGradient id="mountainGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" style="stop-color:#6b7280;stop-opacity:1" />
                <stop offset="100%" style="stop-color:#4b5563;stop-opacity:1" />
            </linearGradient>

            <!-- Terrain patterns -->
            <pattern id="forestPattern" patternUnits="userSpaceOnUse" width="20" height="20">
                <rect width="20" height="20" fill="url(#forestGradient)"/>
                <circle cx="5" cy="5" r="3" fill="#0a2010" opacity="0.5"/>
                <circle cx="15" cy="12" r="4" fill="#0a2010" opacity="0.5"/>
                <circle cx="8" cy="16" r="2" fill="#0a2010" opacity="0.5"/>
            </pattern>
            
            <pattern id="hillsPattern" patternUnits="userSpaceOnUse" width="30" height="20">
                <rect width="30" height="20" fill="url(#hillsGradient)"/>
                <path d="M0,20 Q7,10 15,20 Q22,10 30,20" fill="none" stroke="#5a4335" stroke-width="2"/>
                <path d="M5,20 Q12,12 20,20" fill="none" stroke="#7a6355" stroke-width="1"/>
            </pattern>
            
            <pattern id="swampPattern" patternUnits="userSpaceOnUse" width="20" height="20">
                <rect width="20" height="20" fill="url(#swampGradient)"/>
                <circle cx="5" cy="10" r="2" fill="#1a2a1a" opacity="0.6"/>
                <circle cx="15" cy="5" r="3" fill="#2a4a3a" opacity="0.4"/>
                <path d="M8,15 Q10,12 12,15" fill="none" stroke="#4a5a4a" stroke-width="1"/>
            </pattern>
            
            <pattern id="waterPattern" patternUnits="userSpaceOnUse" width="40" height="20">
                <rect width="40" height="20" fill="url(#waterGradient)"/>
                <path d="M0,10 Q10,5 20,10 Q30,15 40,10" fill="none" stroke="#60a5fa" stroke-width="1" opacity="0.5"/>
                <path d="M0,15 Q10,10 20,15 Q30,20 40,15" fill="none" stroke="#93c5fd" stroke-width="1" opacity="0.3"/>
            </pattern>
            
            <pattern id="mountainPattern" patternUnits="userSpaceOnUse" width="30" height="30">
                <rect width="30" height="30" fill="url(#mountainGradient)"/>
                <path d="M5,30 L15,10 L25,30" fill="#4b5563" stroke="#374151" stroke-width="1"/>
                <path d="M10,30 L15,20 L20,30" fill="#6b7280"/>
                <path d="M12,15 L15,10 L18,15" fill="white" opacity="0.3"/>
            </pattern>
        </defs>

        @foreach (var hex in Hexes)
        {
            var center = HexToPixel(hex.Q, hex.R);
            var isSelected = SelectedHex?.Q == hex.Q && SelectedHex?.R == hex.R;
            var isHighlighted = HighlightedHexes?.Any(h => h.Q == hex.Q && h.R == hex.R) ?? false;

            <g class="hex-cell @(hex.IsRevealed ? "revealed" : "hidden") @(isSelected ? "selected" : "") @(isHighlighted ? "highlighted" : "")"
               transform="translate(@F(center.X), @F(center.Y))"
               @onclick="() => OnHexClick(hex)"
               @onmouseenter="() => OnHexHover(hex)"
               style="cursor: pointer;">
                
                @if (hex.IsRevealed)
                {
                    <!-- Terrain fill based on type -->
                    <polygon points="@HexPoints" fill="@GetTerrainFill(hex.TerrainType)" />
                    
                    <!-- Terrain texture overlay -->
                    @if (HasTerrainPattern(hex.TerrainType))
                    {
                        <polygon points="@HexPoints" fill="@GetTerrainPattern(hex.TerrainType)" opacity="0.7" />
                    }
                }
                else
                {
                    <!-- Unexplored hex -->
                    <polygon points="@HexPoints" fill="url(#fogGradient)" />
                }

                <!-- Hex border -->
                <polygon points="@HexPoints" 
                         fill="none" 
                         stroke="@(isSelected ? "#d4a853" : isHighlighted ? "#4ade80" : hex.IsRevealed ? "#1f2937" : "#3f3f46")" 
                         stroke-width="@(isSelected ? 3 : isHighlighted ? 2 : 1)" />

                @if (hex.IsRevealed)
                {
                    <!-- Terrain label -->
                    @if (!string.IsNullOrEmpty(hex.TerrainType) && string.IsNullOrEmpty(hex.SiteType))
                    {
                        @((MarkupString)$"<text x=\"0\" y=\"{F(HexSize * 0.6)}\" text-anchor=\"middle\" fill=\"rgba(255,255,255,0.4)\" font-size=\"8\" font-weight=\"bold\">{GetTerrainLabel(hex.TerrainType)}</text>")
                    }

                    <!-- Site markers -->
                    @if (!string.IsNullOrEmpty(hex.SiteType))
                    {
                        <circle cx="0" cy="0" r="@F(HexSize * 0.35)" 
                                fill="#1a1a2e" stroke="#d4a853" stroke-width="2" />
                        @((MarkupString)$"<text x=\"0\" y=\"6\" text-anchor=\"middle\" fill=\"#fbbf24\" font-size=\"16\">{GetSiteIcon(hex.SiteType)}</text>")
                        @((MarkupString)$"<text x=\"0\" y=\"{F(HexSize * 0.6)}\" text-anchor=\"middle\" fill=\"#d4a853\" font-size=\"7\" font-weight=\"bold\">{hex.SiteType?.ToUpper()}</text>")
                    }

                    <!-- Player tokens -->
                    @foreach (var (token, index) in hex.PlayerTokens.Select((t, i) => (t, i)))
                    {
                        var offsetX = (index - hex.PlayerTokens.Count / 2.0) * 25;
                        var offsetY = -HexSize * 0.4;
                        
                        <circle cx="@F(offsetX)" cy="@F(offsetY)" r="14" fill="#1e1e2e" stroke="#d4a853" stroke-width="2"/>
                        @if (!string.IsNullOrEmpty(token.TokenImage))
                        {
                            <image href="@token.TokenImage" 
                                   x="@F(offsetX - 12)" y="@F(offsetY - 12)" 
                                   width="24" height="24" 
                                   clip-path="url(#hexClip)" />
                        }
                        else
                        {
                            @((MarkupString)$"<text x=\"{F(offsetX)}\" y=\"{F(offsetY + 4)}\" text-anchor=\"middle\" fill=\"#d4a853\" font-size=\"10\">🧙</text>")
                        }
                    }

                    <!-- Enemy indicators -->
                    @if (hex.EnemyCount > 0)
                    {
                        <circle cx="@F(HexSize * 0.45)" cy="@F(-HexSize * 0.35)" r="12" 
                                fill="#dc2626" stroke="#fef2f2" stroke-width="2" />
                        @((MarkupString)$"<text x=\"{F(HexSize * 0.45)}\" y=\"{F(-HexSize * 0.35 + 4)}\" text-anchor=\"middle\" fill=\"white\" font-size=\"11\" font-weight=\"bold\">{hex.EnemyCount}</text>")
                    }
                }

                <!-- Coordinate labels (debug) -->
                @if (ShowCoordinates && hex.IsRevealed)
                {
                    @((MarkupString)$"<text x=\"0\" y=\"{F(-HexSize * 0.55)}\" text-anchor=\"middle\" fill=\"rgba(255,255,255,0.5)\" font-size=\"9\">{hex.Q},{hex.R}</text>")
                }
            </g>
        }
    </svg>
</div>

<style>
    .hex-grid-container {
        overflow: auto;
        background: var(--color-bg-dark);
        border-radius: var(--radius-lg);
    }

    .hex-grid {
        width: 100%;
        height: 100%;
    }

    .hex-cell {
        transition: all 0.2s ease;
    }

    .hex-cell:hover polygon {
        stroke: #d4a853 !important;
        stroke-width: 2 !important;
    }

    .hex-cell.selected polygon {
        filter: drop-shadow(0 0 8px rgba(212, 168, 83, 0.6));
    }

    .hex-cell.highlighted polygon {
        filter: drop-shadow(0 0 6px rgba(59, 130, 246, 0.6));
    }
</style>

@code {
    [Parameter] public int Width { get; set; } = 800;
    [Parameter] public int Height { get; set; } = 600;
    [Parameter] public double HexSize { get; set; } = 50;
    [Parameter] public List<HexData> Hexes { get; set; } = new();
    [Parameter] public HexData? SelectedHex { get; set; }
    [Parameter] public List<HexData>? HighlightedHexes { get; set; }
    [Parameter] public bool ShowCoordinates { get; set; } = false;
    [Parameter] public EventCallback<HexData> OnHexClicked { get; set; }
    [Parameter] public EventCallback<HexData> OnHexHovered { get; set; }

    private string ViewBox => $"{-Width/2} {-Height/2} {Width} {Height}";

    private string HexPoints
    {
        get
        {
            var points = new List<string>();
            for (int i = 0; i < 6; i++)
            {
                var angle = Math.PI / 3 * i - Math.PI / 6;
                var x = HexSize * Math.Cos(angle);
                var y = HexSize * Math.Sin(angle);
                points.Add(string.Format(CultureInfo.InvariantCulture, "{0:F2},{1:F2}", x, y));
            }
            return string.Join(" ", points);
        }
    }

    private (double X, double Y) HexToPixel(int q, int r)
    {
        // Axial to pixel conversion for pointy-top hexes
        var x = HexSize * (Math.Sqrt(3) * q + Math.Sqrt(3) / 2 * r);
        var y = HexSize * (3.0 / 2 * r);
        return (x, y);
    }

    private string F(double value) => value.ToString("F2", CultureInfo.InvariantCulture);

    private async Task OnHexClick(HexData hex)
    {
        if (OnHexClicked.HasDelegate)
        {
            await OnHexClicked.InvokeAsync(hex);
        }
    }

    private async Task OnHexHover(HexData hex)
    {
        if (OnHexHovered.HasDelegate)
        {
            await OnHexHovered.InvokeAsync(hex);
        }
    }

    private string GetSiteIcon(string siteType)
    {
        return siteType.ToLower() switch
        {
            "village" => "🏘️",
            "keep" => "🏰",
            "magetower" => "🗼",
            "monastery" => "⛪",
            "dungeon" => "🕳️",
            "tomb" => "⚰️",
            "ruins" => "🏚️",
            "ancientruins" => "🏛️",
            "mine" => "⛏️",
            "city" => "🏙️",
            "portal" => "🌀",
            _ => "❓"
        };
    }

    private string GetTerrainFill(string? terrainType)
    {
        return terrainType?.ToLower() switch
        {
            "plains" => "url(#plainsGradient)",
            "forest" => "url(#forestGradient)",
            "hills" => "url(#hillsGradient)",
            "swamp" => "url(#swampGradient)",
            "wasteland" => "url(#wastelandGradient)",
            "desert" => "url(#desertGradient)",
            "water" => "url(#waterGradient)",
            "mountain" => "url(#mountainGradient)",
            "lake" => "url(#waterGradient)",
            _ => "url(#plainsGradient)"
        };
    }

    private bool HasTerrainPattern(string? terrainType)
    {
        return terrainType?.ToLower() switch
        {
            "forest" => true,
            "hills" => true,
            "swamp" => true,
            "water" => true,
            "mountain" => true,
            "lake" => true,
            _ => false
        };
    }

    private string GetTerrainPattern(string? terrainType)
    {
        return terrainType?.ToLower() switch
        {
            "forest" => "url(#forestPattern)",
            "hills" => "url(#hillsPattern)",
            "swamp" => "url(#swampPattern)",
            "water" => "url(#waterPattern)",
            "mountain" => "url(#mountainPattern)",
            "lake" => "url(#waterPattern)",
            _ => "none"
        };
    }

    private string GetTerrainLabel(string? terrainType)
    {
        return terrainType?.ToLower() switch
        {
            "plains" => "PLAINS",
            "forest" => "FOREST",
            "hills" => "HILLS",
            "swamp" => "SWAMP",
            "wasteland" => "WASTE",
            "desert" => "DESERT",
            "water" => "WATER",
            "mountain" => "MTN",
            "lake" => "LAKE",
            _ => ""
        };
    }
}

@code {
    public class HexData
    {
        public int Q { get; set; }
        public int R { get; set; }
        public bool IsRevealed { get; set; }
        public string? TerrainImage { get; set; }
        public string? TerrainType { get; set; }
        public string? SiteType { get; set; }
        public int EnemyCount { get; set; }
        public List<PlayerToken> PlayerTokens { get; set; } = new();
    }

    public class PlayerToken
    {
        public Guid UserId { get; set; }
        public string TokenImage { get; set; } = string.Empty;
        public string HeroName { get; set; } = string.Empty;
    }
}
