    // Site interaction methods

    private async Task OpenSitePanel()
    {
        if (_myPlayerState == null) return;

        var hexKey = $"{_myPlayerState.Position.Q},{_myPlayerState.Position.R}";
        if (_gameState.Map.HexData.TryGetValue(hexKey, out var hexState) && !string.IsNullOrEmpty(hexState.SiteType))
        {
            _currentSiteName = FormatSiteName(hexState.SiteType);
            _siteInteractions = await GetSiteInteractionsAsync();
            _siteInteractionMessage = null;
            _siteInteractionIsError = false;
            _showSitePanel = true;
        }
    }

    private async Task<List<SiteInteractionOption>> GetSiteInteractionsAsync()
    {
        // Use GameEngine to get available interactions
        var engine = new MageKnightOnline.Core.GameEngine.GameEngine(DefinitionService);
        engine.LoadState(_game!.GameState);
        return engine.GetAvailableSiteInteractions().ToList();
    }

    private string FormatSiteName(string siteType)
    {
        // Convert site type to display name
        return siteType switch
        {
            "Village" => "🏘️ Village",
            "Monastery" => "⛪ Monastery",
            "MageTower" or "Mage_Tower" => "🗼 Mage Tower",
            "Keep" => "🏰 Keep",
            "MagicalGlade" or "Magical_Glade" => "🌳 Magical Glade",
            "AncientRuins" or "Ancient_Ruins" => "🏚️ Ancient Ruins",
            "Dungeon" => "🕳️ Dungeon",
            "Tomb" => "⚰️ Tomb",
            "MonsterDen" or "Monster_Den" => "🐺 Monster Den",
            "SpawningGrounds" or "Spawning_Grounds" => "👹 Spawning Grounds",
            "Draconum" => "🐉 Draconum Lair",
            "OrcMarauders" or "Orc_Marauders" => "👺 Orc Marauders",
            "City" => "🏙️ City",
            _ when siteType.Contains("Mine") => "⛏️ Crystal Mine",
            _ => siteType.Replace("_", " ")
        };
    }

    private void CloseSitePanel()
    {
        _showSitePanel = false;
        _siteInteractionMessage = null;
    }

    private async Task HandleSiteInteraction(string interactionType)
    {
        _siteInteractionMessage = null;
        _siteInteractionIsError = false;

        var result = await GameService.InteractWithSiteAsync(GameId, AuthService.CurrentUser!.Id, interactionType);
        
        if (result.Success)
        {
            _siteInteractionMessage = $"{interactionType} successful!";
            _siteInteractionIsError = false;
            await LoadGame();
            
            // Refresh interactions after successful action
            _siteInteractions = await GetSiteInteractionsAsync();
        }
        else
        {
            _siteInteractionMessage = result.ErrorMessage ?? "Action failed";
            _siteInteractionIsError = true;
        }
    }
