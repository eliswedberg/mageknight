    private async Task PlayCard(int index)
    {
        if (_myPlayerState == null || index >= _myPlayerState.Hand.Count) return;
        
        var cardId = _myPlayerState.Hand[index];
        var result = await GameService.PlayCardAsync(GameId, AuthService.CurrentUser!.Id, cardId, false);
        
        if (result.Success)
        {
            _selectedCardIndex = null;
            await LoadGame();
            await UpdateValidMoves();
        }
    }

    private async Task PlayCardPowered(int index)
    {
        if (_myPlayerState == null || index >= _myPlayerState.Hand.Count) return;
        
        if (!_myPlayerState.TemporaryMana.HasValue)
        {
            await JSRuntime.InvokeVoidAsync("alert", "Please take a mana die from the Source first!");
            return;
        }

        var cardId = _myPlayerState.Hand[index];
        var card = _cardDefinitions.FirstOrDefault(c => c.Id == cardId);
        
        // Verify temporary mana matches card requirement
        if (card != null && !string.IsNullOrEmpty(card.ManaType))
        {
            var temporaryMana = _myPlayerState.TemporaryMana.Value;
            var requiredColor = ParseManaColor(card.ManaType);
            
            if (temporaryMana != ManaColor.Gold && temporaryMana != requiredColor)
            {
                await JSRuntime.InvokeVoidAsync("alert", $"This card requires {card.ManaType} mana, but you have {temporaryMana}!");
                return;
            }
        }
        
        var result = await GameService.PlayCardAsync(GameId, AuthService.CurrentUser!.Id, cardId, true, null);
        
        if (result.Success)
        {
            _selectedCardIndex = null;
            await LoadGame();
            await UpdateValidMoves();
            await NotifyGameStateChanged("Played powered card");
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("alert", result.ErrorMessage ?? "Failed to play card");
        }
    }

    private async Task UseSidewaysCard(int index)
    {
        if (_myPlayerState == null || index >= _myPlayerState.Hand.Count) return;
        
        var cardId = _myPlayerState.Hand[index];
        var result = await GameService.UseCardSidewaysAsync(GameId, AuthService.CurrentUser!.Id, cardId);
        
        if (result.Success)
        {
            _selectedCardIndex = null;
            await LoadGame();
        }
    }

    private async Task SelectMana(int index)
    {
        // If player already has temporary mana from this die, deselect (return it)
        if (_myPlayerState?.TemporaryMana.HasValue == true && _myPlayerState.UsedManaDieIndex == index)
        {
            // Can't return mana die - it stays until end of round
            await JSRuntime.InvokeVoidAsync("alert", "You can only take one mana die per round. It will be returned at the end of the round.");
            return;
        }

        // Take mana die from Source (gives temporary mana)
        var result = await GameService.UseManaAsync(GameId, AuthService.CurrentUser!.Id, index);
        if (result.Success)
        {
            await LoadGame(); // Reload to get updated temporary mana
            StateHasChanged();
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("alert", result.ErrorMessage ?? "Failed to take mana die");
        }
    }

    private bool CanPlayPoweredForSelectedCard()
    {
        if (_selectedCardIndex == null || _myPlayerState == null)
            return false;

        if (_selectedCardIndex.Value >= _myPlayerState.Hand.Count)
            return false;

        var cardId = _myPlayerState.Hand[_selectedCardIndex.Value];
        return CanPlayPoweredForCardId(cardId);
    }

    private bool CanPlayPoweredForCard(CardHand.CardData card)
    {
        if (card == null)
            return false;

        // If card has no powered effect, can't play powered
        if (string.IsNullOrEmpty(card.PoweredEffect) && string.IsNullOrEmpty(card.PoweredManaColor))
            return false;

        return CanPlayPoweredForCardId(card.Id);
    }

    private bool CanPlayPoweredForCardId(string cardId)
    {
        if (_myPlayerState == null)
            return false;

        var card = _cardDefinitions.FirstOrDefault(c => c.Id == cardId);
        if (card == null)
            return false;

        // Check if card has powered effect
        if (card.EffectsPowered == null || !card.EffectsPowered.Any())
            return false;

        // Check if player has temporary mana
        if (!_myPlayerState.TemporaryMana.HasValue)
            return false;

        var temporaryMana = _myPlayerState.TemporaryMana.Value;

        // If card has no specific mana color requirement, any mana can be used
        if (string.IsNullOrEmpty(card.ManaType))
            return true; // Basic actions can use any mana

        var requiredColor = ParseManaColor(card.ManaType);
        
        // Gold mana can be used for any color, or exact match
        return temporaryMana == ManaColor.Gold || temporaryMana == requiredColor;
    }

    private ManaColor ParseManaColor(string manaType)
    {
        return manaType?.ToLower() switch
        {
            "red" => ManaColor.Red,
            "blue" => ManaColor.Blue,
            "green" => ManaColor.Green,
            "white" => ManaColor.White,
            "black" => ManaColor.Black,
            "gold" => ManaColor.Gold,
            _ => ManaColor.Red
        };
    }

    private int? GetSelectedManaDieIndex()
    {
        // Return the index of the die that matches player's temporary mana
        if (_myPlayerState?.TemporaryMana.HasValue != true)
            return null;

        // Return the index of the die the player used
        return _myPlayerState.UsedManaDieIndex;
    }

