    private async Task PlayCard(int index)
    {
        if (_myPlayerState == null || index >= _myPlayerState.Hand.Count) return;
        
        var cardId = _myPlayerState.Hand[index];
        var result = await GameService.PlayCardAsync(GameId, AuthService.CurrentUser!.Id, cardId, false);
        
        if (result.Success)
        {
            _selectedCardIndex = null;
            await LoadGame();
            await UpdateValidMoves();
        }
    }

    private async Task PlayCardPowered(int index)
    {
        if (_myPlayerState == null || index >= _myPlayerState.Hand.Count) return;
        if (_selectedManaIndex == null)
        {
            // Show message that mana must be selected
            return;
        }
        
        var cardId = _myPlayerState.Hand[index];
        var result = await GameService.PlayCardAsync(GameId, AuthService.CurrentUser!.Id, cardId, true, _selectedManaIndex);
        
        if (result.Success)
        {
            _selectedCardIndex = null;
            _selectedManaIndex = null;
            await LoadGame();
            await UpdateValidMoves();
        }
    }

