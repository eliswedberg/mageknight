    private async Task EndGame()
    {
        if (_game == null || AuthService.CurrentUser == null) return;
        
        // Simple confirmation using browser confirm
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", 
            "Are you sure you want to end this game? This action cannot be undone.");
        
        if (!confirmed) return;
        
        var result = await GameService.CancelGameAsync(_game.Id, AuthService.CurrentUser.Id);
        if (result.Success)
        {
            await NotifyGameStateChanged("Game ended by owner");
            Navigation.NavigateTo($"/game/{GameId}");
        }
    }

