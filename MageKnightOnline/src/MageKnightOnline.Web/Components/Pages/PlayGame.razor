    {
        if (!IsMyTurn || _myPlayerState == null || AuthService.CurrentUser == null) return;
        
        if (_myPlayerState.MovementRemaining < 1)
        {
            // Show error message
            return;
        }

        var result = await GameService.ExploreTileAsync(GameId, AuthService.CurrentUser.Id, 
            _myPlayerState.Position.Q, _myPlayerState.Position.R);
        
        if (result.Success)
        {
            await LoadGame();
