@page "/play/{GameId:guid}"
@using MageKnightOnline.Web.Components.Game
@using MageKnightOnline.Core.GameState
@using MageKnightOnline.Core.GameEngine
@using MageKnightOnline.Core.Definitions
@using System.Text.Json
@inject AuthStateService AuthService
@inject IGameService GameService
@inject IGameDefinitionService DefinitionService
@inject NavigationManager Navigation

<PageTitle>Playing - Mage Knight Online</PageTitle>

@if (!AuthService.IsAuthenticated)
{
    <div class="alert alert-warning">
        Please <a href="/login">login</a> to play.
    </div>
}
else if (_isLoading)
{
    <div class="text-center mt-lg">
        <div class="spinner"></div>
        <p class="text-muted mt-md">Loading game...</p>
    </div>
}
else if (_game == null)
{
    <div class="alert alert-error">
        Game not found. <a href="/">Return to lobby</a>
    </div>
}
else if (_game.Status != GameStatus.InProgress)
{
    <div class="alert alert-warning">
        This game is not currently in progress.
        <a href="/game/@GameId">Return to game lobby</a>
    </div>
}
else if (_gameState.Phase == GamePhase.TacticsSelection)
{
    <!-- Tactics Selection Phase -->
    <TacticsSelection Round="@_gameState.Round"
                      IsDay="@_gameState.IsDay"
                      AvailableTactics="@_availableTactics"
                      TakenTacticIds="@GetTakenTacticIds()"
                      HasSelected="@HasSelectedTactic()"
                      OnTacticSelected="OnTacticSelected" />
}
else
{
    <div class="game-board-container">
        <header class="game-header">
            <div class="game-title">
                <h1>@_game.Name</h1>
                <span class="scenario-name">@_scenario?.Name</span>
            </div>
            <div class="game-controls">
                <span class="round-indicator">Round @_gameState.Round / @(_scenario?.Rounds ?? 3)</span>
                <span class="time-indicator">@(_gameState.IsDay ? "☀️ Day" : "🌙 Night")</span>
                <button class="btn btn-secondary btn-sm" @onclick="ToggleLog">
                    📜 Log
                </button>
            </div>
        </header>

        <div class="game-layout">
            <!-- Left sidebar - Player info -->
            <aside class="player-sidebar">
                <div class="card">
                    <h3>Players</h3>
                    @foreach (var (playerState, index) in _gameState.Players.Select((p, i) => (p, i)))
                    {
                        var hero = _heroes.FirstOrDefault(h => h.Id == playerState.HeroId);
                        var isCurrentTurn = _gameState.CurrentPlayerIndex == index;
                        var gamePlayer = _game.Players.FirstOrDefault(p => p.UserId == playerState.UserId);
                        <div class="player-card @(isCurrentTurn ? "active" : "")">
                            @if (hero != null)
                            {
                                <img src="@hero.TokenImage" alt="@hero.Name" class="player-token" />
                            }
                            <div class="player-details">
                                <strong>@(gamePlayer?.User.Username ?? "Unknown")</strong>
                                <span class="hero-name">@(hero?.Name ?? "Unknown")</span>
                                <div class="player-stats">
                                    <span title="Fame">⭐ @playerState.Fame</span>
                                    <span title="Level">📈 Lv.@playerState.Level</span>
                                    <span title="Reputation">🏛️ @playerState.Reputation</span>
                                </div>
                            </div>
                            @if (isCurrentTurn)
                            {
                                <span class="turn-indicator">▶</span>
                            }
                        </div>
                    }
                </div>

                <!-- Mana Pool -->
                <ManaPool Dice="@GetManaDice()"
                          Crystals="@GetPlayerCrystals()"
                          SelectedDieIndex="_selectedManaIndex"
                          CanReroll="@CanRerollMana"
                          OnDieSelected="SelectMana"
                          OnRerollClicked="RerollMana" />
                
                <!-- Current player pools -->
                @if (IsMyTurn && _myPlayerState != null)
                {
                    <div class="card pools-card">
                        <h3>Current Pools</h3>
                        <div class="pools-grid">
                            <div class="pool-item move">
                                <span class="pool-icon">🏃</span>
                                <span class="pool-value">@_myPlayerState.MovementRemaining</span>
                                <span class="pool-label">Move</span>
                            </div>
                            <div class="pool-item attack">
                                <span class="pool-icon">⚔️</span>
                                <span class="pool-value">@_myPlayerState.AttackPool</span>
                                <span class="pool-label">Attack</span>
                            </div>
                            <div class="pool-item block">
                                <span class="pool-icon">🛡️</span>
                                <span class="pool-value">@_myPlayerState.BlockPool</span>
                                <span class="pool-label">Block</span>
                            </div>
                            <div class="pool-item influence">
                                <span class="pool-icon">👑</span>
                                <span class="pool-value">@_myPlayerState.InfluencePool</span>
                                <span class="pool-label">Influence</span>
                            </div>
                            @if (_myPlayerState.RangedAttack > 0)
                            {
                                <div class="pool-item ranged">
                                    <span class="pool-icon">🏹</span>
                                    <span class="pool-value">@_myPlayerState.RangedAttack</span>
                                    <span class="pool-label">Ranged</span>
                                </div>
                            }
                            @if (_myPlayerState.SiegeAttack > 0)
                            {
                                <div class="pool-item siege">
                                    <span class="pool-icon">💣</span>
                                    <span class="pool-value">@_myPlayerState.SiegeAttack</span>
                                    <span class="pool-label">Siege</span>
                                </div>
                            }
                        </div>
                    </div>
                }
            </aside>

            <!-- Main game board area -->
            <main class="game-board">
                @if (_gameState.Combat != null)
                {
                    <!-- Combat overlay -->
                    <CombatPanel Combat="_gameState.Combat"
                                 RangedAttack="@(_myPlayerState?.RangedAttack ?? 0)"
                                 AttackPool="@(_myPlayerState?.AttackPool ?? 0)"
                                 BlockPool="@(_myPlayerState?.BlockPool ?? 0)"
                                 OnRangedAttack="HandleRangedAttack"
                                 OnBlock="HandleBlock"
                                 OnAttack="HandleAttack"
                                 OnAssignDamage="HandleAssignDamage"
                                 OnEndPhase="HandleEndCombatPhase"
                                 OnFlee="HandleFlee" />
                }
                else
                {
                    <TileMap Width="900" 
                             Height="700" 
                             Scale="0.5"
                             Tiles="_tiles"
                             Hexes="_tileHexes"
                             SelectedHex="_selectedTileHex"
                             HighlightedHexes="_highlightedTileHexes"
                             ShowCoordinates="@_showCoordinates"
                             OnHexClicked="OnTileHexClicked"
                             OnHexHovered="OnTileHexHovered" />
                }
            </main>

            <!-- Right sidebar - Hand and actions -->
            <aside class="action-sidebar">
                <!-- Card Hand -->
                <CardHand Cards="@GetHandCards()"
                          SelectedCardIndex="_selectedCardIndex"
                          CanPlayPowered="@(_selectedManaIndex.HasValue)"
                          OnCardSelected="SelectCard"
                          OnCardPlayed="PlayCard"
                          OnCardPlayedPowered="PlayCardPowered"
                          OnCardUsedSideways="UseSidewaysCard" />

                <div class="card">
                    <h3>Actions</h3>
                    <div class="action-buttons">
                        @if (IsMyTurn)
                        {
                            <button class="btn btn-primary" @onclick="EndTurn">End Turn</button>
                            <button class="btn btn-secondary" @onclick="Rest" disabled="@(!CanRest)">Rest</button>
                        }
                        else
                        {
                            <p class="text-muted text-center">Waiting for @GetCurrentPlayerName()...</p>
                        }
                    </div>
                </div>

                <div class="card units-card">
                    <h3>Your Units (@(_myPlayerState?.Units.Count ?? 0))</h3>
                    @if (_myPlayerState?.Units.Any() == true)
                    {
                        <div class="units-list">
                            @foreach (var unit in _myPlayerState.Units)
                            {
                                var unitDef = _unitDefinitions.FirstOrDefault(u => u.Id == unit.UnitId);
                                <div class="unit-item @(unit.IsWounded ? "wounded" : "") @(!unit.IsReady ? "exhausted" : "")">
                                    <span>@(unitDef?.Name ?? unit.UnitId)</span>
                                    @if (unit.IsWounded)
                                    {
                                        <span class="wounded-badge" title="Wounded">💔</span>
                                    }
                                    @if (!unit.IsReady)
                                    {
                                        <span class="exhausted-badge" title="Exhausted">💤</span>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-sm">No units recruited yet</p>
                    }
                </div>
            </aside>
        </div>

        @if (_showLog)
        {
            <div class="game-log-overlay" @onclick="ToggleLog">
                <div class="game-log card" @onclick:stopPropagation="true">
                    <div class="log-header">
                        <h3>Game Log</h3>
                        <button class="btn btn-sm btn-secondary" @onclick="ToggleLog">✕</button>
                    </div>
                    <div class="log-entries">
                        @foreach (var entry in _gameState.GameLog.TakeLast(50).Reverse())
                        {
                            <div class="log-entry">
                                <span class="log-time">@entry.Timestamp.ToString("HH:mm")</span>
                                <span class="log-action">[@entry.Action]</span>
                                <span class="log-message">@entry.Details</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

<style>
    .game-board-container {
        height: calc(100vh - 80px);
        display: flex;
        flex-direction: column;
        margin: calc(-1 * var(--spacing-lg));
        padding: 0;
    }

    .game-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: var(--spacing-md) var(--spacing-lg);
        background: var(--color-bg-medium);
        border-bottom: 1px solid var(--color-border);
    }

    .game-title h1 {
        font-size: 1.25rem;
        margin: 0;
    }

    .scenario-name {
        font-size: 0.9rem;
        color: var(--color-text-secondary);
    }

    .game-controls {
        display: flex;
        gap: var(--spacing-lg);
        align-items: center;
    }

    .round-indicator,
    .time-indicator {
        font-family: 'Cinzel', serif;
        font-size: 0.9rem;
        color: var(--color-gold);
    }

    .game-layout {
        flex: 1;
        display: grid;
        grid-template-columns: 280px 1fr 320px;
        gap: var(--spacing-md);
        padding: var(--spacing-md);
        overflow: hidden;
    }

    .player-sidebar,
    .action-sidebar {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-md);
        overflow-y: auto;
    }

    .player-sidebar .card,
    .action-sidebar .card {
        padding: var(--spacing-md);
    }

    .player-sidebar h3,
    .action-sidebar h3 {
        font-size: 1rem;
        margin-bottom: var(--spacing-md);
    }

    .player-card {
        display: flex;
        align-items: center;
        gap: var(--spacing-sm);
        padding: var(--spacing-sm);
        border-radius: var(--radius-md);
        margin-bottom: var(--spacing-sm);
        background: var(--color-bg-dark);
        position: relative;
    }

    .player-card.active {
        border: 2px solid var(--color-gold);
        background: rgba(212, 168, 83, 0.1);
    }

    .player-token {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        object-fit: cover;
    }

    .player-details {
        display: flex;
        flex-direction: column;
        flex: 1;
    }

    .hero-name {
        font-size: 0.8rem;
        color: var(--color-text-secondary);
    }

    .player-stats {
        display: flex;
        gap: var(--spacing-sm);
        font-size: 0.75rem;
        color: var(--color-text-muted);
        margin-top: 2px;
    }

    .turn-indicator {
        color: var(--color-gold);
        font-size: 1.2rem;
    }

    .game-board {
        background: var(--color-bg-card);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .action-buttons {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-sm);
    }

    .action-buttons .btn {
        width: 100%;
    }

    .pools-card .pools-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: var(--spacing-sm);
    }

    .pool-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: var(--spacing-sm);
        background: var(--color-bg-dark);
        border-radius: var(--radius-md);
        border: 1px solid var(--color-border);
    }

    .pool-icon {
        font-size: 1.2rem;
        margin-bottom: 2px;
    }

    .pool-value {
        font-size: 1.5rem;
        font-weight: bold;
        color: var(--color-gold);
    }

    .pool-label {
        font-size: 0.7rem;
        color: var(--color-text-muted);
        text-transform: uppercase;
    }

    .pool-item.move { border-color: #4CAF50; }
    .pool-item.attack { border-color: #f44336; }
    .pool-item.block { border-color: #2196F3; }
    .pool-item.influence { border-color: #9C27B0; }
    .pool-item.ranged { border-color: #FF9800; }
    .pool-item.siege { border-color: #795548; }

    .pool-item.move .pool-value { color: #4CAF50; }
    .pool-item.attack .pool-value { color: #f44336; }
    .pool-item.block .pool-value { color: #2196F3; }
    .pool-item.influence .pool-value { color: #9C27B0; }
    .pool-item.ranged .pool-value { color: #FF9800; }
