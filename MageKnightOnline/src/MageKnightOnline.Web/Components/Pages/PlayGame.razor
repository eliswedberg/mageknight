    private void AddUnrevealedNeighbors()
    {
        var directions = new[] 
        {
            (1, 0), (1, -1), (0, -1), (-1, 0), (-1, 1), (0, 1)
        };

        var existingKeys = _hexes.Select(h => $"{h.Q},{h.R}").ToHashSet();
        var toAdd = new List<HexGrid.HexData>();

        foreach (var hex in _hexes.Where(h => h.IsRevealed))
        {
            foreach (var (dq, dr) in directions)
            {
                var nq = hex.Q + dq;
                var nr = hex.R + dr;
                var key = $"{nq},{nr}";

                if (!existingKeys.Contains(key))
                {
                    toAdd.Add(new HexGrid.HexData
                    {
                        Q = nq,
                        R = nr,
                        IsRevealed = false
                    });
                    existingKeys.Add(key);
                }
            }
        }

        _hexes.AddRange(toAdd);
    }

    private string GetTerrainForHex(int q, int r)
    {
        var key = $"{q},{r}";
        if (_gameState.Map.HexData.TryGetValue(key, out var hexState))
        {
            return hexState.Terrain.ToLower();
        }
        return "plains"; // Default
    }

    private string? GetSiteForHex(int q, int r)
    {
        var key = $"{q},{r}";
        if (_gameState.Map.HexData.TryGetValue(key, out var hexState))
        {
            return hexState.SiteType?.ToLower();
        }
        return null;
    }

    private List<ManaPool.ManaDie> GetManaDice()
    {
        return _gameState.ManaPool.Select(color => new ManaPool.ManaDie
        {
            Color = color switch
            {
                ManaColor.Red => ManaPool.ManaColor.Red,
                ManaColor.Blue => ManaPool.ManaColor.Blue,
                ManaColor.Green => ManaPool.ManaColor.Green,
                ManaColor.White => ManaPool.ManaColor.White,
                ManaColor.Black => ManaPool.ManaColor.Black,
                ManaColor.Gold => ManaPool.ManaColor.Gold,
                _ => ManaPool.ManaColor.Red
            }
        }).ToList();
    }

    private Dictionary<ManaPool.ManaColor, int> GetPlayerCrystals()
    {
        if (_myPlayerState == null) return new();

        var crystals = _myPlayerState.Crystals;
        return new Dictionary<ManaPool.ManaColor, int>
        {
            { ManaPool.ManaColor.Red, crystals.Red },
            { ManaPool.ManaColor.Blue, crystals.Blue },
            { ManaPool.ManaColor.Green, crystals.Green },
            { ManaPool.ManaColor.White, crystals.White },
            { ManaPool.ManaColor.Gold, crystals.Gold }
        };
    }

    private List<CardHand.CardData> GetHandCards()
    {
        if (_myPlayerState == null) return new();

        return _myPlayerState.Hand.Select(cardId =>
        {
            var card = _cardDefinitions.FirstOrDefault(c => c.Id == cardId);
            return new CardHand.CardData
            {
                Id = cardId,
                Name = card?.Name ?? cardId,
                Type = card?.Type ?? "Unknown",
                BasicEffect = card?.BasicEffect ?? "",
                PoweredEffect = card?.PoweredEffect,
                PoweredManaColor = card?.ManaType,
                ImageUrl = card?.Image
            };
        }).ToList();
    }

    private string GetCurrentPlayerName()
    {
        if (_gameState.CurrentPlayerIndex < 0 || _gameState.CurrentPlayerIndex >= _gameState.Players.Count)
            return "Unknown";

        var currentPlayer = _gameState.Players[_gameState.CurrentPlayerIndex];
        var gamePlayer = _game?.Players.FirstOrDefault(p => p.UserId == currentPlayer.UserId);
        return gamePlayer?.User.Username ?? "Unknown";
    }

