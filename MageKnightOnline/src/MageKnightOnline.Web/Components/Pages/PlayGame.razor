    }

    .game-log {
        width: 500px;
        max-height: 80vh;
        display: flex;
        flex-direction: column;
    }

    .log-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: var(--spacing-md);
    }

    .log-header h3 {
        margin: 0;
