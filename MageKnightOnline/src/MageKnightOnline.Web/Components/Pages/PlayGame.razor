        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: var(--spacing-xs);
    }

    .log-entry {
        display: flex;
        gap: var(--spacing-sm);
        font-size: 0.85rem;
        padding: var(--spacing-xs);
        background: var(--color-bg-dark);
        border-radius: var(--radius-sm);
    }

    .log-time {
        color: var(--color-text-muted);
        min-width: 50px;
