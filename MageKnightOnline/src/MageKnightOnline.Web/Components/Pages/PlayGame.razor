@page "/play/{GameId:guid}"
@using MageKnightOnline.Web.Components.Game
@using MageKnightOnline.Core.GameState
@using MageKnightOnline.Core.GameEngine
@using MageKnightOnline.Core.Definitions
@using System.Text.Json
@using Microsoft.AspNetCore.SignalR.Client
@inject AuthStateService AuthService
@inject IGameService GameService
@inject IGameDefinitionService DefinitionService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<PageTitle>Playing - Mage Knight Online</PageTitle>

@if (!AuthService.IsAuthenticated)
{
    <div class="alert alert-warning">
        Please <a href="/login">login</a> to play.
    </div>
}
else if (_isLoading)
{
    <div class="text-center mt-lg">
        <div class="spinner"></div>
        <p class="text-muted mt-md">Loading game...</p>
    </div>
}
else if (_game == null)
{
    <div class="alert alert-error">
        Game not found. <a href="/">Return to lobby</a>
    </div>
}
else if (_game.Status != GameStatus.InProgress)
{
    <div class="alert alert-warning">
        This game is not currently in progress.
        <a href="/game/@GameId">Return to game lobby</a>
    </div>
}
else if (_gameState.Victory?.IsGameOver == true)
{
    <!-- Victory Screen -->
    <VictoryScreen Victory="_gameState.Victory"
                   CurrentUserId="@(AuthService.CurrentUser?.Id ?? Guid.Empty)"
                   CanPlayAgain="false"
                   OnReturnToLobby="ReturnToLobby" />
}
else if (_gameState.Phase == GamePhase.TacticsSelection)
{
    <!-- Tactics Selection Phase -->
    <TacticsSelection Round="@_gameState.Round"
                      IsDay="@_gameState.IsDay"
                      AvailableTactics="@_availableTactics"
                      TakenTacticIds="@GetTakenTacticIds()"
                      HasSelected="@HasSelectedTactic()"
                      OnTacticSelected="OnTacticSelected" />
}
else
{
    <div class="game-board-container">
        <header class="game-header">
            <div class="game-title">
                <h1>@_game.Name</h1>
                <span class="scenario-name">@_scenario?.Name</span>
            </div>
            <div class="game-controls">
                <span class="round-indicator">Round @_gameState.Round / @(_scenario?.Rounds ?? 3)</span>
                <span class="time-indicator">@(_gameState.IsDay ? "☀️ Day" : "🌙 Night")</span>
                <span class="connected-players" title="@string.Join(", ", _connectedPlayers)">
                    👥 @_connectedPlayers.Count online
                </span>
                <button class="btn btn-secondary btn-sm" @onclick="ToggleChat">
                    💬 Chat @(_chatMessages.Count > 0 ? $"({_chatMessages.Count})" : "")
                </button>
                <button class="btn btn-secondary btn-sm" @onclick="ToggleLog">
                    📜 Log
                </button>
                @if (_game.CreatedByUserId == AuthService.CurrentUser?.Id)
                {
                    <button class="btn btn-danger btn-sm" @onclick="EndGame" title="End this game (only game owner)">
                        🛑 End Game
                    </button>
                }
            </div>
        </header>

        <div class="game-layout">
            <!-- Left sidebar - Player info -->
            <aside class="player-sidebar">
                <div class="card">
                    <h3>Players</h3>
                    @foreach (var (playerState, index) in _gameState.Players.Select((p, i) => (p, i)))
                    {
                        var hero = _heroes.FirstOrDefault(h => h.Id == playerState.HeroId);
                        var isCurrentTurn = _gameState.CurrentPlayerIndex == index;
                        var gamePlayer = _game.Players.FirstOrDefault(p => p.UserId == playerState.UserId);
                        <div class="player-card @(isCurrentTurn ? "active" : "")">
                            @if (hero != null)
                            {
                                <img src="@hero.TokenImage" alt="@hero.Name" class="player-token" />
                            }
                            <div class="player-details">
                                <strong>@(gamePlayer?.User.Username ?? "Unknown")</strong>
                                <span class="hero-name">@(hero?.Name ?? "Unknown")</span>
                                <div class="player-stats">
                                    <span title="Fame">⭐ @playerState.Fame</span>
                                    <span title="Level">📈 Lv.@playerState.Level</span>
                                    <span title="Reputation">🏛️ @playerState.Reputation</span>
                                </div>
                            </div>
                            @if (isCurrentTurn)
                            {
                                <span class="turn-indicator">▶</span>
                            }
                        </div>
                    }
                </div>

                <!-- Mana Pool -->
                <ManaPool Dice="@GetManaDice()"
                          Crystals="@GetPlayerCrystals()"
                          SelectedDieIndex="@GetSelectedManaDieIndex()"
                          CanReroll="@CanRerollMana"
                          OnDieSelected="SelectMana"
                          OnRerollClicked="RerollMana" />
                
                <!-- Current player pools -->
                @if (IsMyTurn && _myPlayerState != null)
                {
                    <div class="card pools-card">
                        <h3>Current Pools</h3>
                        @if (_myPlayerState.TemporaryMana.HasValue)
                        {
                            <div class="temporary-mana-indicator">
                                <span class="mana-badge @_myPlayerState.TemporaryMana.Value.ToString().ToLower()">
                                    ⚡ Temporary: @_myPlayerState.TemporaryMana.Value
                                </span>
                            </div>
                        }
                        <div class="pools-grid">
                            <div class="pool-item move">
                                <span class="pool-icon">🏃</span>
                                <span class="pool-value">@_myPlayerState.MovementRemaining</span>
                                <span class="pool-label">Move</span>
                            </div>
                            <div class="pool-item attack">
                                <span class="pool-icon">⚔️</span>
                                <span class="pool-value">@_myPlayerState.AttackPool</span>
                                <span class="pool-label">Attack</span>
                            </div>
                            <div class="pool-item block">
                                <span class="pool-icon">🛡️</span>
                                <span class="pool-value">@_myPlayerState.BlockPool</span>
                                <span class="pool-label">Block</span>
                            </div>
                            <div class="pool-item influence">
                                <span class="pool-icon">👑</span>
                                <span class="pool-value">@_myPlayerState.InfluencePool</span>
                                <span class="pool-label">Influence</span>
                            </div>
                            @if (_myPlayerState.RangedAttack > 0)
                            {
                                <div class="pool-item ranged">
                                    <span class="pool-icon">🏹</span>
                                    <span class="pool-value">@_myPlayerState.RangedAttack</span>
                                    <span class="pool-label">Ranged</span>
                                </div>
                            }
                            @if (_myPlayerState.SiegeAttack > 0)
                            {
                                <div class="pool-item siege">
                                    <span class="pool-icon">💣</span>
                                    <span class="pool-value">@_myPlayerState.SiegeAttack</span>
                                    <span class="pool-label">Siege</span>
                                </div>
                            }
                        </div>
                    </div>
                }
            </aside>

            <!-- Main game board area -->
            <main class="game-board">
                @if (_gameState.Combat != null)
                {
                    <!-- Combat overlay -->
                    <CombatPanel Combat="_gameState.Combat"
                                 RangedAttack="@(_myPlayerState?.RangedAttack ?? 0)"
                                 SiegeAttack="@(_myPlayerState?.SiegeAttack ?? 0)"
                                 AttackPool="@(_myPlayerState?.AttackPool ?? 0)"
                                 BlockPool="@(_myPlayerState?.BlockPool ?? 0)"
                                 Units="@GetUnitCombatOptions()"
                                 OnRangedAttack="HandleRangedAttack"
                                 OnBlock="HandleBlock"
                                 OnAttack="HandleAttack"
                                 OnAssignDamage="HandleAssignDamage"
                                 OnAssignDamageToUnit="HandleAssignDamageToUnit"
                                 OnUnitAbility="HandleUnitAbility"
                                 OnEndPhase="HandleEndCombatPhase"
                                 OnFlee="HandleFlee" />
                }
                else
                {
                    <TileMap Width="900" 
                             Height="700" 
                             Scale="0.5"
                             Tiles="_tiles"
                             Hexes="_tileHexes"
                             SelectedHex="_selectedTileHex"
                             HighlightedHexes="_highlightedTileHexes"
                             ShowCoordinates="@_showCoordinates"
                             OnHexClicked="OnTileHexClicked"
                             OnHexHovered="OnTileHexHovered" />
                    
                    <!-- Site Interaction Panel -->
                    <SiteInteractionPanel IsVisible="@_showSitePanel"
                                          SiteName="@_currentSiteName"
                                          Interactions="@_siteInteractions"
                                          AttackPool="@(_myPlayerState?.AttackPool ?? 0)"
                                          BlockPool="@(_myPlayerState?.BlockPool ?? 0)"
                                          InfluencePool="@(_myPlayerState?.InfluencePool ?? 0)"
                                          Message="@_siteInteractionMessage"
                                          IsError="@_siteInteractionIsError"
                                          OnInteractionSelected="HandleSiteInteraction"
                                          OnClose="CloseSitePanel" />
                }
            </main>

            <!-- Right sidebar - Actions and Hand -->
            <aside class="action-sidebar">
                <div class="card">
                    <h3>Actions</h3>
                    <div class="action-buttons">
                        @if (IsMyTurn)
                        {
                            @if (IsAtSite && !HasEnemiesAtCurrentPosition)
                            {
                                <button class="btn btn-gold" @onclick="OpenSitePanel">
                                    @GetCurrentSiteIcon() Interact with Site
                                </button>
                            }
                            @if (CanExplore)
                            {
                                <button class="btn btn-info" @onclick="ExploreCurrentTile" 
                                        disabled="@(_myPlayerState?.MovementRemaining < 1)">
                                    🗺️ Explore Tile (1 Move)
                                </button>
                            }
                            <button class="btn btn-primary" @onclick="EndTurn">End Turn</button>
                            <button class="btn btn-secondary" @onclick="Rest" disabled="@(!CanRest)">Rest</button>
                        }
                        else
                        {
                            <p class="text-muted text-center">Waiting for @GetCurrentPlayerName()...</p>
                        }
                    </div>
                </div>

                <div class="card units-card">
                    <h3>Your Units (@(_myPlayerState?.Units.Count ?? 0))</h3>
                    @if (_myPlayerState?.Units.Any() == true)
                    {
                        <div class="units-list">
                            @foreach (var unit in _myPlayerState.Units)
                            {
                                var unitDef = _unitDefinitions.FirstOrDefault(u => u.Id == unit.UnitId);
                                <div class="unit-item @(unit.IsWounded ? "wounded" : "") @(!unit.IsReady ? "exhausted" : "")">
                                    <span>@(unitDef?.Name ?? unit.UnitId)</span>
                                    @if (unit.IsWounded)
                                    {
                                        <span class="wounded-badge" title="Wounded">💔</span>
                                    }
                                    @if (!unit.IsReady)
                                    {
                                        <span class="exhausted-badge" title="Exhausted">💤</span>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-sm">No units recruited yet</p>
                    }
                </div>

                <!-- Card Hand at bottom of sidebar -->
                <CardHand Cards="@GetHandCards()"
                          SelectedCardIndex="_selectedCardIndex"
                          CanPlayPowered="@CanPlayPoweredForSelectedCard()"
                          CanPlayPoweredForCard="@CanPlayPoweredForCard"
                          OnCardSelected="SelectCard"
                          OnCardPlayed="PlayCard"
                          OnCardPlayedPowered="PlayCardPowered"
                          OnCardUsedSideways="UseSidewaysCard" />
            </aside>
        </div>

        @if (_showLog)
        {
            <div class="game-log-overlay" @onclick="ToggleLog">
                <div class="game-log card" @onclick:stopPropagation="true">
                    <div class="log-header">
                        <h3>Game Log</h3>
                        <button class="btn btn-sm btn-secondary" @onclick="ToggleLog">✕</button>
                    </div>
                    <div class="log-entries">
                        @foreach (var entry in _gameState.GameLog.TakeLast(50).Reverse())
                        {
                            <div class="log-entry">
                                <span class="log-time">@entry.Timestamp.ToString("HH:mm")</span>
                                <span class="log-action">[@entry.Action]</span>
                                <span class="log-message">@entry.Details</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        @if (_showChat)
        {
            <div class="chat-overlay" @onclick="ToggleChat">
                <div class="chat-panel card" @onclick:stopPropagation="true">
                    <div class="chat-header">
                        <h3>💬 Chat</h3>
                        <button class="btn btn-sm btn-secondary" @onclick="ToggleChat">✕</button>
                    </div>
                    <div class="chat-messages">
                        @foreach (var msg in _chatMessages.TakeLast(50))
                        {
                            <div class="chat-message">
                                <span class="chat-time">@msg.Timestamp.ToString("HH:mm")</span>
                                <span class="chat-username">@msg.Username:</span>
                                <span class="chat-text">@msg.Message</span>
                            </div>
                        }
                        @if (_chatMessages.Count == 0)
                        {
                            <p class="text-muted text-center">No messages yet. Say hello!</p>
                        }
                    </div>
                    <div class="chat-input-area">
                        <input type="text" @bind="_chatInput" @bind:event="oninput" 
                               @onkeypress="HandleChatKeyPress" 
                               placeholder="Type a message..." 
                               class="chat-input" />
                        <button class="btn btn-primary btn-sm" @onclick="SendChatMessage">Send</button>
                    </div>
                </div>
            </div>
        }
    </div>
}

<style>
    .game-board-container {
        height: calc(100vh - 80px);
        display: flex;
        flex-direction: column;
        margin: calc(-1 * var(--spacing-lg));
        padding: 0;
    }

    .game-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: var(--spacing-md) var(--spacing-lg);
        background: var(--color-bg-medium);
        border-bottom: 1px solid var(--color-border);
    }

    .game-title h1 {
        font-size: 1.25rem;
        margin: 0;
    }

    .scenario-name {
        font-size: 0.9rem;
        color: var(--color-text-secondary);
    }

    .game-controls {
        display: flex;
        gap: var(--spacing-lg);
        align-items: center;
    }

    .round-indicator,
    .time-indicator {
        font-family: 'Cinzel', serif;
        font-size: 0.9rem;
        color: var(--color-gold);
    }

    .game-layout {
        flex: 1;
        display: grid;
        grid-template-columns: 280px 1fr 320px;
        gap: var(--spacing-md);
        padding: var(--spacing-md);
        overflow: hidden;
    }

    .player-sidebar,
    .action-sidebar {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-md);
        overflow-y: auto;
    }

    .action-sidebar {
        /* Ensure card hand is at the bottom */
        justify-content: flex-start;
    }

    .action-sidebar > :last-child {
        margin-top: auto; /* Push card hand to bottom */
    }

    .player-sidebar .card,
    .action-sidebar .card {
        padding: var(--spacing-md);
    }

    .player-sidebar h3,
    .action-sidebar h3 {
        font-size: 1rem;
        margin-bottom: var(--spacing-md);
    }

    .player-card {
        display: flex;
        align-items: center;
        gap: var(--spacing-sm);
        padding: var(--spacing-sm);
        border-radius: var(--radius-md);
        margin-bottom: var(--spacing-sm);
        background: var(--color-bg-dark);
        position: relative;
    }

    .player-card.active {
        border: 2px solid var(--color-gold);
        background: rgba(212, 168, 83, 0.1);
    }

    .player-token {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        object-fit: cover;
    }

    .player-details {
        display: flex;
        flex-direction: column;
        flex: 1;
    }

    .hero-name {
        font-size: 0.8rem;
        color: var(--color-text-secondary);
    }

    .player-stats {
        display: flex;
        gap: var(--spacing-sm);
        font-size: 0.75rem;
        color: var(--color-text-muted);
        margin-top: 2px;
    }

    .turn-indicator {
        color: var(--color-gold);
        font-size: 1.2rem;
    }

    .game-board {
        background: var(--color-bg-card);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .action-buttons {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-sm);
    }

    .action-buttons .btn {
        width: 100%;
    }

    .temporary-mana-indicator {
        margin-bottom: var(--spacing-md);
        padding: var(--spacing-sm);
        background: rgba(212, 168, 83, 0.1);
        border: 2px solid var(--color-gold);
        border-radius: var(--radius-md);
        text-align: center;
    }

    .mana-badge {
        font-weight: bold;
        font-size: 0.9rem;
    }

    .mana-badge.red { color: #ef4444; }
    .mana-badge.blue { color: #3b82f6; }
    .mana-badge.green { color: #10b981; }
    .mana-badge.white { color: #f3f4f6; }
    .mana-badge.black { color: #1f2937; }
    .mana-badge.gold { color: var(--color-gold); }

    .pools-card .pools-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: var(--spacing-sm);
    }

    .pool-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: var(--spacing-sm);
        background: var(--color-bg-dark);
        border-radius: var(--radius-md);
        border: 1px solid var(--color-border);
    }

    .pool-icon {
        font-size: 1.2rem;
        margin-bottom: 2px;
    }

    .pool-value {
        font-size: 1.5rem;
        font-weight: bold;
        color: var(--color-gold);
    }

    .pool-label {
        font-size: 0.7rem;
        color: var(--color-text-muted);
        text-transform: uppercase;
    }

    .pool-item.move { border-color: #4CAF50; }
    .pool-item.attack { border-color: #f44336; }
    .pool-item.block { border-color: #2196F3; }
    .pool-item.influence { border-color: #9C27B0; }
    .pool-item.ranged { border-color: #FF9800; }
    .pool-item.siege { border-color: #795548; }

    .pool-item.move .pool-value { color: #4CAF50; }
    .pool-item.attack .pool-value { color: #f44336; }
    .pool-item.block .pool-value { color: #2196F3; }
    .pool-item.influence .pool-value { color: #9C27B0; }
    .pool-item.ranged .pool-value { color: #FF9800; }
    .pool-item.siege .pool-value { color: #795548; }

    .units-card .units-list {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-xs);
    }

    .unit-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: var(--spacing-xs) var(--spacing-sm);
        background: var(--color-bg-dark);
        border-radius: var(--radius-sm);
        font-size: 0.85rem;
    }

    .unit-item.wounded {
        opacity: 0.7;
        border-left: 3px solid var(--color-error);
    }

    .unit-item.exhausted {
        opacity: 0.5;
    }

    .wounded-badge, .exhausted-badge {
        font-size: 0.75rem;
    }

    .game-log-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.7);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 1000;
    }

    .game-log {
        width: 500px;
        max-height: 80vh;
        display: flex;
        flex-direction: column;
    }

    .log-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: var(--spacing-md);
    }

    .log-header h3 {
        margin: 0;
    }

    .log-entries {
        flex: 1;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: var(--spacing-xs);
    }

    .log-entry {
        display: flex;
        gap: var(--spacing-sm);
        font-size: 0.85rem;
        padding: var(--spacing-xs);
        background: var(--color-bg-dark);
        border-radius: var(--radius-sm);
    }

    .log-time {
        color: var(--color-text-muted);
        min-width: 50px;
    }

    .log-action {
        color: var(--color-gold);
        min-width: 80px;
    }

    .log-message {
        color: var(--color-text-primary);
    }

    /* Chat panel styles */
    .chat-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.7);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 1000;
    }

    .chat-panel {
        width: 400px;
        max-height: 70vh;
        display: flex;
        flex-direction: column;
    }

    .chat-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: var(--spacing-md);
    }

    .chat-header h3 {
        margin: 0;
    }

    .chat-messages {
        flex: 1;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: var(--spacing-xs);
        min-height: 200px;
        max-height: 400px;
        padding: var(--spacing-sm);
        background: var(--color-bg-dark);
        border-radius: var(--radius-sm);
    }

    .chat-message {
        display: flex;
        gap: var(--spacing-sm);
        font-size: 0.85rem;
        padding: var(--spacing-xs);
    }

    .chat-time {
        color: var(--color-text-muted);
        min-width: 40px;
        font-size: 0.75rem;
    }

    .chat-username {
        color: var(--color-gold);
        font-weight: 600;
    }

    .chat-text {
        color: var(--color-text-primary);
    }

    .chat-input-area {
        display: flex;
        gap: var(--spacing-sm);
        margin-top: var(--spacing-md);
    }

    .chat-input {
        flex: 1;
        padding: var(--spacing-sm);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-sm);
        background: var(--color-bg-dark);
        color: var(--color-text-primary);
    }

    .chat-input:focus {
        outline: none;
        border-color: var(--color-gold);
    }

    .connected-players {
        color: var(--color-text-muted);
        font-size: 0.85rem;
        cursor: help;
    }

    .btn-gold {
        background: linear-gradient(135deg, #d4a853 0%, #b8922e 100%);
        border: 1px solid #e8c56a;
        color: #1a1a1a;
        font-weight: 600;
    }

    .btn-gold:hover {
        background: linear-gradient(135deg, #e8c56a 0%, #d4a853 100%);
        transform: translateY(-1px);
    }
</style>

@code {
    [Parameter]
    public Guid GameId { get; set; }

    private Game? _game;
    private ScenarioDefinition? _scenario;
    private List<HeroDefinition> _heroes = new();
    private List<CardDefinition> _cardDefinitions = new();
    private List<UnitDefinition> _unitDefinitions = new();
    private List<TacticsDefinition> _availableTactics = new();
    private bool _isLoading = true;

    // Game state from database
    private GameStateModel _gameState = new();
    private PlayerState? _myPlayerState;

    // SignalR connection
    private HubConnection? _hubConnection;
    private List<string> _connectedPlayers = new();
    private List<ChatMessage> _chatMessages = new();
    private string _chatInput = string.Empty;
    private bool _showChat = false;

    // UI state
    private bool _showLog = false;
    private bool _showCoordinates = true;
    private List<HexGrid.HexData> _hexes = new();
    private HexGrid.HexData? _selectedHex;
    private List<HexGrid.HexData>? _highlightedHexes;
    private int? _selectedCardIndex;

    // Chat message record
    private record ChatMessage(string Username, string Message, DateTime Timestamp);

    // TileMap state
